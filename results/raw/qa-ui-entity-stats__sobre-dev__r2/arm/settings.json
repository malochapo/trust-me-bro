{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook compress"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook read-dedup"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.cache/sobre-bench/tools/bin/sobre-dev hook observe"
          }
        ]
      }
    ]
  }
}
