         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snoozes_scoped_to_signal(session, entity, entity_type, signal_filter):
+    """Snooze counts with a signal_id only include filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    entity.entity_type = entity_type
+    session.flush()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    signal_filter.action = SignalFilterAction.snooze
+    signal_filter.expiration = datetime.now(timezone.utc) + timedelta(days=1)
+    signal_filter.expression = expression
+    expired_filter = SignalFilter(
+        name="expired",
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        expression=expression,
+        project_id=signal_filter.project_id,
+    )
+    signal1.filters.append(signal_filter)
+    signal2.filters.append(expired_filter)
+    session.commit()
+
+    kwargs = dict(db_session=session, entity_value=entity.value, entity_type_id=entity_type.id)
+
+    all_data = get_signal_stats(**kwargs)
+    assert all_data.num_snoozes_active == 1
+    assert all_data.num_snoozes_expired == 1
+
+    data1 = get_signal_stats(signal_id=signal1.id, **kwargs)
+    assert data1.num_snoozes_active == 1
+    assert data1.num_snoozes_expired == 0
+
+    data2 = get_signal_stats(signal_id=signal2.id, **kwargs)
+    assert data2.num_snoozes_active == 0
+    assert data2.num_snoozes_expired == 1
