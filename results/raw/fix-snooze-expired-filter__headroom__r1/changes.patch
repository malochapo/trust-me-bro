+
+
+def test_filter_snooze__expired_filter_does_not_block_valid_filter(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction, SignalFilterMode
+    from dispatch.signal.service import filter_snooze
+    from tests.factories import SignalFilterFactory, SignalInstanceFactory
+
+    now = datetime.now(timezone.utc).replace(tzinfo=None)
+    expired = SignalFilterFactory(
+        project=project,
+        mode=SignalFilterMode.active,
+        action=SignalFilterAction.snooze,
+        expression=[],
+        expiration=now - timedelta(days=7),
+    )
+    valid = SignalFilterFactory(
+        project=project,
+        mode=SignalFilterMode.active,
+        action=SignalFilterAction.snooze,
+        expression=[],
+        expiration=now + timedelta(days=30),
+    )
+    signal.filters = [expired, valid]
+    instance = SignalInstanceFactory(signal=signal, project=project)
+    session.commit()
+
+    result = filter_snooze(db_session=session, signal_instance=instance)
+
+    assert result.filter_action == SignalFilterAction.snooze
