--- a/tests/signal/test_signal_stats_service.py
+++ b/tests/signal/test_signal_stats_service.py
@@ -236,3 +236,40 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snoozes_scoped_to_signal(session, entity, entity_type):
+    """Snooze counts with a signal_id only include filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    entity.entity_type = entity_type
+    session.add_all([signal1, signal2])
+    session.flush()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    def make_filter(name, delta):
+        return SignalFilter(
+            name=name,
+            expression=expression,
+            action=SignalFilterAction.snooze,
+            expiration=datetime.now(timezone.utc) + delta,
+            project_id=1,
+        )
+
+    signal1.filters.append(make_filter("active-1", timedelta(days=1)))
+    signal2.filters.append(make_filter("active-2", timedelta(days=1)))
+    signal2.filters.append(make_filter("expired-2", timedelta(days=-1)))
+    session.commit()
+
+    kwargs = dict(db_session=session, entity_value=entity.value, entity_type_id=entity_type.id)
+    all_data = get_signal_stats(**kwargs)
+    data1 = get_signal_stats(signal_id=signal1.id, **kwargs)
+    data2 = get_signal_stats(signal_id=signal2.id, **kwargs)
+
+    assert (all_data.num_snoozes_active, all_data.num_snoozes_expired) == (2, 1)
+    assert (data1.num_snoozes_active, data1.num_snoozes_expired) == (1, 0)
+    assert (data2.num_snoozes_active, data2.num_snoozes_expired) == (1, 1)
