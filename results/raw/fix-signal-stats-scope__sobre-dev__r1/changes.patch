+
+
+def test_get_signal_stats_snoozes_scoped_to_signal(session, entity, entity_type):
+    """Snooze counts for a signal only include filters attached to that signal."""
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+    from dispatch.signal.service import get_signal_stats
+
+    signal1 = Signal(name="Snooze Signal 1", variant="snooze-signal-1", project_id=1)
+    signal2 = Signal(name="Snooze Signal 2", variant="snooze-signal-2", project_id=1)
+    entity.entity_type = entity_type
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    now = datetime.now(timezone.utc)
+    filters = [
+        ("active-1", now + timedelta(days=1), signal1),
+        ("expired-1", now - timedelta(days=1), signal1),
+        ("active-2a", now + timedelta(days=1), signal2),
+        ("active-2b", now + timedelta(days=2), signal2),
+        ("expired-2", now - timedelta(days=1), signal2),
+    ]
+    for name, expiration, sig in filters:
+        sig.filters.append(
+            SignalFilter(
+                name=f"scoped-{name}",
+                action=SignalFilterAction.snooze,
+                expiration=expiration,
+                expression=expression,
+                project_id=1,
+            )
+        )
+    session.add_all([signal1, signal2])
+    session.commit()
+
+    kwargs = dict(db_session=session, entity_value=entity.value, entity_type_id=entity_type.id)
+
+    stats1 = get_signal_stats(signal_id=signal1.id, **kwargs)
+    assert (stats1.num_snoozes_active, stats1.num_snoozes_expired) == (1, 1)
+
+    stats2 = get_signal_stats(signal_id=signal2.id, **kwargs)
+    assert (stats2.num_snoozes_active, stats2.num_snoozes_expired) == (2, 1)
+
+    stats_all = get_signal_stats(**kwargs)
+    assert (stats_all.num_snoozes_active, stats_all.num_snoozes_expired) == (3, 2)
