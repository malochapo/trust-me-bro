+
+
+def test_get_signal_stats_snoozes_scoped_to_signal(session, entity, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.service import get_signal_stats
+    from tests.factories import SignalFactory, SignalFilterFactory
+
+    other_signal = SignalFactory(project=project)
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    def make_filter(name, delta):
+        return SignalFilterFactory(
+            name=name,
+            description="test",
+            expression=expression,
+            action="snooze",
+            expiration=datetime.now(timezone.utc) + delta,
+            project=project,
+        )
+
+    signal.filters = [make_filter("mine-active", timedelta(days=2))]
+    other_signal.filters = [
+        make_filter("other-active", timedelta(days=2)),
+        make_filter("other-expired", timedelta(days=-2)),
+    ]
+    session.commit()
+
+    scoped = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity.entity_type_id,
+        signal_id=signal.id,
+    )
+    assert scoped.num_snoozes_active == 1
+    assert scoped.num_snoozes_expired == 0
+
+    overall = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity.entity_type_id,
+    )
+    assert overall.num_snoozes_active == 2
+    assert overall.num_snoozes_expired == 1
