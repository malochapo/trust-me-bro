@@ -236,3 +236,37 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snoozes_scoped_to_signal(session, entity, entity_type, signal):
+    """Snooze counts only include filters attached to the given signal."""
+    from dispatch.signal.service import get_signal_stats
+    from tests.factories import SignalFactory, SignalFilterFactory
+
+    entity.entity_type = entity_type
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    tomorrow = datetime.now(timezone.utc) + timedelta(days=1)
+    yesterday = datetime.now(timezone.utc) - timedelta(days=1)
+
+    other_signal = SignalFactory()
+    mine_active = SignalFilterFactory(expression=expression, action="snooze", expiration=tomorrow)
+    mine_expired = SignalFilterFactory(expression=expression, action="snooze", expiration=yesterday)
+    theirs = SignalFilterFactory(expression=expression, action="snooze", expiration=tomorrow)
+    signal.filters.extend([mine_active, mine_expired])
+    other_signal.filters.append(theirs)
+    session.commit()
+
+    scoped = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal.id,
+    )
+    assert scoped.num_snoozes_active == 1
+    assert scoped.num_snoozes_expired == 1
+
+    unscoped = get_signal_stats(
+        db_session=session, entity_value=entity.value, entity_type_id=entity_type.id
+    )
+    assert unscoped.num_snoozes_active == 2
+    assert unscoped.num_snoozes_expired == 1
