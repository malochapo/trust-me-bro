+
+
+def test_filter_signal_muted(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = datetime.now(timezone.utc).replace(tzinfo=None) + timedelta(hours=1)
+    instance = SignalInstanceFactory(signal=signal, project=project, case=None)
+    session.add(instance)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=instance)
+    assert instance.filter_action == SignalFilterAction.mute
+    assert instance.case_id is None
+
+    # an expired mute no longer filters
+    signal.muted_until = datetime.now(timezone.utc).replace(tzinfo=None) - timedelta(minutes=1)
+    instance2 = SignalInstanceFactory(signal=signal, project=project)
+    session.add(instance2)
+    session.commit()
+
+    assert instance2.filter_action != SignalFilterAction.mute
+    filter_signal(db_session=session, signal_instance=instance2)
+    assert instance2.filter_action != SignalFilterAction.mute
