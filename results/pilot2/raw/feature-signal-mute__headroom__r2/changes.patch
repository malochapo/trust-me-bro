+def test_filter_signal_muted(session, signal, project):
+    from datetime import datetime, timedelta
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = datetime.utcnow() + timedelta(hours=1)
+    signal_instance = SignalInstanceFactory(project=project, signal=signal, raw={"id": "foo"})
+    session.add(signal_instance)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.mute
+
+
+def test_filter_signal_mute_expired(session, signal, project):
+    from datetime import datetime, timedelta
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = datetime.utcnow() - timedelta(hours=1)
+    signal_instance = SignalInstanceFactory(project=project, signal=signal, raw={"id": "foo"})
+    session.add(signal_instance)
+    session.commit()
+
+    assert not filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.none
