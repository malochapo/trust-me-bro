+def test_filter_signal__muted(session, signal_instance):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    now = datetime.now(timezone.utc).replace(tzinfo=None)
+
+    signal_instance.signal.muted_until = now + timedelta(hours=1)
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.mute
+
+    # an expired mute no longer applies
+    signal_instance.filter_action = None
+    signal_instance.signal.muted_until = now - timedelta(hours=1)
+    filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action != SignalFilterAction.mute
