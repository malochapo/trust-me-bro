+@pytest.mark.parametrize(
+    "window, deduplicated",
+    [
+        (30, True),  # window is minutes: instance from 10 minutes ago is inside 30 minutes
+        (5, False),  # ...and outside 5 minutes
+    ],
+)
+def test_filter_actions_deduplicate_window_is_minutes(
+    session, signal, project, window, deduplicated
+):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # earlier instance, ten minutes ago
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance_2) is deduplicated
+    expected_action = SignalFilterAction.deduplicate if deduplicated else SignalFilterAction.none
+    assert signal_instance_2.filter_action == expected_action
+
+
