+def _create_dedup_filter_scenario(session, signal, project, created_at_minutes_ago, window):
+    """Adds an earlier instance and a deduplicate filter with the given window (minutes)."""
+    from datetime import datetime, timedelta
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now() - timedelta(minutes=created_at_minutes_ago),
+    )
+    session.add(earlier_instance)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(new_instance)
+    session.commit()
+    return new_instance
+
+
+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    """A window of 30 (as set in the UI, "Window (minutes)") covers an instance 10 minutes old."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    new_instance = _create_dedup_filter_scenario(
+        session, signal, project, created_at_minutes_ago=10, window=30
+    )
+
+    assert filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_excludes_older_instances(session, signal, project):
+    """A window of 30 minutes does not cover an instance 40 minutes old."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    new_instance = _create_dedup_filter_scenario(
+        session, signal, project, created_at_minutes_ago=40, window=30
+    )
+
+    assert not filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.none
+
+
