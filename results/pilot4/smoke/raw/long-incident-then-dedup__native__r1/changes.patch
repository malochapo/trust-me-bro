@@ -0,0 +1,84 @@
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import ANY, MagicMock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+def _unwrap_task(name):
+    """Returns the original function of a scheduled task, skipping the timer and project decorators."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return task["func"].__wrapped__.__wrapped__
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = today
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_stable_reminder_sends_on_monday(mocker):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = date(2025, 8, 18)
+
+    stale_case = SimpleNamespace(stable_at=datetime.utcnow() - timedelta(days=8))
+    mocker.patch("dispatch.case.scheduled.get_all_by_status", return_value=[stale_case])
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    _unwrap_task("case-stable-reminder")(db_session=MagicMock(), project=MagicMock())
+
+    send.assert_called_once()
+
+
+def test_case_close_reminder_sends_on_monday(mocker):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = date(2025, 8, 18)
+
+    stale_case = SimpleNamespace(triage_at=datetime.utcnow() - timedelta(days=8))
+    mocker.patch("dispatch.case.scheduled.get_all_by_status", return_value=[stale_case])
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    _unwrap_task("case-close-reminder")(db_session=MagicMock(), project=MagicMock())
+
+    send.assert_called_once()
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(mocker):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = date(2025, 8, 18)
+
+    stale_case = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=8))
+    recent_case = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+    mocker.patch(
+        "dispatch.case.scheduled.get_all_by_status", return_value=[stale_case, recent_case]
+    )
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    _unwrap_task("case-close-reminder")(db_session=MagicMock(), project=MagicMock())
+
+    send.assert_called_once_with(stale_case, ANY)
+
+
+def test_case_stable_reminder_skips_on_tuesday(mocker):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = date(2025, 8, 19)
+
+    stale_case = SimpleNamespace(stable_at=datetime.utcnow() - timedelta(days=8))
+    mocker.patch("dispatch.case.scheduled.get_all_by_status", return_value=[stale_case])
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    _unwrap_task("case-stable-reminder")(db_session=MagicMock(), project=MagicMock())
+
+    send.assert_not_called()
