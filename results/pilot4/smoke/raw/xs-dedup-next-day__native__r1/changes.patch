+def _create_dedup_filter_signal_instances(session, signal, project, previous_minutes_ago, window):
+    from datetime import datetime, timedelta
+
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now() - timedelta(minutes=previous_minutes_ago),
+    )
+    session.add(signal_instance_1)
+
+    signal_filter = SignalFilterFactory(
+        name="test",
+        description="dedupe",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    filtered = filter_signal(db_session=session, signal_instance=signal_instance_2)
+    return filtered, signal_instance_2
+
+
+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    from dispatch.signal.models import SignalFilterAction
+
+    # a 30 minute window must group instances that are 10 minutes apart
+    filtered, signal_instance = _create_dedup_filter_signal_instances(
+        session, signal, project, previous_minutes_ago=10, window=30
+    )
+    assert filtered
+    assert signal_instance.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_excludes_older_instances(session, signal, project):
+    from dispatch.signal.models import SignalFilterAction
+
+    # a 30 minute window must not group instances that are 40 minutes apart
+    filtered, signal_instance = _create_dedup_filter_signal_instances(
+        session, signal, project, previous_minutes_ago=40, window=30
+    )
+    assert not filtered
+    assert signal_instance.filter_action == SignalFilterAction.none
+
+
