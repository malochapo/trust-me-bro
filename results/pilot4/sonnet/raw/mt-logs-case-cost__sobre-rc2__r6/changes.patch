+def test_case_cost_stops_at_earliest_status_timestamp(case, participant, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=10)
+    escalated_at = now - timedelta(hours=8)
+    stable_at = now - timedelta(hours=4)
+    closed_at = now - timedelta(hours=2)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+    case.stable_at = stable_at.replace(tzinfo=None)
+
+    # escalated, then marked stable: cost must stop at the escalation
+    case.status = CaseStatus.stable
+    case.closed_at = None
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert seconds == int((escalated_at - assumed_at).total_seconds())
+
+    # also closed: still stops at the earliest timestamp
+    case.status = CaseStatus.closed
+    case.closed_at = closed_at.replace(tzinfo=None)
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert seconds == int((escalated_at - assumed_at).total_seconds())
+
+    # without an escalation, it stops at stable_at rather than closed_at
+    case.escalated_at = None
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert seconds == int((stable_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate__missing_project_values_use_defaults(project):
+    """Tests that a project without annual employee cost or business year hours uses the defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+    project.annual_employee_cost = 104000
+    assert get_hourly_rate(project) == math.ceil(104000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+
+def test_calculate_case_response_cost__project_without_rate_values(case, session):
+    """Tests that a case cost is still calculated when the project values are unset."""
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    results = calculate_case_response_cost(case=case, db_session=session)
+    assert results[CostModelType.new] >= 0
