+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,86 @@
+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _task_body(name):
+    """Returns the undecorated function registered with the scheduler under name."""
+    fn = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(fn, "__wrapped__"):
+        fn = fn.__wrapped__
+    return fn
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+class _Case:
+    def __init__(self):
+        self.triage_at = datetime.utcnow() - timedelta(days=10)
+        self.stable_at = datetime.utcnow() - timedelta(days=10)
+
+
+@pytest.mark.parametrize(
+    "task,status",
+    [
+        ("case-close-reminder", CaseStatus.triage),
+        ("case-stable-reminder", CaseStatus.stable),
+    ],
+)
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_long_running_case_reminders_only_sent_on_mondays(task, status, day, sent):
+    case = _Case()
+    with (
+        patch.object(scheduled, "date") as mock_date,
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = day
+        _task_body(task)(db_session=None, project=type("P", (), {"id": 1})())
+        assert send.called is sent
+
+
+def test_close_reminder_falls_back_to_created_at_when_triage_at_missing():
+    case = _Case()
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=10)
+    with (
+        patch.object(scheduled, "date") as mock_date,
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+        patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        mock_date.today.return_value = date(2025, 8, 18)
+        _task_body("case-close-reminder")(db_session=None, project=type("P", (), {"id": 1})())
+        send.assert_called_once()
+        log_exception.assert_not_called()
+
+
+def test_close_reminder_not_sent_for_recent_case_without_triage_at():
+    case = _Case()
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    with (
+        patch.object(scheduled, "date") as mock_date,
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = date(2025, 8, 18)
+        _task_body("case-close-reminder")(db_session=None, project=type("P", (), {"id": 1})())
+        send.assert_not_called()
