+@pytest.mark.parametrize(
+    "window_minutes,expected_action",
+    [(30, SignalFilterAction.deduplicate), (5, SignalFilterAction.none)],
+)
+def test_filter_dedup_window_is_in_minutes(
+    session, signal, project, window_minutes, expected_action
+):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
