--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,35 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Nested token",
+            jpath="credentials.*.session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    # already masked payload: no entity, so unrelated instances are not deduplicated together
+    signal_instance.raw = redact_raw(
+        {"session_token": "abc", "credentials": {"a": {"session_token": "def"}}}
+    )
+    assert find_entities(session, signal_instance, entity_types) == []
+
+    # payload that was never masked: the real secret must not become an entity either
+    signal_instance.raw = {"session_token": "abc", "credentials": {"a": {"session_token": "def"}}}
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+    assert MASK not in {e.value for e in entities}
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..a27b47be
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,27 @@
+import pytest
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+EVENT_ROUTES = [
+    ("POST", "/{incident_id}/event"),
+    ("PATCH", "/{incident_id}/event"),
+    ("DELETE", "/{incident_id}/event/{event_uuid}"),
+    ("POST", "/{incident_id}/exportTimeline"),
+]
+
+
+def _permission_classes(route):
+    classes = []
+    for dependency in route.dependencies:
+        if isinstance(dependency.dependency, PermissionsDependency):
+            classes.extend(dependency.dependency.permissions_classes)
+    return classes
+
+
+@pytest.mark.parametrize("method,path", EVENT_ROUTES)
+def test_incident_event_routes_require_event_permission(method, path):
+    """Incident timeline event routes must declare IncidentEventPermission."""
+    routes = [r for r in router.routes if r.path == path and method in r.methods]
+    assert len(routes) == 1, f"route {method} {path} not found"
+    assert IncidentEventPermission in _permission_classes(routes[0])
