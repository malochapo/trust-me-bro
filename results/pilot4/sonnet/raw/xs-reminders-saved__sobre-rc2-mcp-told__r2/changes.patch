+from datetime import date, datetime, timedelta
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+
+
+class _FakeDate(date):
+    fake_today = MONDAY
+
+    @classmethod
+    def today(cls):
+        return cls.fake_today
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    _FakeDate.fake_today = MONDAY + timedelta(days=offset)
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+def _task(name):
+    """Returns the undecorated function registered under the scheduler name."""
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "name,attr",
+    [
+        ("case-close-reminder", "triage_at"),
+        ("case-stable-reminder", "stable_at"),
+    ],
+)
+def test_weekly_reminders_sent_on_monday_only(name, attr):
+    func = _task(name)
+    case = MagicMock()
+    setattr(case, attr, datetime.utcnow() - timedelta(days=10))
+    for offset, expected in [(0, 1), (1, 0)]:
+        _FakeDate.fake_today = MONDAY + timedelta(days=offset)
+        with patch.object(scheduled, "date", _FakeDate), patch.object(
+            scheduled, "get_all_by_status", return_value=[case]
+        ), patch.object(scheduled, "send_case_close_reminder") as send:
+            func(db_session=MagicMock(), project=MagicMock(id=1))
+            assert send.call_count == expected
