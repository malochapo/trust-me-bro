@@ -0,0 +1,89 @@
+from datetime import date
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+def _freeze_today(monkeypatch, day):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _freeze_today(monkeypatch, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def _triage_case(session, project, **kwargs):
+    from tests.factories import CaseFactory
+
+    # CaseFactory treats status as a param and ignores it, so set it afterwards
+    case = CaseFactory(project=project, **kwargs)
+    case.status = "Triage"
+    session.commit()
+    return case
+
+
+def _run_close_reminder(session, project, monkeypatch):
+    from inspect import unwrap
+    from unittest.mock import MagicMock
+
+    sent = MagicMock()
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", sent)
+    # scheduler.add() doesn't return the function, so fetch it from the registry
+    task = next(
+        t for t in scheduled.scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    unwrap(task["func"])(db_session=session, project=project)
+    return [call.args[0] for call in sent.call_args_list]
+
+
+def test_case_close_reminder_falls_back_to_created_at(session, project, monkeypatch):
+    from datetime import datetime, timedelta
+
+    now = datetime.utcnow()
+    old = _triage_case(session, project, triage_at=None, created_at=now - timedelta(days=8))
+    recent = _triage_case(session, project, triage_at=None, created_at=now - timedelta(days=2))
+    with_triage_at = _triage_case(
+        session,
+        project,
+        triage_at=now - timedelta(days=9),
+        created_at=now - timedelta(days=1),
+    )
+
+    sent = _run_close_reminder(session, project, monkeypatch)
+
+    assert old in sent
+    assert with_triage_at in sent
+    assert recent not in sent
+
+
+def test_case_close_reminder_logs_no_error_without_triage_at(session, project, monkeypatch, caplog):
+    from datetime import datetime, timedelta
+
+    _triage_case(
+        session,
+        project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    _run_close_reminder(session, project, monkeypatch)
+    assert not [r for r in caplog.records if r.levelname == "ERROR"]
