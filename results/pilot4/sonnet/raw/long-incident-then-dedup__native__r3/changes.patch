+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    def make_filter(window):
+        return SignalFilterFactory(
+            expression=[
+                {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+            ],
+            action="deduplicate",
+            window=window,
+            project=project,
+        )
+
+    # an earlier instance for the same entity, ten minutes ago
+    earlier = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    earlier.created_at = datetime.now(timezone.utc) - timedelta(minutes=10)
+    new = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add_all([earlier, new])
+
+    # the UI offers the window in minutes: 30 covers the instance from 10 minutes ago ...
+    window_30 = make_filter(30)
+    signal.filters.append(window_30)
+    session.commit()
+    filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.deduplicate
+
+    # ... and 5 does not
+    new.filter_action = SignalFilterAction.none
+    window_5 = make_filter(5)
+    signal.filters = [window_5]
+    session.commit()
+    filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_snooze_expired_filter_does_not_hide_valid_one(
+    session, entity, signal, project
+):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory, SignalFilterFactory
+
+    session.add(entity)
+    signal_instance = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    now = datetime.now(timezone.utc)
+    # the expired filter comes first, the valid one after it
+    expired = SignalFilterFactory(
+        expression=expression,
+        action="snooze",
+        expiration=now - timedelta(days=7),
+        project=project,
+    )
+    valid = SignalFilterFactory(
+        expression=expression,
+        action="snooze",
+        expiration=now + timedelta(days=30),
+        project=project,
+    )
+    signal.filters = [expired, valid]
+    session.commit()
+
+    assert [f.id for f in signal.filters] == [expired.id, valid.id]
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
