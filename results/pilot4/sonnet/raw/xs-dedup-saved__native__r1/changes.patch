diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..7cbb86e7 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,72 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,  # minutes
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    first = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(first)
+    session.commit()
+    first.case_id = None
+    second = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add(second)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=second)
+    assert second.filter_action == SignalFilterAction.deduplicate
+
+    # an instance outside the 30 minute window is not grouped
+    old = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=45),
+    )
+    first.created_at = datetime.now(timezone.utc) - timedelta(minutes=45)
+    third = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add_all([old, third])
+    session.commit()
+    second.created_at = datetime.now(timezone.utc) - timedelta(minutes=45)
+    session.commit()
+    assert not filter_signal(db_session=session, signal_instance=third)
+    assert third.filter_action == SignalFilterAction.none
