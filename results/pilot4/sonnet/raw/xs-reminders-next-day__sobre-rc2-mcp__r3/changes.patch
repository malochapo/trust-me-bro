+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+
+
+@pytest.mark.parametrize("day", [date(2025, 8, 11) + timedelta(days=i) for i in range(14)])
+def test_is_reminder_day_only_on_mondays(day):
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() == (day.strftime("%A") == "Monday")
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [(date(2025, 8, 18), True), (date(2025, 8, 19), False)],
+)
+def test_close_reminder_sent_only_on_monday(today, expected):
+    case = mock.Mock(triage_at=datetime.utcnow() - timedelta(days=10), status=CaseStatus.triage)
+    with (
+        mock.patch.object(scheduled, "date") as mock_date,
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = today
+        # bypass the scheduler decorators to call the task body directly
+        fn = next(
+            t["func"] for t in scheduled.scheduler.registered_tasks if t["name"] == "case-close-reminder"
+        )
+        while hasattr(fn, "__wrapped__"):
+            fn = fn.__wrapped__
+        fn(db_session=mock.Mock(), project=mock.Mock(id=1))
+        assert send.called is expected
