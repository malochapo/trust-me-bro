+def test_case_cost_stops_at_earliest_status_timestamp(case, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=10)
+    escalated_at = now - timedelta(hours=6)
+    stable_at = now - timedelta(hours=4)
+    closed_at = now - timedelta(hours=2)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+
+    case.status = CaseStatus.closed
+    case.escalated_at = escalated_at
+    case.stable_at = stable_at
+    case.closed_at = closed_at
+
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert seconds == int((escalated_at - assumed_at).total_seconds())
+
+    # without an escalation, the cost stops at stable_at rather than closed_at
+    case.escalated_at = None
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert seconds == int((stable_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate__missing_project_settings(project):
+    """Tests that unset project cost settings fall back to the project model defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.annual_employee_cost.default.arg
+    default_hours = Project.business_year_hours.default.arg
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = 2000
+    assert get_hourly_rate(project) == 50
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / 2000)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / default_hours)
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
