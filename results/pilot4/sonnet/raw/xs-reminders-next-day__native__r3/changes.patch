+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _undecorated(name):
+    """Returns the raw task function, bypassing the timer and project-context decorators."""
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with mock.patch.object(scheduled, "date", _FakeDate):
+        _FakeDate._today = day
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "name,status,field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+def test_weekly_reminders_sent_on_monday_only(name, status, field):
+    case = mock.Mock(**{field: datetime.utcnow() - timedelta(days=10)})
+    project = mock.Mock(id=1)
+    with (
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled, "date", _FakeDate),
+    ):
+        inner = _undecorated(name)
+        _FakeDate._today = date(2025, 8, 19)  # Tuesday
+        inner(mock.Mock(), project)
+        send.assert_not_called()
+        _FakeDate._today = date(2025, 8, 18)  # Monday
+        inner(mock.Mock(), project)
+        send.assert_called_once()
