+def test_find_entities_ignores_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    signal_instance.raw = redact_raw(
+        {"session_token": "ghs_secret", "user": {"password": "hunter2", "name": "octocat"}}
+    )
+    entity_types = [
+        EntityType(name="Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Password", jpath="$..password", regular_expression=None, project=project),
+        EntityType(name="Name", jpath="user.name", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {str(e.value) for e in entities}
+    assert MASK not in values
+    assert values == {"octocat"}
diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..39380fd0
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,22 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permission_classes(route):
+    classes = []
+    for dependency in route.dependencies:
+        call = dependency.dependency
+        if isinstance(call, PermissionsDependency):
+            classes.extend(call.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident timeline event must stay behind IncidentEventPermission."""
+    routes = [
+        r
+        for r in router.routes
+        if r.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in r.methods
+    ]
+    assert len(routes) == 1
+    assert IncidentEventPermission in _permission_classes(routes[0])
