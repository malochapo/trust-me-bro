+import inspect
+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    fake_today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls.fake_today
+
+
+def _task(name):
+    # the scheduler decorator doesn't return the function, so look it up by name
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(func)
+
+
+@pytest.mark.parametrize("day,expected", [(18, True), (19, False), (20, False), (24, False)])
+def test_is_reminder_day_only_on_monday(day, expected):
+    _FakeDate.fake_today = date(2025, 8, day)
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "job,status,field,sender",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at", "send_case_close_reminder"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at", "send_case_close_reminder"),
+    ],
+)
+def test_weekly_reminders_sent_on_monday_only(session, case, job, status, field, sender):
+    case.status = status
+    setattr(case, field, datetime.utcnow() - timedelta(days=15))
+
+    for day, should_send in [(18, True), (19, False)]:
+        _FakeDate.fake_today = date(2025, 8, day)
+        with (
+            patch.object(scheduled, "date", _FakeDate),
+            patch.object(scheduled, "get_all_by_status", return_value=[case]),
+            patch.object(scheduled, sender) as send,
+        ):
+            _task(job)(db_session=session, project=case.project)
+            assert send.called is should_send
