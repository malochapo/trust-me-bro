+from datetime import date
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize("day", range(1, 8))
+def test_is_reminder_day_only_on_monday(day):
+    # 2025-08-18 is a Monday, 2025-08-24 a Sunday
+    fake_today = date(2025, 8, 17 + day)
+
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = fake_today
+        assert scheduled._is_reminder_day() is (fake_today.weekday() == 0)
