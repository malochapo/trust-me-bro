+def test_filter_dedup_window_is_in_minutes(session, signal, project, minutes_ago, deduplicated):
+    """A deduplication filter's window is entered in minutes in the UI."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
