@@ -0,0 +1,87 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _freeze_today(day):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return mock.patch.object(scheduled, "date", FakeDate)
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = date(2025, 8, 11) + timedelta(days=offset)  # 2025-08-11 is a Monday
+    with _freeze_today(day):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize(
+    "job_name, status, field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize("day, expected_sends", [(date(2025, 8, 18), 1), (date(2025, 8, 19), 0)])
+def test_weekly_case_reminders_sent_on_monday_only(job_name, status, field, day, expected_sends):
+    case = mock.Mock(status=status)
+    setattr(case, field, datetime.utcnow() - timedelta(days=10))
+    # @scheduler.add returns None; fetch the registered job and unwrap the task decorators
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == job_name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+
+    with _freeze_today(day), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    assert send.call_count == expected_sends
+
+
+def test_close_reminder_falls_back_to_created_at_without_triage_at():
+    case = mock.Mock(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=10),
+    )
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+
+    with _freeze_today(date(2025, 8, 18)), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send, mock.patch.object(
+        scheduled.log, "exception"
+    ) as log_exception:
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    log_exception.assert_not_called()
+    assert send.call_count == 1
+
+
+def test_close_reminder_not_sent_for_recent_case_without_triage_at():
+    case = mock.Mock(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+
+    with _freeze_today(date(2025, 8, 18)), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    send.assert_not_called()
