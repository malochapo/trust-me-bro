+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize("day,expected", [(date(2025, 8, 18), True)] + [
+    (date(2025, 8, 18) + timedelta(days=i), False) for i in range(1, 7)
+])
+def test_is_reminder_day_only_on_monday(day, expected):
+    _FakeDate._today = day
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("status", [CaseStatus.triage, CaseStatus.stable])
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_sent_on_monday(status, day, sent):
+    _FakeDate._today = day
+
+    class C:
+        triage_at = datetime.utcnow() - timedelta(days=10)
+        stable_at = triage_at
+
+    name = "case-close-reminder" if status == CaseStatus.triage else "case-stable-reminder"
+    fn = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(fn, "__wrapped__"):
+        fn = fn.__wrapped__
+    with patch.object(scheduled, "date", _FakeDate), patch.object(
+        scheduled, "get_all_by_status", return_value=[C()]
+    ), patch.object(scheduled, "send_case_close_reminder") as send:
+        fn(db_session=None, project=type("P", (), {"id": 1})())
+    assert send.called is sent
