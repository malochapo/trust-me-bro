+def test_case_cost_stops_at_earliest_status_timestamp(case, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at."""
+    import pytest
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=10)
+    escalated_at = now - timedelta(hours=8)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+
+    expected = (escalated_at - assumed_at).total_seconds()
+
+    # escalated, then marked stable later: cost must not grow past escalated_at
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at
+    case.stable_at = now - timedelta(hours=1)
+    case.closed_at = None
+    assert get_participant_role_time_seconds(
+        case=case, participant_role=participant_role
+    ) == pytest.approx(expected)
+
+    # escalated, then closed later: same
+    case.status = CaseStatus.closed
+    case.stable_at = None
+    case.closed_at = now - timedelta(hours=1)
+    assert get_participant_role_time_seconds(
+        case=case, participant_role=participant_role
+    ) == pytest.approx(expected)
+
+
+def test_get_hourly_rate_uses_project_defaults_when_unset(project):
+    """Tests that a project without annual employee cost or business year hours still gets a rate."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.__table__.c.annual_employee_cost.default.arg
+    default_hours = Project.__table__.c.business_year_hours.default.arg
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+    # only one of the two missing: the other value is kept
+    project.annual_employee_cost = 208000
+    assert get_hourly_rate(project) == math.ceil(208000 / default_hours)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
