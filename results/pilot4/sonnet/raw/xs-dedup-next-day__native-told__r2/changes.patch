+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.now(timezone.utc)
+    old_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "old"}),
+        created_at=now - timedelta(minutes=40),
+    )
+    recent_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "recent"}),
+        created_at=now - timedelta(minutes=10),
+    )
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "new"}),
+        created_at=now,
+    )
+    session.add_all([old_instance, recent_instance, new_instance])
+
+    # the UI offers the window in minutes
+    signal_filter = SignalFilterFactory(
+        name="dedupe-minutes",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+    assert signal.filters == [signal_filter]
+
+    # 10 minutes ago is within a 30 minute window, 40 minutes ago is not
+    assert filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.deduplicate
+    assert new_instance.case_id == recent_instance.case_id
+
+
