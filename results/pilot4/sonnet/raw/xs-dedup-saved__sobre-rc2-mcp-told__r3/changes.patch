+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,  # the UI sets the window in minutes
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    now = datetime.now(timezone.utc)
+
+    def make_instance(age_minutes):
+        instance = SignalInstanceFactory(
+            project=project,
+            signal=signal,
+            entities=[entity],
+            raw=json.dumps({"id": f"age-{age_minutes}"}),
+            created_at=now - timedelta(minutes=age_minutes),
+        )
+        session.add(instance)
+        session.commit()
+        return instance
+
+    # an instance ten minutes ago is inside the 30 minute window
+    make_instance(10)
+    recent = make_instance(0)
+    assert filter_signal(db_session=session, signal_instance=recent)
+    assert recent.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_outside_window(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_filter = (
+        SignalFilterFactory(
+            name="dedupe-window-outside",
+            description="test",
+            expression=[
+                {
+                    "or": [
+                        {"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}
+                    ]
+                }
+            ],
+            action="deduplicate",
+            window=30,
+            project=project,
+        )
+    )
+
+    session.add(signal_filter)
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    now = datetime.now(timezone.utc)
+    for age in (40, 0):
+        instance = SignalInstanceFactory(
+            project=project,
+            signal=signal,
+            entities=[entity],
+            raw=json.dumps({"id": f"age-{age}"}),
+            created_at=now - timedelta(minutes=age),
+        )
+        session.add(instance)
+        session.commit()
+
+    # the only other instance is 40 minutes old, outside the 30 minute window
+    assert not filter_signal(db_session=session, signal_instance=instance)
+
+
