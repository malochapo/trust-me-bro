diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..09e61898 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,59 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_dedup_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_dedup
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_filter = SignalFilterFactory(
+        name="window-minutes",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,  # minutes, as in the UI
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    now = datetime.now(timezone.utc)
+    older = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], created_at=now - timedelta(minutes=10)
+    )
+    too_old = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], created_at=now - timedelta(minutes=90)
+    )
+    session.add_all([older, too_old])
+    session.commit()
+
+    # an instance ten minutes after the first is inside the 30 minute window
+    new = SignalInstanceFactory(project=project, signal=signal, entities=[entity])
+    session.add(new)
+    session.commit()
+    filter_dedup(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.deduplicate
+
+    # with only the instance outside the window, nothing is deduplicated
+    session.delete(older)
+    session.commit()
+    newer = SignalInstanceFactory(project=project, signal=signal, entities=[entity])
+    session.add(newer)
+    session.commit()
+    session.delete(new)
+    session.commit()
+    filter_dedup(db_session=session, signal_instance=newer)
+    assert newer.filter_action != SignalFilterAction.deduplicate
