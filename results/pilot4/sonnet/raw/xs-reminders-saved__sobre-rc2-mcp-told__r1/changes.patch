+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+
+MONDAY = date(2025, 8, 18)
+
+
+class _FakeDate(date):
+    fake_today = MONDAY
+
+    @classmethod
+    def today(cls):
+        return cls.fake_today
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = MONDAY + timedelta(days=offset)
+    with patch.object(scheduled, "date", _FakeDate):
+        _FakeDate.fake_today = day
+        assert scheduled._is_reminder_day() == (offset == 0)
+
+
+class _Case:
+    def __init__(self):
+        old = datetime.utcnow() - timedelta(days=15)
+        self.triage_at = old
+        self.stable_at = old
+
+
+@pytest.mark.parametrize("task,status", [
+    ("case_close_reminder", CaseStatus.triage),
+    ("case_stable_reminder", CaseStatus.stable),
+])
+@pytest.mark.parametrize("offset,expected", [(0, 1), (1, 0), (6, 0)])
+def test_weekly_reminders_sent_on_monday(task, status, offset, expected):
+    from dispatch.scheduler import scheduler
+
+    func = next(t["func"] for t in scheduler.registered_tasks if t["func"].__name__ == task)
+    # unwrap the decorators down to the plain function
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    with patch.object(scheduled, "date", _FakeDate), patch.object(
+        scheduled, "get_all_by_status", return_value=[_Case()]
+    ), patch.object(scheduled, "send_case_close_reminder") as send:
+        _FakeDate.fake_today = MONDAY + timedelta(days=offset)
+        func(db_session=None, project=type("P", (), {"id": 1})())
+        assert send.call_count == expected
