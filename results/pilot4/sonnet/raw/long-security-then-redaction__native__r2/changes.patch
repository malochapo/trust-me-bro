diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..5e2ef50e
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,23 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_find_entities_skips_masked_values(session, signal_instance, project):
+    signal_instance.raw = redact_raw({"session_token": "abc123", "user": {"name": "alice"}})
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", project=project),
+        EntityType(name="User", jpath="user.name", project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert MASK not in [entity.value for entity in entities]
+    assert [entity.value for entity in entities] == ["alice"]
+
+
+def test_find_entities_skips_masked_values_matched_by_wildcard(session, signal_instance, project):
+    signal_instance.raw = redact_raw({"events": [{"password": "x"}, {"password": "y"}]})
+    entity_types = [EntityType(name="Password", jpath="events[*].password", project=project)]
+
+    assert find_entities(session, signal_instance, entity_types) == []
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..a1c566af
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,22 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permission_classes(route):
+    return [
+        permission
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission in dependency.dependency.permissions_classes
+    ]
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    routes = [
+        route
+        for route in router.routes
+        if route.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in route.methods
+    ]
+
+    assert len(routes) == 1
+    assert IncidentEventPermission in _permission_classes(routes[0])
