@@ -0,0 +1,69 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _fake_today(day: date):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return FakeDate
+
+
+@pytest.mark.parametrize("day_offset", range(7))
+def test_is_reminder_day_only_on_monday(day_offset):
+    day = date(2025, 8, 18) + timedelta(days=day_offset)  # 2025-08-18 is a Monday
+    with mock.patch.object(scheduled, "date", _fake_today(day)):
+        assert scheduled._is_reminder_day() == (day_offset == 0)
+
+
+@pytest.mark.parametrize(
+    "reminder, status, attr",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize(
+    "today, expected_sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)]
+)
+def test_weekly_case_reminders_sent_only_on_monday(reminder, status, attr, today, expected_sent):
+    case = mock.Mock(**{attr: datetime.utcnow() - timedelta(days=10)})
+    # the scheduler decorator doesn't return the function, so look it up by name and
+    # unwrap the timer/project decorators to call the task body directly
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == reminder)
+    while hasattr(task, "__wrapped__"):
+        task = task.__wrapped__
+
+    with mock.patch.object(scheduled, "date", _fake_today(today)), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        task(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    assert send.called == expected_sent
+
+
+def test_case_close_reminder_falls_back_to_created_at_without_triage_at():
+    case = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=10))
+    task = next(
+        t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    while hasattr(task, "__wrapped__"):
+        task = task.__wrapped__
+
+    with mock.patch.object(scheduled, "date", _fake_today(date(2025, 8, 18))), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send, mock.patch.object(
+        scheduled.log, "exception"
+    ) as log_exception:
+        task(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    log_exception.assert_not_called()
+    send.assert_called_once_with(case, mock.ANY)
