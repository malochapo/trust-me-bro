diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..12377253 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,116 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project, case):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.now(timezone.utc)
+
+    def make_instance(age_minutes):
+        instance = SignalInstanceFactory(
+            project=project,
+            signal=signal,
+            entities=[entity],
+            raw=json.dumps({"id": "foo"}),
+            case_id=case.id,
+            created_at=now - timedelta(minutes=age_minutes),
+        )
+        session.add(instance)
+        return instance
+
+    def add_filter():
+        signal_filter = (
+            SignalFilterFactory(
+                name="dedupe-window",
+                expression=[
+                    {
+                        "or": [
+                            {"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}
+                        ]
+                    }
+                ],
+                action="deduplicate",
+                window=30,
+                project=project,
+            )
+        )
+        session.add(signal_filter)
+        signal_filter.signals.append(signal)
+        session.commit()
+
+    # a window of 30 (as picked in the UI) is 30 minutes, not 30 seconds
+    old = make_instance(10)
+    new = make_instance(0)
+    session.commit()
+    add_filter()
+    assert signal.filters
+
+    assert filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.deduplicate
+    assert new.case_id == old.case_id
+
+    # an instance older than the window is not grouped
+    session.delete(old)
+    session.delete(new)
+    stale = make_instance(40)
+    newer = make_instance(0)
+    session.commit()
+    assert not filter_signal(db_session=session, signal_instance=newer)
+    assert newer.filter_action == SignalFilterAction.none
+    assert stale.id != newer.id
+
+
+def test_filter_snooze_skips_expired_filter_and_applies_later_active_one(
+    session, signal, project
+):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory, SignalFilterFactory
+
+    now = datetime.now(timezone.utc).replace(tzinfo=None)
+
+    instance = SignalInstanceFactory(
+        project=project, signal=signal, raw=json.dumps({"id": "foo"}), case=None
+    )
+    session.add(instance)
+    session.commit()
+
+    # the expired filter comes first, the still-valid one after it
+    for name, expiration in (
+        ("expired", now - timedelta(days=7)),
+        ("valid", now + timedelta(days=30)),
+    ):
+        signal_filter = SignalFilterFactory(
+            name=name,
+            expression=[],
+            action="snooze",
+            expiration=expiration,
+            project=project,
+        )
+        session.add(signal_filter)
+        signal_filter.signals.append(signal)
+        session.commit()
+
+    assert [f.name for f in sorted(signal.filters, key=lambda f: f.id)] == ["expired", "valid"]
+
+    assert filter_signal(db_session=session, signal_instance=instance)
+    assert instance.filter_action == SignalFilterAction.snooze
