+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _registered_job(name):
+    # scheduler.add registers the job and returns None, so look it up by name
+    return next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+
+
+@pytest.mark.parametrize("day, expected", [(date(2025, 8, 18 + i), i == 0) for i in range(7)])
+def test_is_reminder_day_only_on_monday(day, expected):
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("today, sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_case_close_reminder_only_sent_on_monday(today, sent):
+    case = mock.Mock(triage_at=datetime.utcnow() - timedelta(days=10))
+    with (
+        mock.patch.object(scheduled, "date") as mock_date,
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]) as get_cases,
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = today
+        # call the undecorated job, bypassing the scheduler/session decorators
+        inspect.unwrap(_registered_job("case-close-reminder"))(
+            db_session=mock.Mock(), project=mock.Mock(id=1)
+        )
+        assert send.called is sent
+        assert get_cases.call_args.kwargs["statuses"] == [CaseStatus.triage]
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at():
+    now = datetime.utcnow()
+    old = mock.Mock(triage_at=None, created_at=now - timedelta(days=10))
+    recent = mock.Mock(triage_at=None, created_at=now - timedelta(days=2))
+    with (
+        mock.patch.object(scheduled, "date") as mock_date,
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[old, recent]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        mock_date.today.return_value = date(2025, 8, 18)  # a Monday
+        inspect.unwrap(_registered_job("case-close-reminder"))(
+            db_session=mock.Mock(), project=mock.Mock(id=1)
+        )
+        log_exception.assert_not_called()
+        assert [c.args[0] for c in send.call_args_list] == [old]
