+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_only_on_monday(day, sent):
+    old = datetime.utcnow() - timedelta(days=10)
+    triage_case = mock.Mock(triage_at=old, stable_at=None)
+    stable_case = mock.Mock(triage_at=None, stable_at=old)
+
+    def by_status(db_session, project_id, statuses):
+        return [triage_case] if statuses == [CaseStatus.triage] else [stable_case]
+
+    project = mock.Mock(id=1)
+    with (
+        mock.patch.object(scheduled, "date") as mock_date,
+        mock.patch.object(scheduled, "get_all_by_status", side_effect=by_status),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = day
+        # bypass the scheduler decorators and call the wrapped task bodies
+        registered = {t["name"]: t["func"] for t in scheduler.registered_tasks}
+        for name in ("case-close-reminder", "case-stable-reminder"):
+            inner = registered[name]
+            while hasattr(inner, "__wrapped__"):
+                inner = inner.__wrapped__
+            inner(db_session=mock.Mock(), project=project)
+
+    assert send.call_count == (2 if sent else 0)
