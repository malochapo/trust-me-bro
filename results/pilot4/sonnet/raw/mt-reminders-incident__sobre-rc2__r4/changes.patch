@@ -0,0 +1,75 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+def _fake_date(today):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    return FakeDate
+
+
+@pytest.mark.parametrize("day,expected", [(18, True), (19, False), (20, False), (24, False), (25, True)])
+def test_is_reminder_day_only_on_monday(day, expected):
+    today = date(2025, 8, day)
+    with mock.patch.object(scheduled, "date", _fake_date(today)):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("day,sent", [(18, True), (19, False)])
+def test_case_close_reminder_sent_only_on_monday(day, sent):
+    case = mock.Mock(triage_at=datetime.utcnow() - timedelta(days=10))
+    with (
+        mock.patch.object(scheduled, "date", _fake_date(date(2025, 8, day))),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        task = next(
+            t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"
+        )
+        fn = task["func"]
+        while hasattr(fn, "__wrapped__"):
+            fn = fn.__wrapped__
+        fn(db_session=mock.Mock(), project=mock.Mock(id=1))
+    assert send.called is sent
+
+
+def _run_close_reminder(case, today):
+    with (
+        mock.patch.object(scheduled, "date", _fake_date(today)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+        fn = task["func"]
+        while hasattr(fn, "__wrapped__"):
+            fn = fn.__wrapped__
+        fn(db_session=mock.Mock(), project=mock.Mock(id=1))
+    return send, log_exception
+
+
+@pytest.mark.parametrize(
+    "age_days,day,sent", [(10, 18, True), (10, 19, False), (3, 18, False)]
+)
+def test_case_close_reminder_without_triage_at_counts_from_created_at(age_days, day, sent):
+    case = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=age_days))
+    send, log_exception = _run_close_reminder(case, date(2025, 8, day))
+    log_exception.assert_not_called()
+    assert send.called is sent
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at():
+    case = mock.Mock(
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    send, _ = _run_close_reminder(case, date(2025, 8, 18))
+    send.assert_not_called()
