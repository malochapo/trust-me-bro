@@ -0,0 +1,62 @@
+from datetime import date
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = day
+        assert _is_reminder_day() is expected
+
+
+def _run_close_reminder(cases):
+    import inspect
+    from types import SimpleNamespace
+
+    from dispatch.case import scheduled  # noqa: F401 (registers the jobs)
+    from dispatch.scheduler import scheduler
+
+    # scheduler.add() doesn't return the function, so fetch it from the registry
+    registered = next(
+        t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    job = inspect.unwrap(registered)
+    with (
+        patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+        patch("dispatch.case.scheduled.get_all_by_status", return_value=cases),
+        patch("dispatch.case.scheduled.send_case_close_reminder") as send,
+    ):
+        job(db_session=None, project=SimpleNamespace(id=1))
+    return send
+
+
+def test_case_close_reminder_falls_back_to_created_at_without_triage_at():
+    from datetime import datetime, timedelta
+    from types import SimpleNamespace
+
+    now = datetime.utcnow()
+    old = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=10))
+    recent = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=2))
+    triaged = SimpleNamespace(triage_at=now - timedelta(days=9), created_at=now - timedelta(days=30))
+    triaged_recently = SimpleNamespace(
+        triage_at=now - timedelta(days=1), created_at=now - timedelta(days=30)
+    )
+
+    send = _run_close_reminder([old, recent, triaged, triaged_recently])
+
+    assert [c.args[0] for c in send.call_args_list] == [old, triaged]
