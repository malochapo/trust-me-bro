+def test_filter_dedup_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_dedup
+    from tests.factories import (
+        CaseFactory,
+        EntityFactory,
+        EntityTypeFactory,
+        SignalFilterFactory,
+        SignalInstanceFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    case = CaseFactory(project=project)
+    earlier = SignalInstanceFactory(
+        project=project, signal=signal, case=case, entities=[entity], raw=json.dumps({"id": "a"})
+    )
+    earlier.created_at = datetime.now(timezone.utc) - timedelta(minutes=10)
+    later = SignalInstanceFactory(
+        project=project, signal=signal, case=None, entities=[entity], raw=json.dumps({"id": "b"})
+    )
+    session.add_all([earlier, later])
+    session.commit()
+
+    # the UI offers windows in minutes: 30 means "dedup within 30 minutes"
+    signal_filter = SignalFilterFactory(
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+    assert signal.filters == [signal_filter]
+
+    filter_dedup(db_session=session, signal_instance=later)
+    assert later.filter_action == SignalFilterAction.deduplicate
+    assert later.case_id == case.id
+
+    # outside the 30 minute window it must not dedup
+    earlier.created_at = datetime.now(timezone.utc) - timedelta(minutes=40)
+    later.filter_action = None
+    later.case_id = None
+    session.commit()
+    filter_dedup(db_session=session, signal_instance=later)
+    assert later.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_snooze_skips_expired_filter_and_applies_later_one(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_snooze
+    from tests.factories import (
+        EntityFactory,
+        EntityTypeFactory,
+        SignalFilterFactory,
+        SignalInstanceFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+    instance = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add(instance)
+    session.commit()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    now = datetime.now(tz=timezone.utc)
+    # the expired filter comes first, the valid one must still be evaluated
+    filters = [
+        SignalFilterFactory(
+            name=name,
+            expression=expression,
+            action="snooze",
+            expiration=expiration,
+            project=project,
+        )
+        for name, expiration in (
+            ("expired", now - timedelta(days=7)),
+            ("valid", now + timedelta(days=30)),
+        )
+    ]
+    signal.filters.extend(filters)
+    session.commit()
+    assert [f.name for f in signal.filters] == ["expired", "valid"]
+
+    filter_snooze(db_session=session, signal_instance=instance)
+    assert instance.filter_action == SignalFilterAction.snooze
