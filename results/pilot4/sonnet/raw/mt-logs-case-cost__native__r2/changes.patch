+def test_case_cost_cut_off_is_earliest_status_timestamp(case, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.case.enums import CaseStatus
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=10)
+    stable_at = now - timedelta(hours=8)
+
+    participant_role.role = ParticipantRoleType.assignee  # full engagement multiplier
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+
+    # the case went stable first and was closed (or escalated) later
+    case.status = CaseStatus.closed
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.escalated_at = (now - timedelta(hours=5)).replace(tzinfo=None)
+    case.closed_at = (now - timedelta(hours=2)).replace(tzinfo=None)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    assert time_seconds == int((stable_at - assumed_at).total_seconds())
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost, business_year_hours, expected_hourly_rate",
+    [
+        (None, 2080, math.ceil(50000 / 2080)),
+        (104000, None, math.ceil(104000 / 2080)),
+        (None, None, math.ceil(50000 / 2080)),
+        (104000, 1040, 100),
+    ],
+)
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(
+    project, annual_employee_cost, business_year_hours, expected_hourly_rate
+):
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = annual_employee_cost
+    project.business_year_hours = business_year_hours
+
+    assert get_hourly_rate(project) == expected_hourly_rate
+
+
+def test_calculate_case_response_cost_without_project_cost_settings(case, session):
+    from dispatch.case_cost.service import calculate_case_response_cost_new
