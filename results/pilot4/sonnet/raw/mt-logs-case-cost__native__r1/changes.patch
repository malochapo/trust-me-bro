+def test_case_cost_stops_at_earliest_status_time_when_closed_after_stable(
+    case, participant, participant_role
+):
+    """Closing a stable case must not bill the time it spent stable."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.case.enums import CaseStatus
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(days=5)
+    stable_at = now - timedelta(days=4)
+    closed_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still in the role when the case was closed
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.closed
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.closed_at = closed_at.replace(tzinfo=None)
+
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # cost stops at stable_at (the earliest cut-off), not at closed_at
+    assert seconds == int((stable_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults(project):
+    """Projects with no annual employee cost or business year hours use the model defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.__table__.c.annual_employee_cost.default.arg
+    default_hours = Project.__table__.c.business_year_hours.default.arg
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+    project.annual_employee_cost = 104000
+    assert get_hourly_rate(project) == math.ceil(104000 / default_hours)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
+
+    project.annual_employee_cost = 104000
+    project.business_year_hours = 2080
+    assert get_hourly_rate(project) == 50
