+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # an instance 10 minutes old is inside a 30 minute window
+    old_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(old_instance)
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(new_instance)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,  # minutes
+        project=project,
+    )
+    session.add(signal_filter)
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.deduplicate
+    assert new_instance.case_id == old_instance.case_id
+
+
