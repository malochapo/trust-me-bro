+import inspect
+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = day
+        assert _is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "triage_age, created_age, expect_reminder",
+    [
+        (timedelta(days=10), timedelta(days=30), True),
+        (timedelta(days=2), timedelta(days=30), False),  # triage_at wins over created_at
+        (None, timedelta(days=10), True),  # no triage_at: count from created_at
+        (None, timedelta(days=2), False),
+    ],
+)
+def test_case_close_reminder_triage_at_fallback(
+    session, project, triage_age, created_age, expect_reminder
+):
+    from dispatch.case.enums import CaseStatus
+    from dispatch.scheduler import scheduler
+    from tests.factories import CaseFactory
+
+    now = datetime.utcnow()
+    case = CaseFactory(
+        project=project,
+        created_at=now - created_age,
+        triage_at=now - triage_age if triage_age else None,
+    )
+    # CaseFactory treats status as a factory param and doesn't pass it to the model
+    case.status = CaseStatus.triage
+    session.commit()
+
+    # the scheduler decorator doesn't return the task, so look it up in the registry
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    with (
+        patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+        patch("dispatch.case.scheduled.send_case_close_reminder") as send,
+        patch("dispatch.case.scheduled.log") as log,
+    ):
+        job(db_session=session, project=project)
+
+    log.exception.assert_not_called()
+    if expect_reminder:
+        assert send.call_args_list[-1].args[0] == case
+    else:
+        assert all(c.args[0] != case for c in send.call_args_list)
