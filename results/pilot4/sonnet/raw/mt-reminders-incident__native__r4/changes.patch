+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _freeze_today(day):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return mock.patch.object(scheduled, "date", FrozenDate)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with _freeze_today(day):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "name,status,age_field",
+    [
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+    ],
+)
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_case_reminders_only_send_on_mondays(name, status, age_field, day, sent):
+    case = mock.Mock(**{age_field: datetime.utcnow() - timedelta(days=10)})
+    # @scheduler.add returns None, so look the task up; unwrap skips the project/session wrappers
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    raw = inspect.unwrap(task["func"])
+
+    with _freeze_today(day), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ) as get_cases, mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        raw(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    assert get_cases.call_args.kwargs["statuses"] == [status]
+    assert send.called is sent
+
+
+@pytest.mark.parametrize("age_days,sent", [(10, True), (3, False)])
+def test_case_close_reminder_falls_back_to_created_at(age_days, sent):
+    case = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=age_days))
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    raw = inspect.unwrap(task["func"])
+
+    with _freeze_today(date(2025, 8, 18)), mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send, mock.patch.object(
+        scheduled.log, "exception"
+    ) as log_exception:
+        raw(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    log_exception.assert_not_called()
+    assert send.called is sent
