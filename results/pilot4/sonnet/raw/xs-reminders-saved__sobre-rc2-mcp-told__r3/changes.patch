+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _undecorated(name):
+    """The scheduler decorator returns None, so fetch the task from its registry."""
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day_only_on_monday(day, expected):
+    with patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+class _FakeCase:
+    def __init__(self):
+        old = datetime.utcnow() - timedelta(days=10)
+        self.triage_at = old
+        self.stable_at = old
+
+
+@pytest.mark.parametrize(
+    "func,status",
+    [
+        ("case-close-reminder", CaseStatus.triage),
+        ("case-stable-reminder", CaseStatus.stable),
+    ],
+)
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_sent_on_monday(func, status, day, sent):
+    with (
+        patch.object(scheduled, "date") as mock_date,
+        patch.object(scheduled, "get_all_by_status", return_value=[_FakeCase()]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = day
+        _undecorated(func)(db_session=None, project=type("P", (), {"id": 1})())
+        assert send.called is sent
