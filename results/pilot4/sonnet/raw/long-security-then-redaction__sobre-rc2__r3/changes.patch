diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..c0ced661
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,22 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permissions_for(route):
+    perms = []
+    for dep in route.dependencies:
+        call = dep.dependency
+        if isinstance(call, PermissionsDependency):
+            perms.extend(call.permissions_classes)
+    return perms
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident event must be guarded by IncidentEventPermission."""
+    routes = [
+        r
+        for r in router.routes
+        if r.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in r.methods
+    ]
+    assert len(routes) == 1
+    assert IncidentEventPermission in _permissions_for(routes[0])
