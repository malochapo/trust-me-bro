+from datetime import date, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+def _freeze_today(day: date):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return patch.object(scheduled, "date", FrozenDate)
+
+
+# 2025-08-17 is a Sunday, 2025-08-18 a Monday
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = date(2025, 8, 17) + timedelta(days=offset)
+    with _freeze_today(day):
+        assert scheduled._is_reminder_day() == (day.strftime("%A") == "Monday")
+
