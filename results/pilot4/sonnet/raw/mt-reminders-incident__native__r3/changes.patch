+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_close_reminder(monkeypatch, cases, today):
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: cases)
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: today)
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", lambda case, db: sent.append(case))
+    # scheduler.add() registers the job without returning it, so look it up by name
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(db_session=None, project=SimpleNamespace(id=1))
+    return sent
+
+
+def test_case_close_reminder_falls_back_to_created_at(monkeypatch):
+    now = datetime.utcnow()
+    no_triage_at = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=10))
+    new_no_triage_at = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=2))
+    with_triage_at = SimpleNamespace(
+        triage_at=now - timedelta(days=9), created_at=now - timedelta(days=30)
+    )
+    recently_triaged = SimpleNamespace(
+        triage_at=now - timedelta(days=1), created_at=now - timedelta(days=30)
+    )
+    cases = [no_triage_at, new_no_triage_at, with_triage_at, recently_triaged]
+
+    sent = _run_close_reminder(monkeypatch, cases, today=True)
+
+    assert sent == [no_triage_at, with_triage_at]
+
+
+def test_case_close_reminder_only_on_reminder_day(monkeypatch):
+    case = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=10))
+
+    assert _run_close_reminder(monkeypatch, [case], today=False) == []
