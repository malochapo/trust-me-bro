+def test_case_cost_stops_at_earliest_status_timestamp(case, participant, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = three_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # the case was marked stable two hours ago and closed an hour ago
+    case.status = CaseStatus.closed
+    case.stable_at = two_hours_ago
+    case.escalated_at = None
+    case.closed_at = one_hour_ago
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    expected_seconds = (two_hours_ago - three_hours_ago).total_seconds()
+    assert time_seconds == expected_seconds
+
+    # an escalation after the stable time must not extend the cut-off either
+    case.status = CaseStatus.escalated
+    case.closed_at = None
+    case.escalated_at = one_hour_ago
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == expected_seconds
+
+
+def test_get_hourly_rate__missing_project_rates_use_model_defaults(project):
+    """Tests that a project without rate settings falls back to the project model defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.annual_employee_cost.default.arg
+    default_hours = Project.business_year_hours.default.arg
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+    project.annual_employee_cost = 100000
+    assert get_hourly_rate(project) == math.ceil(100000 / default_hours)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
+
+
+def test_update_case_response_cost__project_without_rates(
+    case, session, participant_activity, case_cost_type, cost_model_activity
+):
+    """Tests that a case in a project without rate settings still gets a cost."""
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import update_case_response_cost
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+    participant_activity.case = case
+    case.case_type.cost_model.enabled = True
+    case.case_type.cost_model.activities = [cost_model_activity]
+
+    results = update_case_response_cost(case=case, db_session=session)
+    assert results[CostModelType.new] > 0
+    assert results[CostModelType.classic] >= 0
