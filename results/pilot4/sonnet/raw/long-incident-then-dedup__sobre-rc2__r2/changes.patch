+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    """A dedup filter's window is in minutes, as in the UI: 30 groups instances 10 minutes apart."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    signal_filter = SignalFilterFactory(
+        name="window-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    now = datetime.now(timezone.utc)
+    for age_minutes, expected in [(10, SignalFilterAction.deduplicate), (40, SignalFilterAction.none)]:
+        earlier = SignalInstanceFactory(
+            project=project,
+            signal=signal,
+            entities=[entity],
+            raw=json.dumps({"id": "foo"}),
+            created_at=now - timedelta(minutes=age_minutes),
+        )
+        session.add(earlier)
+        session.commit()
+
+        new = SignalInstanceFactory(
+            project=project,
+            signal=signal,
+            entities=[entity],
+            raw=json.dumps({"id": "foo"}),
+            case=None,
+            created_at=now,
+        )
+        session.add(new)
+        session.commit()
+
+        filter_signal(db_session=session, signal_instance=new)
+        assert new.filter_action == expected
+
+        # isolate the next scenario
+        session.delete(new)
+        session.delete(earlier)
+        session.commit()
+
+
+def test_filter_snooze_skips_expired_filter_and_applies_valid_one(session, signal, project):
+    """An expired snooze filter must not stop later, still-valid snooze filters from applying."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    expression = [
+        {"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}
+    ]
+    now = datetime.now(timezone.utc).replace(tzinfo=None)
+    # the expired filter comes first, the valid one after it
+    filters = [
+        SignalFilterFactory(
+            name=name,
+            description="test",
+            expression=expression,
+            action="snooze",
+            expiration=expiration,
+            project=project,
+        )
+        for name, expiration in [
+            ("expired", now - timedelta(days=7)),
+            ("valid", now + timedelta(days=30)),
+        ]
+    ]
+    signal.filters = filters
+    session.commit()
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    assert [f.name for f in signal.filters] == ["expired", "valid"]
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
