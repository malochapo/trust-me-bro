@@ -0,0 +1,64 @@
+from datetime import date, datetime
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+    assert scheduled._is_reminder_day() is expected
+
+
+def _registered_task(name):
+    # scheduler.add() registers the task and returns None, so look it up by name
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "triage_at,created_at,sent",
+    [
+        (None, datetime(2025, 8, 1), True),  # falls back to created_at
+        (None, datetime(2025, 8, 15), False),  # created less than a week ago
+        (datetime(2025, 8, 15), datetime(2025, 8, 1), False),  # triage_at wins
+        (datetime(2025, 8, 1), None, True),
+    ],
+)
+def test_case_close_reminder_triage_at_fallback(monkeypatch, triage_at, created_at, sent):
+    class FakeDatetime(datetime):
+        @classmethod
+        def utcnow(cls):
+            return datetime(2025, 8, 18, 18, 0)
+
+    case = SimpleNamespace(triage_at=triage_at, created_at=created_at)
+    reminders = []
+    monkeypatch.setattr(scheduled, "datetime", FakeDatetime)
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda c, db_session: reminders.append(c)
+    )
+
+    _registered_task("case-close-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    assert (reminders == [case]) is sent
