+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),  # Wednesday
+        (date(2025, 8, 17), False),  # Sunday
+        (date(2025, 8, 18), True),  # Monday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = day
+        assert _is_reminder_day() is expected
+
+
+def _unwrap():
+    # the scheduler decorator returns None, so look the task up in the registry
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "triage_at, created_at, sent",
+    [
+        (None, datetime.utcnow() - timedelta(days=10), True),  # falls back to created_at
+        (None, datetime.utcnow() - timedelta(days=2), False),
+        (datetime.utcnow() - timedelta(days=10), datetime.utcnow(), True),  # triage_at wins
+    ],
+)
+def test_case_close_reminder_missing_triage_at(triage_at, created_at, sent):
+    case = SimpleNamespace(triage_at=triage_at, created_at=created_at)
+    with (
+        patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+        patch("dispatch.case.scheduled.get_all_by_status", return_value=[case]),
+        patch("dispatch.case.scheduled.send_case_close_reminder") as send,
+        patch("dispatch.case.scheduled.log") as log,
+    ):
+        _unwrap()(db_session=None, project=SimpleNamespace(id=1))
+
+    log.exception.assert_not_called()
+    assert send.called is sent
