+import inspect
+from datetime import date, datetime, timedelta
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+
+
+def _task(name):
+    # scheduler.add() registers the task and returns None, so look it up by name
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(func)
+
+
+class _FakeDate(date):
+    today_value = MONDAY
+
+    @classmethod
+    def today(cls):
+        return cls.today_value
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = MONDAY + timedelta(days=offset)
+    with patch.object(scheduled, "date", type("D", (_FakeDate,), {"today_value": day})):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize("task", ["case-close-reminder", "case-stable-reminder"])
+@pytest.mark.parametrize("offset,expected", [(0, True), (1, False), (6, False)])
+def test_weekly_case_reminders_sent_on_monday_only(task, offset, expected):
+    day = MONDAY + timedelta(days=offset)
+    old = datetime.utcnow() - timedelta(days=30)
+    case = MagicMock(triage_at=old, stable_at=old)
+    fake_date = type("D", (_FakeDate,), {"today_value": day})
+
+    with patch.object(scheduled, "date", fake_date), patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), patch.object(scheduled, "send_case_close_reminder") as send:
+        _task(task)(db_session=MagicMock(), project=MagicMock(id=1))
+
+    assert send.called is expected
