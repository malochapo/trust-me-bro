@@ -0,0 +1,72 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+def _fake_date(today):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    return FakeDate
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch.object(scheduled, "date", _fake_date(today)):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("name", ["case-close-reminder", "case-stable-reminder"])
+@pytest.mark.parametrize("today,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_close_reminders_only_sent_on_mondays(name, today, sent):
+    case = mock.Mock()
+    case.triage_at = case.stable_at = datetime.utcnow() - timedelta(days=10)
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+
+    def run_in_mock_context(func, *args, **kwargs):
+        return func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    with (
+        mock.patch("dispatch.decorators._execute_task_in_project_context", run_in_mock_context),
+        mock.patch.object(scheduled, "date", _fake_date(today)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        task()
+
+    assert send.called is sent
+
+
+@pytest.mark.parametrize("today,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_close_reminder_counts_from_created_at_when_triage_at_missing(today, sent):
+    old = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=10))
+    recent = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+
+    def run_in_mock_context(func, *args, **kwargs):
+        return func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    with (
+        mock.patch("dispatch.decorators._execute_task_in_project_context", run_in_mock_context),
+        mock.patch.object(scheduled, "date", _fake_date(today)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[old, recent]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        task()
+
+    log_exception.assert_not_called()
+    assert [c.args[0] for c in send.call_args_list] == ([old] if sent else [])
