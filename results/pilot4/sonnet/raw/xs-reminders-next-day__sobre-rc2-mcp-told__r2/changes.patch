+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),
+    ],
+)
+def test_is_reminder_day_only_on_monday(day, expected):
+    _FakeDate._today = day
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+class _Case:
+    def __init__(self):
+        old = datetime.utcnow() - timedelta(days=14)
+        self.triage_at = old
+        self.stable_at = old
+
+
+@pytest.mark.parametrize(
+    "func,status",
+    [
+        ("case-close-reminder", CaseStatus.triage),
+        ("case-stable-reminder", CaseStatus.stable),
+    ],
+)
+@pytest.mark.parametrize("day,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_sent_on_monday(func, status, day, sent):
+    _FakeDate._today = day
+    case = _Case()
+    # unwrap the scheduler/project decorators to call the task body directly
+    inner = next(t["func"] for t in scheduler.registered_tasks if t["name"] == func)
+    while hasattr(inner, "__wrapped__"):
+        inner = inner.__wrapped__
+    with patch.object(scheduled, "date", _FakeDate), patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), patch.object(scheduled, "send_case_close_reminder") as send:
+        inner(db_session=None, project=type("P", (), {"id": 1})())
+    assert send.called is sent
