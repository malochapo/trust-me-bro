@@ -0,0 +1,116 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case.enums import CaseStatus
+import dispatch.case.scheduled  # noqa: F401 registers the reminder tasks
+from dispatch.scheduler import scheduler
+
+
+MONDAY = date(2025, 8, 18)
+
+
+def _create_case(session, project, status, **fields):
+    """Creates a case with the given status; CaseFactory ignores a status keyword, so set it after."""
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project, **fields)
+    case.status = status
+    session.flush()
+    return case
+
+
+def _run_task(task_name, session, project, today):
+    """Runs the named scheduled task with `today` as the current date and returns the mocked sender."""
+    # the scheduler decorator doesn't return the function, so look it up by name
+    (task,) = [t["func"] for t in scheduler.registered_tasks if t["name"] == task_name]
+
+    # unwrap the scheduler, project context, and timer decorators
+    func = task
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+
+    with (
+        mock.patch("dispatch.case.scheduled.date") as mock_date,
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as mock_send,
+    ):
+        mock_date.today.return_value = today
+        func(db_session=session, project=project)
+
+    return mock_send
+
+
+@pytest.mark.parametrize(
+    "task_name, status, timestamp_field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+    ids=["triage", "stable"],
+)
+@pytest.mark.parametrize("day_offset", range(7))
+def test_long_running_case_reminder_only_sent_on_monday(
+    session, project, task_name, status, timestamp_field, day_offset
+):
+    _create_case(
+        session,
+        project,
+        status,
+        **{timestamp_field: datetime.utcnow() - timedelta(days=10)},
+    )
+
+    today = MONDAY + timedelta(days=day_offset)
+    mock_send = _run_task(task_name, session, project, today)
+
+    if today.weekday() == 0:
+        mock_send.assert_called_once()
+    else:
+        mock_send.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "task_name, status, timestamp_field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+    ids=["triage", "stable"],
+)
+def test_case_without_timestamp_does_not_block_others(
+    session, project, task_name, status, timestamp_field
+):
+    _create_case(session, project, status, **{timestamp_field: None})
+    long_running = _create_case(
+        session,
+        project,
+        status,
+        **{timestamp_field: datetime.utcnow() - timedelta(days=10)},
+    )
+
+    mock_send = _run_task(task_name, session, project, MONDAY)
+
+    mock_send.assert_called_once()
+    assert mock_send.call_args.args[0].id == long_running.id
+
+
+def test_triage_case_without_triage_at_counts_from_created_at(session, project):
+    old_case = _create_case(
+        session,
+        project,
+        CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=10),
+    )
+    _create_case(
+        session,
+        project,
+        CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    mock_send = _run_task("case-close-reminder", session, project, MONDAY)
+
+    mock_send.assert_called_once()
+    assert mock_send.call_args.args[0].id == old_case.id
