+def test_case_cost_stops_at_earliest_status_timestamp(case, session, participant, participant_role):
+    """Tests that participant time is cut off at the earliest of escalated/stable/closed.
+
+    A case that was escalated and later marked stable must stop accruing participant time at the
+    escalation, not at the stable time.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import (
+        get_engagement_multiplier,
+        get_participant_role_time_seconds,
+    )
+    from dispatch.case.enums import CaseStatus
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=3)
+    escalated_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.closed_at = None
+
+    # the participant is billed from assumption until escalation (1 hour), not until stable (2 hours)
+    expected_seconds = 3600 * get_engagement_multiplier(participant_role.role)
+    actual_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert abs(actual_seconds - expected_seconds) < 1
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults(case):
+    """Tests that projects with no annual employee cost or business year hours use the model defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    project = case.project
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    expected_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+    assert get_hourly_rate(project) == expected_rate
+
+    # only the missing value falls back, the set value is still used
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+
+def test_calculate_case_response_cost_new_with_missing_project_values(
+    case, session, participant_activity
+):
+    """Tests that a case in a project with missing cost settings still gets a response cost."""
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost_new,
+        calculate_response_cost,
+        get_hourly_rate,
+    )
+
+    participant_activity.case = case
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    amount = calculate_case_response_cost_new(case=case, db_session=session)
+
+    expected_amount = calculate_response_cost(
+        hourly_rate=get_hourly_rate(case.project),
+        total_response_time_seconds=(
+            participant_activity.ended_at - participant_activity.started_at
+        ).total_seconds(),
+    )
+    assert amount == expected_amount
