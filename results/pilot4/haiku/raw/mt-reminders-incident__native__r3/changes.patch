+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled as case_scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+from tests.factories import CaseFactory
+
+
+def freeze_today(monkeypatch, day: date):
+    """Makes date.today() return the given day inside the scheduled module."""
+
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(case_scheduled, "date", FrozenDate)
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day_only_on_monday(monkeypatch, day, expected):
+    freeze_today(monkeypatch, day)
+
+    assert case_scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "task_name, status, timestamp_field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+def test_weekly_reminders_sent_on_monday_only(
+    session, project, monkeypatch, task_name, status, timestamp_field
+):
+    # the registered job is timer(scheduled_project_task(raw)), so unwrap to the raw function
+    task = next(t for t in scheduler.registered_tasks if t["name"] == task_name)
+    job = task["func"].__wrapped__.__wrapped__
+
+    case = CaseFactory(project=project)
+    case.status = status
+    setattr(case, timestamp_field, datetime.utcnow() - timedelta(days=8))
+    session.add(case)
+    session.commit()
+
+    sent = []
+    monkeypatch.setattr(
+        case_scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+
+    today = date.today()
+    monday = today - timedelta(days=today.weekday())
+
+    freeze_today(monkeypatch, monday + timedelta(days=1))  # Tuesday
+    job(session, project)
+    assert sent == []
+
+    freeze_today(monkeypatch, monday)
+    job(session, project)
+    assert sent == [case.id]
+
+
+@pytest.mark.parametrize("days_since_created, expected_sent", [(8, True), (2, False)])
+def test_close_reminder_counts_from_created_at_without_triage_at(
+    session, project, monkeypatch, days_since_created, expected_sent
+):
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = task["func"].__wrapped__.__wrapped__
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=days_since_created)
+    session.add(case)
+    session.commit()
+
+    sent = []
+    monkeypatch.setattr(
+        case_scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+
+    today = date.today()
+    monday = today - timedelta(days=today.weekday())
+    freeze_today(monkeypatch, monday)
+    job(session, project)
+
+    assert (sent == [case.id]) is expected_sent
