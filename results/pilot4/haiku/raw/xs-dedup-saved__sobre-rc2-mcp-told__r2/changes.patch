+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        CaseFactory,
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    recent_case = CaseFactory(project=project)
+    old_case = CaseFactory(project=project)
+    session.add(recent_case)
+    session.add(old_case)
+
+    now = datetime.now(timezone.utc)
+    # 10 minutes before the new instance, inside a 30 minute window
+    recent_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        case=recent_case,
+        created_at=now - timedelta(minutes=10),
+    )
+    # 40 minutes before the new instance, outside a 30 minute window
+    old_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        case=old_case,
+        created_at=now - timedelta(minutes=40),
+    )
+    session.add(recent_instance)
+    session.add(old_instance)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now,
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-30",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.deduplicate
+    assert signal_instance.case_id == recent_case.id
+
+
