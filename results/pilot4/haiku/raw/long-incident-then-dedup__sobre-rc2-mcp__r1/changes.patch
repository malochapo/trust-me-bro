index 00000000..55172b22
--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,127 @@
+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    """Pins date.today() so the weekday checks are deterministic."""
+
+    @classmethod
+    def today(cls):
+        return cls._pinned
+
+
+def _pin_today(day: date):
+    return patch.object(scheduled, "date", type("PinnedDate", (_FakeDate,), {"_pinned": day}))
+
+
+# 2025-08-11 is a Monday; 2025-08-12 is the following Tuesday.
+MONDAY = date(2025, 8, 11)
+TUESDAY = date(2025, 8, 12)
+
+
+@pytest.mark.parametrize("day, expected", [(MONDAY + timedelta(days=i), i == 0) for i in range(7)])
+def test_is_reminder_day(day, expected):
+    with _pin_today(day):
+        assert scheduled._is_reminder_day() is expected
+
+
+def _registered_job(name: str):
+    """Returns the undecorated function the scheduler runs for the named job."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+def _long_running_case(status_timestamp_field: str):
+    old = datetime.utcnow() - timedelta(days=8)
+    return SimpleNamespace(name="case-1", **{status_timestamp_field: old})
+
+
+@pytest.mark.parametrize(
+    "job, timestamp_field",
+    [
+        ("case-close-reminder", "triage_at"),
+        ("case-stable-reminder", "stable_at"),
+    ],
+)
+def test_long_running_reminders_sent_on_monday(job, timestamp_field):
+    original = _registered_job(job)
+    case = _long_running_case(timestamp_field)
+
+    with (
+        _pin_today(MONDAY),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        original(db_session=None, project=SimpleNamespace(id=1))
+
+    send.assert_called_once_with(case, None)
+
+
+@pytest.mark.parametrize(
+    "job, timestamp_field",
+    [
+        ("case-close-reminder", "triage_at"),
+        ("case-stable-reminder", "stable_at"),
+    ],
+)
+def test_long_running_reminders_not_sent_on_other_days(job, timestamp_field):
+    original = _registered_job(job)
+    case = _long_running_case(timestamp_field)
+
+    with (
+        _pin_today(TUESDAY),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        original(db_session=None, project=SimpleNamespace(id=1))
+
+    send.assert_not_called()
+
+
+def _triage_case(triage_at, created_at):
+    return SimpleNamespace(name="case-1", triage_at=triage_at, created_at=created_at)
+
+
+def _run_close_reminder_on(day: date, case):
+    original = _registered_job("case-close-reminder")
+    with (
+        _pin_today(day),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        original(db_session=None, project=SimpleNamespace(id=1))
+    return send
+
+
+def test_close_reminder_counts_from_created_at_when_triage_at_missing():
+    now = datetime.utcnow()
+    case = _triage_case(triage_at=None, created_at=now - timedelta(days=8))
+
+    send = _run_close_reminder_on(MONDAY, case)
+
+    send.assert_called_once_with(case, None)
+
+
+def test_close_reminder_skips_recent_case_without_triage_at():
+    now = datetime.utcnow()
+    case = _triage_case(triage_at=None, created_at=now - timedelta(days=2))
+
+    send = _run_close_reminder_on(MONDAY, case)
+
+    send.assert_not_called()
+
+
+def test_close_reminder_prefers_triage_at_over_created_at():
+    now = datetime.utcnow()
+    case = _triage_case(triage_at=now - timedelta(days=2), created_at=now - timedelta(days=30))
+
+    send = _run_close_reminder_on(MONDAY, case)
+
+    send.assert_not_called()
