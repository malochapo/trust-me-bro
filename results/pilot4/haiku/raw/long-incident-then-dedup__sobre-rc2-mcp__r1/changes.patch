diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..78a0373d 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,124 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def _dedup_instances_ten_minutes_apart(session, signal, project, window):
+    from datetime import datetime, timedelta
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.utcnow()
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    filtered = filter_signal(db_session=session, signal_instance=signal_instance_2)
+    return signal_instance_1, signal_instance_2, filtered, SignalFilterAction
+
+
+def test_filter_deduplicate_window_is_in_minutes(session, signal, project):
+    # the UI sets the window in minutes, so a 30 minute window must group
+    # instances that are ten minutes apart
+    instance_1, instance_2, filtered, action = _dedup_instances_ten_minutes_apart(
+        session, signal, project, window=30
+    )
+
+    assert filtered
+    assert instance_2.filter_action == action.deduplicate
+    assert instance_2.case_id == instance_1.case_id
+
+
+def test_filter_deduplicate_window_excludes_older_instances(session, signal, project):
+    # a 5 minute window must not group instances that are ten minutes apart
+    instance_1, instance_2, filtered, action = _dedup_instances_ten_minutes_apart(
+        session, signal, project, window=5
+    )
+
+    assert not filtered
+    assert instance_2.filter_action == action.none
+
+
+def test_filter_actions_snooze_skips_expired_filter(session, entity, signal, project):
+    # an expired snooze filter must not stop the check for a later, valid one
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    expired_filter = SignalFilterFactory(
+        name="snooze-expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="snooze-valid",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+
+    signal.filters = [expired_filter, valid_filter]
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
