diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..745bde25
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,34 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_returns_masked_values(session, signal_instance, project):
+    """A sensitive value must not become an entity, even before the signal flow masks it.
+
+    Regression guard: the masked placeholder was used as an entity value, so unrelated
+    instances shared one entity and were grouped into the same case by deduplication.
+    """
+    signal_instance.raw = {
+        "session_token": "secret-token-1",
+        "asset": {"id": "arn:aws:iam::123456789012:role/Test"},
+    }
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
+
+
+def test_find_entities_ignores_placeholder_in_masked_payload(session, signal_instance, project):
+    signal_instance.raw = {"session_token": MASK, "asset": {"id": "arn:aws:iam::123456789012:role/Test"}}
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Asset", jpath="asset.id", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [str(entity.value) for entity in entities] == ["arn:aws:iam::123456789012:role/Test"]
diff --git a/tests/incident/test_views.py b/tests/incident/test_views.py
new file mode 100644
index 00000000..8811f057
--- /dev/null
+++ b/tests/incident/test_views.py
@@ -0,0 +1,32 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"Route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission.
+
+    Regression guard: the permission dependency was dropped in 28c21e1e.
+    """
+    route = _get_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permission_dependencies = [
+        dep.dependency
+        for dep in route.dependencies
+        if isinstance(dep.dependency, PermissionsDependency)
+    ]
+    guarded_permissions = [
+        permission_class
+        for dependency in permission_dependencies
+        for permission_class in dependency.permissions_classes
+    ]
+
+    assert IncidentEventPermission in guarded_permissions
