+from datetime import date
+
+from dispatch.case import scheduled
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+def test_is_reminder_day_on_monday(monkeypatch):
+    # 2025-08-18 is a Monday
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+    _FakeDate._today = date(2025, 8, 18)
+    assert scheduled._is_reminder_day()
+
+
+def test_is_reminder_day_not_on_other_days(monkeypatch):
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+    for day in range(12, 18):  # Tuesday 2025-08-12 through Sunday 2025-08-17
+        _FakeDate._today = date(2025, 8, day)
+        assert not scheduled._is_reminder_day(), _FakeDate._today
