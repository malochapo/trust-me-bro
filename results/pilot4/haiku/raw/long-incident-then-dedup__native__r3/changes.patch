@@ -0,0 +1,116 @@
+import inspect
+
+from datetime import date as real_date, datetime, timedelta
+
+import pytest
+
+
+class FakeDate(real_date):
+    """A date whose today() is pinned to the value set on the class."""
+
+    pinned: real_date
+
+    @classmethod
+    def today(cls):
+        return cls.pinned
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (real_date(2025, 8, 18), True),  # Monday
+        (real_date(2025, 8, 19), False),  # Tuesday
+        (real_date(2025, 8, 20), False),  # Wednesday
+        (real_date(2025, 8, 21), False),  # Thursday
+        (real_date(2025, 8, 22), False),  # Friday
+        (real_date(2025, 8, 23), False),  # Saturday
+        (real_date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    from dispatch.case import scheduled
+
+    FakeDate.pinned = day
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.fixture
+def monday(monkeypatch):
+    from dispatch.case import scheduled
+
+    FakeDate.pinned = real_date(2025, 8, 18)
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+
+@pytest.fixture
+def sent_close_reminders(monkeypatch):
+    from dispatch.case import scheduled
+
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    return sent
+
+
+def run_case_close_reminder(session, project):
+    from dispatch.scheduler import scheduler
+
+    # the scheduler decorator doesn't return the function, so we look it up by name
+    # and unwrap the task decorators to get to the job body
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    job(db_session=session, project=project)
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, project, monday, sent_close_reminders
+):
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    run_case_close_reminder(session, project)
+
+    assert sent_close_reminders == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(
+    session, project, monday, sent_close_reminders
+):
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=3)
+    session.commit()
+
+    run_case_close_reminder(session, project)
+
+    assert sent_close_reminders == []
+
+
+def test_case_close_reminder_prefers_triage_at_when_set(
+    session, project, monday, sent_close_reminders
+):
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    case.created_at = datetime.utcnow() - timedelta(days=1)
+    session.commit()
+
+    run_case_close_reminder(session, project)
+
+    assert sent_close_reminders == [case]
