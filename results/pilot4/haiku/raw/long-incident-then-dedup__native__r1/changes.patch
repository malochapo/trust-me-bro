@@ -0,0 +1,73 @@
+import inspect
+from datetime import date as real_date
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class FakeDate:
+    """Stands in for datetime.date so the test controls what "today" is."""
+
+    current = real_date(2025, 8, 18)  # a Monday
+
+    @classmethod
+    def today(cls):
+        return cls.current
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (real_date(2025, 8, 18), True),  # Monday
+        (real_date(2025, 8, 19), False),
+        (real_date(2025, 8, 20), False),
+        (real_date(2025, 8, 21), False),
+        (real_date(2025, 8, 22), False),
+        (real_date(2025, 8, 23), False),
+        (real_date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, day, expected):
+    # regression: the check compared isoweekday() (Monday == 1) with
+    # calendar.MONDAY (Monday == 0), so no day ever matched
+    FakeDate.current = day
+    mocker.patch.object(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.fixture
+def monday(mocker):
+    FakeDate.current = real_date(2025, 8, 18)
+    mocker.patch.object(scheduled, "date", FakeDate)
+    return FakeDate
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at(
+    session, project, monday, mocker
+):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    # regression: triage_at is None for some triaging cases, which raised a TypeError
+    # every evening; they should be counted from created_at instead
+    now = datetime.utcnow()
+    old_case = CaseFactory(project=project, triage_at=None, created_at=now - timedelta(days=8))
+    recent_case = CaseFactory(project=project, triage_at=None, created_at=now - timedelta(days=2))
+    for case in (old_case, recent_case):
+        # the factory does not apply the status argument, so we set it directly
+        case.status = CaseStatus.triage
+    session.commit()
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    # the task is run per project by the scheduler decorators, so we call the original function
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task)(db_session=session, project=project)
+
+    sent = [call.kwargs.get("case") or call.args[0] for call in send.call_args_list]
+    assert old_case in sent
+    assert recent_case not in sent
