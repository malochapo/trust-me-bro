+def test_case_cost_stops_at_earliest_status_timestamp(case, participant, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at.
+
+    A case that was escalated and later marked stable must stop accruing cost at
+    escalated_at, not at stable_at.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    assumed_at = now - timedelta(hours=3)
+    escalated_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = assumed_at
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at
+    case.stable_at = stable_at
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+    # the same holds once the case is closed after it was stable
+    case.closed_at = now
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost,business_year_hours",
+    [(None, 2080), (50000, None), (None, None)],
+)
+def test_get_hourly_rate_falls_back_to_project_defaults(
+    project, annual_employee_cost, business_year_hours
+):
+    """Tests that projects with unset cost values use the project model's defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = annual_employee_cost
+    project.business_year_hours = business_year_hours
+
+    # the defaults are 50000 per year and 2080 business hours per year
+    assert get_hourly_rate(project) == math.ceil(50000 / 2080)
+
+
+def test_case_cost_with_unset_project_values(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a case on a project with unset cost values still gets a response cost."""
+    import math
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost_classic
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = one_hour_ago
+    participant_role.renounced_at = now
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    cost = calculate_case_response_cost_classic(case=case, db_session=session)
+
+    # one hour at full engagement, at the default hourly rate
+    assert cost == math.ceil(50000 / 2080)
