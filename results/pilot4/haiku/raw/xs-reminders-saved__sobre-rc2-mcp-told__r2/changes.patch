+import calendar
+from datetime import date, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        # 2025-08-11 is a Monday
+        (date(2025, 8, 11) + timedelta(days=offset), offset == 0)
+        for offset in range(7)
+    ],
+)
+def test_is_reminder_day(day, expected):
+    frozen = mock.Mock(wraps=date)
+    frozen.today.return_value = day
+    with mock.patch.object(scheduled, "date", frozen):
+        assert scheduled._is_reminder_day() is expected
+
+
+def test_is_reminder_day_uses_calendar_monday():
+    # Python's calendar module numbers Monday as 0 while isoweekday() numbers it 1,
+    # so the helper must compare against weekday() to match calendar.MONDAY
+    assert calendar.MONDAY == 0
+    frozen = mock.Mock(wraps=date)
+    frozen.today.return_value = date(2025, 8, 18)
+    with mock.patch.object(scheduled, "date", frozen):
+        assert scheduled._is_reminder_day() is True
