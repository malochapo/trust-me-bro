+import inspect
+from datetime import date, datetime
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "triage_at, created_at, expected",
+    [
+        # triage_at is missing, so the case counts from when it was created
+        (None, datetime(2025, 8, 9, 12, 0), True),
+        (None, datetime(2025, 8, 16, 12, 0), False),
+        # triage_at is set and takes precedence over created_at
+        (datetime(2025, 8, 9, 12, 0), datetime(2025, 8, 16, 12, 0), True),
+        (datetime(2025, 8, 16, 12, 0), datetime(2025, 8, 9, 12, 0), False),
+    ],
+)
+def test_case_close_reminder_timestamp_fallback(triage_at, created_at, expected):
+    case = SimpleNamespace(triage_at=triage_at, created_at=created_at)
+    monday = date(2025, 8, 18)
+    db_session = mock.MagicMock()
+    project = SimpleNamespace(id=1)
+
+    # the scheduler registers the decorated task, so unwrap it to call the task body directly
+    task = inspect.unwrap(
+        next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    )
+
+    with (
+        mock.patch("dispatch.case.scheduled.date") as mock_date,
+        mock.patch("dispatch.case.scheduled.datetime") as mock_datetime,
+        mock.patch(
+            "dispatch.case.scheduled.get_all_by_status", return_value=[case]
+        ),
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as mock_send,
+    ):
+        mock_date.today.return_value = monday
+        mock_datetime.utcnow.return_value = datetime(2025, 8, 18, 18, 0)
+        task(db_session=db_session, project=project)
+
+    assert mock_send.called is expected
