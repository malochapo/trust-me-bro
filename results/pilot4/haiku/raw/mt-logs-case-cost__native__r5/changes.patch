+def test_case_cost_stops_at_earliest_stop_timestamp(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of stable_at, escalated_at and closed_at.
+
+    A case marked stable and later escalated or closed must not keep billing participants
+    until the later timestamp.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.stable_at = one_hour_ago
+    case.escalated_at = now
+    case.closed_at = None
+
+    # stable_at is the earliest stop timestamp, so only the hour before stable counts
+    expected_time = int((one_hour_ago - two_hours_ago).total_seconds())
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == expected_time
+
+    # the same holds when closed_at is the latest of the stop timestamps
+    case.escalated_at = None
+    case.closed_at = now
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == expected_time
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(project):
+    """Tests that projects without an annual employee cost or business year hours use the model defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.__table__.c.annual_employee_cost.default.arg
+    default_hours = Project.__table__.c.business_year_hours.default.arg
+
+    # Both values missing
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+    # Only the annual employee cost missing
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
+
+    # Only the business year hours missing
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / default_hours)
+
+
+def test_calculate_case_response_cost_new_with_missing_project_values(case, session, project):
+    """Tests that a case in a project with missing hourly rate values still gets a cost."""
+    from dispatch.case_cost.service import calculate_case_response_cost_new
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    case.project = project
+
+    assert calculate_case_response_cost_new(case=case, db_session=session) == 0
