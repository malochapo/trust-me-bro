+def test_get_hourly_rate_uses_project_defaults_for_missing_values(case):
+    """Tests that a project without annual employee cost or business year hours uses the defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+    case.project.annual_employee_cost = 100000
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = 1000
+    assert get_hourly_rate(case.project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+
+def test_calculate_case_response_cost_without_project_hourly_inputs(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that a case still gets a response cost when its project has no hourly inputs set."""
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost,
+        calculate_response_cost,
+        get_hourly_rate,
+    )
+    from dispatch.case.enums import CostModelType
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    expected_hourly_rate = get_hourly_rate(case.project)
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    expected_cost = calculate_response_cost(
+        hourly_rate=expected_hourly_rate,
+        total_response_time_seconds=(
+            participant_activity.ended_at - participant_activity.started_at
+        ).total_seconds(),
+    )
+    assert costs[CostModelType.new] == expected_cost
+    assert costs[CostModelType.new] > 0
+
