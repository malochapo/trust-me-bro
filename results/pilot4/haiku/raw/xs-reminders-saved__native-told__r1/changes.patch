+import pytest
+from datetime import date
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        # Monday, the first Monday with missed reminders after c509d45e
+        ("2025-08-18", True),
+        ("2025-08-11", True),
+        ("2025-08-12", False),
+        ("2025-08-16", False),
+        ("2025-08-17", False),
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    from dispatch.case import scheduled
+
+    class FakeDate:
+        @staticmethod
+        def today():
+            return date.fromisoformat(day)
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
