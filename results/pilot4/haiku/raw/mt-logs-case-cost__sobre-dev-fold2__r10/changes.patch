+def test_case_cost_stops_at_first_milestone(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of stable/escalated/closed, not the latest."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    escalated_time = now - timedelta(hours=1)
+    stable_time = now - timedelta(minutes=10)  # Marked stable after it was escalated
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_time
+    case.stable_at = stable_time
+
+    # Time must stop at escalation (the first milestone), not at stable
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    expected_time = int((escalated_time - two_hours_ago).total_seconds())
+    assert time_seconds == expected_time
+
+
+def test_get_hourly_rate_uses_project_defaults_when_unset(case):
+    """Tests that a project without an annual employee cost or business year hours uses the model defaults."""
+    import math
+
+    from dispatch.case_cost.service import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+        get_hourly_rate,
+    )
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = 2080
+    assert get_hourly_rate(case.project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 2080)
+
+    case.project.annual_employee_cost = 100000
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    assert get_hourly_rate(case.project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+
+def test_calculate_case_response_cost_new_when_project_values_unset(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that the new cost model still produces a cost when the project has no cost settings."""
+    from dispatch.case_cost.service import calculate_case_response_cost_new
+    from dispatch.case.enums import CostModelType
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    cost = calculate_case_response_cost_new(case=case, db_session=session)
+    assert cost > 0
