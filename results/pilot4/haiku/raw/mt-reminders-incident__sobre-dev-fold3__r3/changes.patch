+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class FrozenDate(date):
+    """Stands in for datetime.date so today() is deterministic."""
+
+    frozen = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls.frozen
+
+
+@pytest.fixture
+def freeze_today(monkeypatch):
+    def _freeze(day: date):
+        FrozenDate.frozen = day
+        monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+    return _freeze
+
+
+def _task(name):
+    # the scheduler decorators don't return the function, so look it up by name
+    # and unwrap the timer / project context wrappers to call the function directly
+    registered = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(registered["func"])
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(freeze_today, day, expected):
+    freeze_today(day)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("task_name", ["case-close-reminder", "case-stable-reminder"])
+def test_weekly_reminders_sent_on_monday_only(monkeypatch, freeze_today, task_name):
+    # a case that has been in its status for more than a week
+    old = datetime.utcnow() - timedelta(days=14)
+    case = SimpleNamespace(id=1, triage_at=old, stable_at=old)
+    sent = []
+
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    task = _task(task_name)
+    project = SimpleNamespace(id=1)
+
+    freeze_today(date(2025, 8, 18))  # Monday
+    task(None, project)
+    assert sent == [case]
+
+    sent.clear()
+    freeze_today(date(2025, 8, 19))  # Tuesday
+    task(None, project)
+    assert sent == []
+
+
+@pytest.mark.parametrize(
+    "triage_at, created_at, expected",
+    [
+        # no triage_at, so the week is counted from creation
+        (None, datetime.utcnow() - timedelta(days=14), True),
+        (None, datetime.utcnow() - timedelta(days=2), False),
+        # triage_at is used when it is set, even if the case is older
+        (datetime.utcnow() - timedelta(days=2), datetime.utcnow() - timedelta(days=30), False),
+    ],
+)
+def test_close_reminder_counts_from_triage_at_or_created_at(
+    monkeypatch, freeze_today, triage_at, created_at, expected
+):
+    case = SimpleNamespace(id=1, triage_at=triage_at, created_at=created_at)
+    sent = []
+
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    freeze_today(date(2025, 8, 18))  # Monday
+
+    _task("case-close-reminder")(None, SimpleNamespace(id=1))
+
+    assert (sent == [case]) is expected
+
+
+def test_stable_reminder_skips_cases_without_stable_at(monkeypatch, freeze_today):
+    case = SimpleNamespace(id=1, stable_at=None)
+    sent = []
+
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    freeze_today(date(2025, 8, 18))
+
+    _task("case-stable-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == []
