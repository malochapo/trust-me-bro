+from datetime import date, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+MONDAY = date(2025, 8, 11)
+WEEK = [MONDAY + timedelta(days=offset) for offset in range(7)]
+
+
+def _frozen_today(today):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    return FrozenDate
+
+
+@pytest.mark.parametrize("today", WEEK, ids=lambda d: d.strftime("%a"))
+def test_is_reminder_day(today):
+    with mock.patch.object(scheduled, "date", _frozen_today(today)):
+        assert scheduled._is_reminder_day() is (today == MONDAY)
