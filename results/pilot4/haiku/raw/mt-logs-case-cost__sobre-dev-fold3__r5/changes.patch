+def test_case_cost_stops_at_first_cut_off_event(
+    case,
+    participant,
+    participant_role,
+    case_cost_type,
+    session,
+):
+    """Tests that role time stops at the earliest of escalated, stable, or closed.
+
+    A case can be escalated and later marked stable. The cost must stop at the
+    escalation, not extend to the later stable mark.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost_classic,
+        get_participant_role_time_seconds,
+    )
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CostModelType, CaseStatus
+
+    now = datetime.now(timezone.utc)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = three_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    # escalated 2 hours ago, then marked stable 1 hour ago
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago.replace(tzinfo=None)
+    case.stable_at = one_hour_ago.replace(tzinfo=None)
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    expected_seconds = int((two_hours_ago - three_hours_ago).total_seconds())
+    assert time_seconds == expected_seconds
+
+    cost = calculate_case_response_cost_classic(case=case, db_session=session)
+    assert cost > 0
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost,business_year_hours,expected_rate",
+    [
+        (None, 2000, 25),  # 50000 / 2000 -> default cost
+        (100000, None, 49),  # 100000 / 2080 -> default hours
+        (None, None, 25),  # 50000 / 2080 -> both defaults
+        (100000, 2000, 50),  # both set, no fallback
+    ],
+)
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(
+    project, annual_employee_cost, business_year_hours, expected_rate
+):
+    """Tests that a missing annual cost or business hours falls back to the project model defaults."""
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = annual_employee_cost
+    project.business_year_hours = business_year_hours
+
+    assert get_hourly_rate(project) == expected_rate
+
+
+def test_calculate_case_response_cost__project_missing_cost_fields(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that a case in a project with no annual cost or business hours still gets a cost."""
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost,
+        calculate_response_cost,
+        get_hourly_rate,
+    )
+    from dispatch.case.enums import CostModelType
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    expected_cost = calculate_response_cost(
+        hourly_rate=get_hourly_rate(case.project),
+        total_response_time_seconds=(
+            participant_activity.ended_at - participant_activity.started_at
+        ).total_seconds(),
+    )
+    assert costs[CostModelType.new] == expected_cost
+    assert costs[CostModelType.classic] >= 0
