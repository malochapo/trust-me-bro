+def test_case_cost_stops_at_first_status_timestamp(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of stable_at, escalated_at and closed_at.
+
+    A case that was escalated and later marked stable must stop accruing cost at escalation,
+    not at stabilization.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = three_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # Escalated two hours ago, then marked stable one hour ago
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago.replace(tzinfo=None)
+    case.stable_at = one_hour_ago.replace(tzinfo=None)
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # Cost should stop at escalation (one hour after assumption), not at stabilization (two hours)
+    assert time_seconds == int((two_hours_ago - three_hours_ago).total_seconds())
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost,business_year_hours,expected_rate",
+    [
+        (100000, 2000, 50),  # both set
+        (None, 2080, math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 2080)),  # cost missing
+        (50000, None, math.ceil(50000 / DEFAULT_BUSINESS_YEAR_HOURS)),  # hours missing
+        (
+            None,
+            None,
+            math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS),
+        ),  # both missing
+    ],
+)
+def test_get_hourly_rate(project, annual_employee_cost, business_year_hours, expected_rate):
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = annual_employee_cost
+    project.business_year_hours = business_year_hours
+
+    assert get_hourly_rate(project) == expected_rate
