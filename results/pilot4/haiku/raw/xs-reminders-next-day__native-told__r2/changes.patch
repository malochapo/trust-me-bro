+from datetime import date, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize("day_offset", range(7))
+def test_is_reminder_day_only_on_monday(day_offset):
+    monday = date(2025, 8, 11)
+    today = monday + timedelta(days=day_offset)
+
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = today
+        assert scheduled._is_reminder_day() is (day_offset == 0)
