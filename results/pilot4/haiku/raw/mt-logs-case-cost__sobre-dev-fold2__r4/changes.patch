+def test_participant_role_time_stops_at_first_status_change(
+    case, participant, participant_role
+):
+    """Tests that a participant's time stops at the earliest status change, not the latest.
+
+    A case that is escalated and later marked stable (or closed) must not keep accruing
+    participant time up to the later timestamp; the cost should stop at the first change.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=3)
+    escalated_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # The cut-off is escalated_at, the first status change, not stable_at
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+def test_participant_role_time_stops_at_first_closed_status_change(
+    case, participant, participant_role
+):
+    """Tests that a participant's time stops at closed_at when the case closed before going stable."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=3)
+    closed_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.closed
+    case.escalated_at = None
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.closed_at = closed_at.replace(tzinfo=None)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # The cut-off is closed_at, the first status change, not stable_at
+    assert time_seconds == int((closed_at - assumed_at).total_seconds())
+
+
