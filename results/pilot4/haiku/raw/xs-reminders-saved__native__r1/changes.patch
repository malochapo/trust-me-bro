+from datetime import date, timedelta
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+
+
+# 2025-08-18 is a Monday, so the seven days starting from it cover one full week
+MONDAY = date(2025, 8, 18)
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(mocker, offset):
+    today = MONDAY + timedelta(days=offset)
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = today
+
+    assert _is_reminder_day() is (offset == 0)
