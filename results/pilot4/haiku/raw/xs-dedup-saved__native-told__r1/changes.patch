diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..5014585f 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,116 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # first instance was created 10 minutes ago
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+    session.commit()
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    # a window of 30 (minutes, as set in the UI) covers an instance 10 minutes old
+    signal_filter = SignalFilterFactory(
+        name="dedupe-30-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert signal_instance_2.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_expired(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # first instance was created 10 minutes ago, outside a 5 minute window
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+    session.commit()
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-5-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=5,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert not filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert signal_instance_2.filter_action != SignalFilterAction.deduplicate
