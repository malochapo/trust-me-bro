@@ -0,0 +1,132 @@
+import inspect
+
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FixedDate(date):
+    """A date whose today() is pinned, so the weekday checks are deterministic."""
+
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+def task_body(name):
+    """Returns the undecorated body of a scheduled task so it can be called directly."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+def set_today(monkeypatch, day: date):
+    FixedDate._today = day
+    monkeypatch.setattr(scheduled, "date", FixedDate)
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    set_today(monkeypatch, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_close_reminder_sent_on_monday(monkeypatch):
+    set_today(monkeypatch, date(2025, 8, 18))
+    case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=datetime.utcnow() - timedelta(days=8)
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    task_body("case-close-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_not_sent_on_tuesday(monkeypatch):
+    set_today(monkeypatch, date(2025, 8, 19))
+    case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=datetime.utcnow() - timedelta(days=8)
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    task_body("case-close-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == []
+
+
+def test_case_stable_reminder_sent_on_monday(monkeypatch):
+    set_today(monkeypatch, date(2025, 8, 18))
+    case = SimpleNamespace(
+        status=CaseStatus.stable, stable_at=datetime.utcnow() - timedelta(days=8)
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    task_body("case-stable-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(monkeypatch):
+    set_today(monkeypatch, date(2025, 8, 18))
+    case = SimpleNamespace(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    task_body("case-close-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_not_sent_when_created_recently_and_triage_at_missing(monkeypatch):
+    set_today(monkeypatch, date(2025, 8, 18))
+    case = SimpleNamespace(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    task_body("case-close-reminder")(None, SimpleNamespace(id=1))
+
+    assert sent == []
