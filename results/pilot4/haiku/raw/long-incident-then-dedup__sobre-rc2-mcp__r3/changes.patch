+@pytest.mark.parametrize(
+    "window, expected_action",
+    [
+        (5, None),  # 5 minutes: the earlier instance is 10 minutes old, outside the window
+        (30, SignalFilterAction.deduplicate),  # 30 minutes: inside the window
+    ],
+)
+def test_filter_dedup_window_is_minutes(session, signal, project, window, expected_action):
+    """A filter's window is entered in minutes in the UI; the earlier instance is 10 minutes old."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.service import filter_dedup
+    from tests.factories import EntityTypeFactory, EntityFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    earlier = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add(earlier)
+    session.commit()
+    earlier.created_at = datetime.now(timezone.utc) - timedelta(minutes=10)
+
+    later = SignalInstanceFactory(
+        project=project, signal=signal, entities=[entity], raw=json.dumps({"id": "foo"})
+    )
+    session.add(later)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    filter_dedup(db_session=session, signal_instance=later)
+    assert later.filter_action == expected_action
+
