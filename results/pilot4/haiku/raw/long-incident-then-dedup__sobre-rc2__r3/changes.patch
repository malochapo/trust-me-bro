@@ -0,0 +1,122 @@
+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FakeDate(date):
+    """A date whose today() is pinned to a chosen day."""
+
+    pinned = None
+
+    @classmethod
+    def today(cls):
+        return cls.pinned
+
+
+def registered_task(name):
+    """Returns the original (undecorated) function registered under name."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+def pin_today(mocker, day):
+    FakeDate.pinned = day
+    mocker.patch.object(scheduled, "date", FakeDate)
+
+
+# 2025-08-11 is a Monday
+MONDAY = date(2025, 8, 11)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),  # Wednesday
+        (date(2025, 8, 14), False),  # Thursday
+        (date(2025, 8, 15), False),  # Friday
+        (date(2025, 8, 16), False),  # Saturday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, day, expected):
+    pin_today(mocker, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_stable_reminder_sends_on_monday(mocker, session, project):
+    pin_today(mocker, MONDAY)
+    stable_case = SimpleNamespace(
+        status=CaseStatus.stable, stable_at=datetime.utcnow() - timedelta(days=8)
+    )
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=[stable_case])
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    registered_task("case-stable-reminder")(session, project)
+
+    send.assert_called_once_with(stable_case, session)
+
+
+def test_case_stable_reminder_skips_other_days(mocker, session, project):
+    pin_today(mocker, date(2025, 8, 12))
+    stable_case = SimpleNamespace(
+        status=CaseStatus.stable, stable_at=datetime.utcnow() - timedelta(days=8)
+    )
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=[stable_case])
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    registered_task("case-stable-reminder")(session, project)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_sends_on_monday(mocker, session, project):
+    pin_today(mocker, MONDAY)
+    triage_case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=datetime.utcnow() - timedelta(days=8)
+    )
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=[triage_case])
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    registered_task("case-close-reminder")(session, project)
+
+    send.assert_called_once_with(triage_case, session)
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    mocker, session, project
+):
+    pin_today(mocker, MONDAY)
+    triage_case = SimpleNamespace(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=[triage_case])
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    registered_task("case-close-reminder")(session, project)
+
+    send.assert_called_once_with(triage_case, session)
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at(mocker, session, project):
+    pin_today(mocker, MONDAY)
+    triage_case = SimpleNamespace(
+        status=CaseStatus.triage,
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=[triage_case])
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    registered_task("case-close-reminder")(session, project)
+
+    send.assert_not_called()
