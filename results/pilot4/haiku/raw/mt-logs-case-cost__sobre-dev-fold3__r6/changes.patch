+def test_case_cost_cut_off_is_earliest_status_timestamp(
+    case, session, participant, participant_role
+):
+    """Tests that the cost stops at the earliest status timestamp, not the latest.
+
+    A case escalated before it was marked stable must not keep accruing cost
+    up to the stable time.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.case.enums import CaseStatus
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=4)
+    escalated_at = now - timedelta(hours=3)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at
+    case.stable_at = stable_at
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # the cut-off is the escalation (the earliest status timestamp), not the stable time
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults(case):
+    """Tests that a project missing its employee cost or business hours uses the project defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+    )
+
+    project = case.project
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+
+def test_calculate_case_response_cost_with_missing_project_rate_fields(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a case still gets a cost when its project has no employee cost or business hours."""
+    from datetime import datetime, timedelta, timezone
+    import math
+
+    from dispatch.case_cost.service import calculate_case_response_cost_classic, get_hourly_rate
+    from dispatch.case.enums import CostModelType
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0)
+    one_hour_ago = (now - timedelta(hours=1)).replace(microsecond=0)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = one_hour_ago.replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)
+    participant.participant_roles = [participant_role]
+    case.participants.append(participant)
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    cost = calculate_case_response_cost_classic(case=case, db_session=session)
+
+    # one hour of full engagement is billed at the default hourly rate
+    assert cost == math.ceil(get_hourly_rate(case.project))
