@@ -0,0 +1,98 @@
+from datetime import date
+from unittest import mock
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    from dispatch.case.scheduled import _is_reminder_day
+
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is expected
+
+
+def _triage_case(session, project, **kwargs):
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    # the factory treats status as a parameter, so set it after creating the case
+    case = CaseFactory(project=project, **kwargs)
+    case.status = CaseStatus.triage
+    session.flush()
+    return case
+
+
+def _run_close_reminder(session, project):
+    import inspect
+
+    from dispatch.case import scheduled  # noqa: F401 registers the jobs
+    from dispatch.scheduler import scheduler
+
+    # the scheduler doesn't return decorated functions, so look the job up by name
+    # and unwrap the timer and project task decorators to run the job body
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    job = inspect.unwrap(task["func"])
+    with mock.patch("dispatch.case.scheduled.send_case_close_reminder") as send:
+        with mock.patch("dispatch.case.scheduled.date") as mock_date:
+            mock_date.today.return_value = date(2025, 8, 18)  # Monday
+            job(db_session=session, project=project)
+    return send
+
+
+def test_close_reminder_counts_from_created_at_without_triage_at(session, project):
+    from datetime import datetime, timedelta
+
+    case = _triage_case(
+        session,
+        project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+
+    send = _run_close_reminder(session, project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_close_reminder_skips_recent_case_without_triage_at(session, project):
+    from datetime import datetime, timedelta
+
+    _triage_case(
+        session,
+        project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    send = _run_close_reminder(session, project)
+
+    send.assert_not_called()
+
+
+def test_close_reminder_prefers_triage_at_over_created_at(session, project):
+    from datetime import datetime, timedelta
+
+    _triage_case(
+        session,
+        project,
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+
+    send = _run_close_reminder(session, project)
+
+    send.assert_not_called()
