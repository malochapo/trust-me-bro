+import datetime
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+def _freeze_today(monkeypatch, day: datetime.date):
+    class FrozenDate(datetime.date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (datetime.date(2025, 8, 18), True),  # Monday
+        (datetime.date(2025, 8, 19), False),  # Tuesday
+        (datetime.date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _freeze_today(monkeypatch, day)
+
+    assert scheduled._is_reminder_day() is expected
