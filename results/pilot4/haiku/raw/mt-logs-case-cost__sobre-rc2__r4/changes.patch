     assert early_stable_cost == 0
     assert early_stable_time == 0
+
+
+def test_get_participant_role_time_seconds_stops_at_first_end_event(
+    case, participant, participant_role
+):
+    """Tests that cost stops at the earliest of escalated/stable/closed, not the latest.
+
+    A case escalated and later marked stable must stop accruing at the escalation.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = (now - timedelta(hours=3)).replace(tzinfo=None)
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = now - timedelta(hours=2)
+    case.stable_at = now - timedelta(hours=1)
+    case.closed_at = None
+
+    # Escalated 2 hours ago, so only 1 hour of the 3 hours since assumed counts
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == 3600
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults(case, session, participant_activity, case_cost_type):
+    """Tests that a project missing its employee cost or business hours uses the project defaults."""
+    import math
+
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost, get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+
+    expected_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == expected_rate
+
+    case.project.annual_employee_cost = 100000
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = 1000
+    assert get_hourly_rate(case.project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    # The case still gets a cost instead of raising
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    costs = calculate_case_response_cost(case=case, db_session=session)
+    assert costs[CostModelType.new] > 0
