@@ -0,0 +1,104 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _task_body(name):
+    """Returns the undecorated body of a registered scheduler task."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = today
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_stable_reminder_sends_on_monday(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.flush()
+
+    _task_body("case-stable-reminder")(db_session=session, project=case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_stable_reminder_skips_non_monday(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 19)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.flush()
+
+    _task_body("case-stable-reminder")(db_session=session, project=case.project)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_sends_on_monday(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.flush()
+
+    _task_body("case-close-reminder")(db_session=session, project=case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at(mocker, session, case):
+    # cases can reach triage without triage_at being set
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.flush()
+
+    _task_body("case-close-reminder")(db_session=session, project=case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_without_triage_at_skips_recent_case(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.flush()
+
+    _task_body("case-close-reminder")(db_session=session, project=case.project)
+
+    send.assert_not_called()
