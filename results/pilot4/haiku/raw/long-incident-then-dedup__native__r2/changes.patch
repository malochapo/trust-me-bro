+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,68 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case.enums import CaseStatus
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 15), False),  # Friday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is expected
+
+
+def _run_close_reminder(session, case, today):
+    case.status = CaseStatus.triage
+    session.commit()
+
+    # the scheduler registers the job wrapped in its decorators, so we call the raw function
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    with (
+        mock.patch("dispatch.case.scheduled.date") as mock_date,
+        mock.patch("dispatch.case.scheduled.get_all_by_status", return_value=[case]),
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as mock_send,
+    ):
+        mock_date.today.return_value = today
+        job(db_session=session, project=case.project)
+    return mock_send
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(session, case):
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+
+    mock_send = _run_close_reminder(session, case, date(2025, 8, 11))
+
+    mock_send.assert_called_once_with(case, session)
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, case):
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+
+    mock_send = _run_close_reminder(session, case, date(2025, 8, 11))
+
+    mock_send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at(session, case):
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    case.created_at = datetime.utcnow() - timedelta(days=1)
+
+    mock_send = _run_close_reminder(session, case, date(2025, 8, 11))
+
+    mock_send.assert_called_once_with(case, session)
