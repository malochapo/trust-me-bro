+import calendar
+from datetime import date
+
+import pytest
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls(cls._today.year, cls._today.month, cls._today.day)
+
+
+@pytest.mark.parametrize("day", range(7), ids=lambda d: calendar.day_name[d])
+def test_is_reminder_day(day, monkeypatch):
+    from dispatch.case import scheduled
+
+    # 2025-08-11 is a Monday, so offset from it to get each weekday of that week
+    _FakeDate._today = date(2025, 8, 11 + day)
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+    assert scheduled._is_reminder_day() is (day == calendar.MONDAY)
