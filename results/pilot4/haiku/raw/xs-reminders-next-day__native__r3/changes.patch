+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+from tests.factories import CaseFactory
+
+
+def _task_body(name):
+    """Returns the undecorated body of a scheduled task.
+
+    The task runs inside the timer and project-context decorators, which need a
+    live project context, so we unwrap them to call the body directly.
+    """
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return task["func"].__wrapped__.__wrapped__
+
+
+def _pin_today(monkeypatch, day):
+    """Makes the scheduled module see `day` as today."""
+
+    class PinnedDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", PinnedDate)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 25), True),  # Monday
+        (date(2025, 8, 17), False),  # Sunday
+        (date(2025, 8, 19), False),  # Tuesday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _pin_today(monkeypatch, day)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "day,expected_sent",
+    [
+        (date(2025, 8, 18), True),
+        (date(2025, 8, 19), False),
+    ],
+)
+def test_case_stable_reminder_only_sends_on_monday(
+    session, project, monkeypatch, day, expected_sent
+):
+    stable_case = CaseFactory(project=project, stable_at=datetime.utcnow() - timedelta(days=8))
+    stable_case.status = CaseStatus.stable
+    sent = []
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+    _pin_today(monkeypatch, day)
+
+    case_stable_reminder = _task_body("case-stable-reminder")
+    case_stable_reminder(db_session=session, project=project)
+
+    assert sent == ([stable_case.id] if expected_sent else [])
