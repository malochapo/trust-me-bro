+import pytest
+from datetime import date
+
+from dispatch.case import scheduled
+
+
+def _freeze_today(monkeypatch, day: date):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+
+@pytest.mark.parametrize(
+    "day",
+    [
+        date(2025, 8, 18),  # Monday
+        date(2025, 8, 25),  # Monday
+    ],
+)
+def test_reminder_day_is_monday(monkeypatch, day):
+    _freeze_today(monkeypatch, day)
+    assert scheduled._is_reminder_day()
+
+
+@pytest.mark.parametrize(
+    "day",
+    [
+        date(2025, 8, 19),  # Tuesday
+        date(2025, 8, 20),  # Wednesday
+        date(2025, 8, 21),  # Thursday
+        date(2025, 8, 22),  # Friday
+        date(2025, 8, 23),  # Saturday
+        date(2025, 8, 24),  # Sunday
+    ],
+)
+def test_reminder_day_is_not_other_days(monkeypatch, day):
+    _freeze_today(monkeypatch, day)
+    assert not scheduled._is_reminder_day()
