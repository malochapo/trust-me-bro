+def test_case_cost_stops_at_earliest_stable_or_escalated_time(
+    case, session, participant, participant_role
+):
+    """Tests that the cost cut-off is the earliest of the stable/escalated timestamps, not the latest."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    escalated_time = now - timedelta(minutes=90)  # Escalated first
+    stable_time = now - timedelta(hours=1)  # Marked stable later
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_time.replace(tzinfo=None)
+    case.stable_at = stable_time.replace(tzinfo=None)
+
+    # The role only counts up to the escalation, the earlier of the two timestamps
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == int((escalated_time - two_hours_ago).total_seconds())
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(project):
+    """Tests that missing project cost values fall back to the project model defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.__table__.c.annual_employee_cost.default.arg
+    default_hours = Project.__table__.c.business_year_hours.default.arg
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / default_hours)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+
+def test_update_case_response_cost_with_missing_project_cost(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a case still gets a cost when its project has no annual employee cost."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import update_case_response_cost
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CostModelType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0)
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = (now - timedelta(hours=1)).replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    results = update_case_response_cost(case=case, db_session=session)
+    assert results[CostModelType.classic] > 0
