diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..e871b970
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,32 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_returns_masked_values(session, project):
+    from dispatch.entity.service import find_entities
+
+    # session_token is a default redacted field, so its value is masked before extraction
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "session_token": "ghp_secret_value",
+            "events": [{"session_token": "ghp_other_secret", "user": "alice"}],
+            "user": "bob",
+        },
+    )
+
+    # a path pointing at the masked key directly
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+    assert find_entities(session, signal_instance, entity_types) == []
+
+    # a wildcard path matching the masked key at every depth, plus an unmasked field
+    entity_types = [
+        EntityType(name="Any Session Token", jpath="$..session_token", regular_expression=None, project=project),
+        EntityType(name="User", jpath="$..user", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert values == {"alice", "bob"}
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..fb815d4c
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,26 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"No {method} route registered for {path}")
+
+
+def _permission_classes(route: APIRoute) -> list:
+    classes = []
+    for dependency in route.dependencies:
+        if isinstance(dependency.dependency, PermissionsDependency):
+            classes.extend(dependency.dependency.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Guards against the event delete check being dropped from the route definition."""
+    route = _get_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    assert IncidentEventPermission in _permission_classes(route)
