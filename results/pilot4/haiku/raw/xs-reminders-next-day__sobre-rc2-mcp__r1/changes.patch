+from datetime import date
+from unittest import mock
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+
+
+# 2025-08-11 is a Monday; the following week covers Monday through Sunday
+WEEK = [date(2025, 8, 11 + offset) for offset in range(7)]
+
+
+@pytest.mark.parametrize("today", WEEK, ids=lambda d: d.strftime("%a"))
+def test_is_reminder_day(today):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is (today == WEEK[0])
+
+
+def test_is_reminder_day_on_monday_2025_08_18():
+    # the first Monday after the bug shipped; reminders must go out on it
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = date(2025, 8, 18)
+        assert _is_reminder_day() is True
