diff --git a/tests/case_cost/test_case_cost_service.py b/tests/case_cost/test_case_cost_service.py
index c91a0e5f..6bafe3fe 100644
--- a/tests/case_cost/test_case_cost_service.py
+++ b/tests/case_cost/test_case_cost_service.py
@@ -418,3 +418,85 @@ def test_case_cost_stops_at_stable_time(
 
     assert early_stable_cost == 0
     assert early_stable_time == 0
+
+
+def test_case_cost_cut_off_is_earliest_status_timestamp(
+    case, session, participant, participant_role
+):
+    """Tests that a case closed after it was marked stable is costed only up to stable_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # Marked stable one hour ago, closed now: cost must stop at the earlier stable_at
+    case.status = CaseStatus.closed
+    case.stable_at = one_hour_ago
+    case.closed_at = now
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    assert time_seconds == int((one_hour_ago - two_hours_ago).total_seconds())
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(project):
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    expected = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 2000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 2000)
+
+    project.annual_employee_cost = 60000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(60000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == expected
+
+
+def test_case_response_cost_classic_with_missing_project_values(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a project without annual cost or business hours still gets a case cost."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import calculate_case_response_cost_classic
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CostModelType
+
+    now = datetime.now(timezone.utc)
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = (now - timedelta(hours=2)).replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    cost_with_missing_values = calculate_case_response_cost_classic(
+        case=case, db_session=session
+    )
+
+    case.project.annual_employee_cost = 50000
+    case.project.business_year_hours = 2080
+    cost_with_defaults = calculate_case_response_cost_classic(case=case, db_session=session)
+
+    assert cost_with_missing_values > 0
+    assert cost_with_missing_values == cost_with_defaults
