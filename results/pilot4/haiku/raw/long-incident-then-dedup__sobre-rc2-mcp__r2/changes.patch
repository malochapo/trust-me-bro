--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,104 @@
+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _today(monkeypatch, day: date):
+    monkeypatch.setattr(scheduled, "date", mock.Mock(today=mock.Mock(return_value=day)))
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _today(monkeypatch, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_reminder(task_name, cases, monkeypatch, day: date):
+    """Runs the undecorated reminder task against the given cases on the given day."""
+    _today(monkeypatch, day)
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: cases)
+    send = mock.Mock()
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", send)
+
+    # the scheduler decorator doesn't return the function, so look it up by name
+    task = next(t for t in scheduler.registered_tasks if t["name"] == task_name)
+    # unwrap the project context and timer decorators
+    inner = inspect.unwrap(task["func"])
+    inner(db_session=mock.Mock(), project=SimpleNamespace(id=1))
+    return send
+
+
+def test_case_close_reminder_sends_for_long_running_triage_on_monday(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(status=CaseStatus.triage, triage_at=now - timedelta(days=8))
+
+    send = _run_reminder("case-close-reminder", [case], monkeypatch, date(2025, 8, 18))
+
+    send.assert_called_once()
+
+
+def test_case_close_reminder_skips_long_running_triage_on_tuesday(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(status=CaseStatus.triage, triage_at=now - timedelta(days=8))
+
+    send = _run_reminder("case-close-reminder", [case], monkeypatch, date(2025, 8, 19))
+
+    send.assert_not_called()
+
+
+def test_case_stable_reminder_sends_for_long_running_stable_on_monday(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(status=CaseStatus.stable, stable_at=now - timedelta(days=8))
+
+    send = _run_reminder("case-stable-reminder", [case], monkeypatch, date(2025, 8, 18))
+
+    send.assert_called_once()
+
+
+def test_case_stable_reminder_skips_long_running_stable_on_tuesday(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(status=CaseStatus.stable, stable_at=now - timedelta(days=8))
+
+    send = _run_reminder("case-stable-reminder", [case], monkeypatch, date(2025, 8, 19))
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=None, created_at=now - timedelta(days=8)
+    )
+
+    send = _run_reminder("case-close-reminder", [case], monkeypatch, date(2025, 8, 18))
+
+    send.assert_called_once()
+
+
+def test_case_close_reminder_skips_recent_case_when_triage_at_missing(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=None, created_at=now - timedelta(days=2)
+    )
+
+    send = _run_reminder("case-close-reminder", [case], monkeypatch, date(2025, 8, 18))
+
+    send.assert_not_called()
