diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..e87611f1
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,46 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_returns_masked_value(session, project):
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        raw={"user": "alice", "session_token": "secret-token-123"},
+    )
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
+
+
+def test_find_entities_masked_key_does_not_hide_other_fields(session, project):
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        raw={"user": "alice", "session_token": "secret-token-123"},
+    )
+    entity_types = [
+        EntityType(name="User", jpath="user", regular_expression=None, project=project),
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert {e.value for e in entities} == {"alice"}
+
+
+def test_find_entities_does_not_mutate_raw(session, project):
+    raw = {"user": "alice", "session_token": "secret-token-123"}
+    signal_instance = SignalInstanceFactory(project=project, raw=dict(raw))
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    find_entities(session, signal_instance, entity_types)
+
+    assert signal_instance.raw == raw
+    assert MASK not in signal_instance.raw.values()
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..8a75dbe7
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,27 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _declared_permissions(route: APIRoute) -> list:
+    return [
+        permission
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission in dependency.dependency.permissions_classes
+    ]
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Regression guard: deleting an incident event must keep its permission check."""
+    matches = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(matches) == 1
+
+    assert IncidentEventPermission in _declared_permissions(matches[0])
