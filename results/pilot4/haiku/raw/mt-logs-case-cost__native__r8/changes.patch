+def test_case_cost_stops_at_earliest_stable_or_escalated_time(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that the cost cut-off is the earliest of escalated_at/stable_at, not the latest."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    three_hours_ago = now - timedelta(hours=3)
+    escalated_time = now - timedelta(hours=2)
+    stable_time = now - timedelta(hours=1)  # Stable after escalation
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = three_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_time
+    case.stable_at = stable_time
+    case.closed_at = None
+
+    # Cost should stop at escalation, not at the later stable time
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    expected_time = int((escalated_time - three_hours_ago).total_seconds())
+    assert time_seconds == expected_time
+
+
+def test_get_hourly_rate_uses_project_defaults_when_unset(project):
+    """Tests that the hourly rate falls back to the project model defaults for missing values."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = 2000
+    assert get_hourly_rate(project) == math.ceil(100000 / 2000)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+
+def test_case_cost_with_unset_project_cost_fields(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a case on a project with no annual employee cost or business year hours still gets a cost."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost_classic,
+        get_participant_role_time_seconds,
+    )
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CostModelType, CaseStatus
+
+    now = datetime.now(timezone.utc)
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = (now - timedelta(hours=2)).replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    case.status = CaseStatus.triage
+    case.stable_at = None
+
+    assert get_participant_role_time_seconds(case=case, participant_role=participant_role) > 0
+    assert calculate_case_response_cost_classic(case=case, db_session=session) > 0
