diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..ef7cfeb2
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,50 @@
+from dispatch.entity import service as entity_service
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_returns_masked_value(session, project):
+    # the session token is a default redacted field, so its value must not become an entity
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+            "session_token": "ghp_thisIsASecret",
+            "user": "analyst@example.com",
+        }
+    )
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+
+    assert len(entities) == 0
+    assert all(entity.value != MASK for entity in entities)
+
+
+def test_find_entities_keeps_unmasked_values_next_to_masked_ones(session, project):
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+            "session_token": "ghp_thisIsASecret",
+            "user": "analyst@example.com",
+        }
+    )
+    entity_types = [
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+
+    assert [entity.value for entity in entities] == ["analyst@example.com"]
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..773b8f59
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,23 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_permission_classes(method: str, path: str) -> list:
+    """Returns the permission classes declared on the matching route."""
+    for route in router.routes:
+        if path in route.path_format and method in route.methods:
+            return [
+                permission_class
+                for dependency in route.dependencies
+                if isinstance(dependency.dependency, PermissionsDependency)
+                for permission_class in dependency.dependency.permissions_classes
+            ]
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident event must be guarded by IncidentEventPermission."""
+    permission_classes = _route_permission_classes(
+        "DELETE", "/{incident_id}/event/{event_uuid}"
+    )
+    assert IncidentEventPermission in permission_classes
