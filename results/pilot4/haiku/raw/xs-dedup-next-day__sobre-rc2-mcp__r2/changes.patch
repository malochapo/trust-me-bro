diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..6dba909d 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,71 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # filter windows are set in minutes in the UI, a 30 minute window
+    signal_filter = SignalFilterFactory(
+        name="dedupe-30-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    now = datetime.now(timezone.utc)
+
+    # 40 minutes old, outside the 30 minute window
+    signal_instance_old = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=40),
+    )
+    session.add(signal_instance_old)
+
+    # 10 minutes old, inside the 30 minute window
+    signal_instance_recent = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=10),
+    )
+    session.add(signal_instance_recent)
+    session.commit()
+
+    signal_instance_new = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_new)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance_new)
+    assert signal_instance_new.filter_action == SignalFilterAction.deduplicate
