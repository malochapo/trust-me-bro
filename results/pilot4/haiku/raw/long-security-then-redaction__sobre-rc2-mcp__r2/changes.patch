diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..3d6eff15
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,27 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"No {method} route defined for {path}")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check being dropped from the custom event delete route."""
+    route = _get_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permission_dependencies = [
+        dependency.dependency
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+    ]
+
+    assert any(
+        IncidentEventPermission in dependency.permissions_classes
+        for dependency in permission_dependencies
+    ), "delete_custom_event must declare PermissionsDependency([IncidentEventPermission])"
