+def test_get_participant_role_time_seconds_stops_at_earliest_cut_off(case, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    four_hours_ago = now - timedelta(hours=4)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = four_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None  # Still active
+
+    # The case was escalated two hours ago and marked stable one hour ago. The cost must stop
+    # at the escalation, not at the later stable time.
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago
+    case.stable_at = one_hour_ago
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    assert time_seconds == int((two_hours_ago - four_hours_ago).total_seconds())
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost,business_year_hours,expected_rate",
+    [
+        (100000, 2000, 50),
+        (None, 2000, 25),  # falls back to the project default annual employee cost
+        (100000, None, 49),  # falls back to the project default business year hours
+        (None, None, 25),  # falls back to both project defaults
+        (100000, 0, 49),  # zero business year hours is treated as missing
+    ],
+)
+def test_get_hourly_rate(annual_employee_cost, business_year_hours, expected_rate):
+    from types import SimpleNamespace
+
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project = SimpleNamespace(
+        annual_employee_cost=annual_employee_cost, business_year_hours=business_year_hours
+    )
+    assert get_hourly_rate(project) == expected_rate
