@@ -418,3 +418,84 @@ def test_case_cost_stops_at_stable_time(
 
     assert early_stable_cost == 0
     assert early_stable_time == 0
+
+
+def test_case_cost_stops_at_first_status_change(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of escalated_at and stable_at.
+
+    A case that is escalated and later marked stable must stop accruing cost when it
+    was escalated, not when it was marked stable.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    four_hours_ago = now - timedelta(hours=4)
+    three_hours_ago = now - timedelta(hours=3)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = four_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # Escalated three hours ago, then marked stable one hour ago
+    case.status = CaseStatus.stable
+    case.escalated_at = three_hours_ago
+    case.stable_at = one_hour_ago
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # Cost should stop at the escalation, so the participant is charged for one hour
+    # (assumed_at to escalated_at), not three hours (assumed_at to stable_at)
+    expected_time = int((three_hours_ago - four_hours_ago).total_seconds())
+    assert time_seconds == expected_time
+
+
+def test_get_hourly_rate_uses_project_defaults_when_unset(case):
+    from dispatch.case_cost.service import get_hourly_rate
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    # project model defaults are 50000 per year over 2080 hours, rounded up
+    assert get_hourly_rate(case.project) == 25
+
+
+def test_case_cost_calculated_when_project_values_unset(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a project without an annual employee cost or business year hours still
+    gets a case cost, using the project model's defaults."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost_classic,
+        calculate_case_response_cost_new,
+    )
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus, CostModelType
+
+    now = datetime.now(timezone.utc)
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = (now - timedelta(hours=2)).replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)  # Still active
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    case.status = CaseStatus.triage
+
+    # 2 hours at the default rate of 25 per hour
+    assert calculate_case_response_cost_classic(case=case, db_session=session) == 50
+    assert calculate_case_response_cost_new(case=case, db_session=session) >= 0
