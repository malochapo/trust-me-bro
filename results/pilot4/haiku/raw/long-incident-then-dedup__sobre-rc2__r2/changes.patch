+import inspect
+from datetime import datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FakeDate:
+    """Stands in for the `date` name in dispatch.case.scheduled so tests control today()."""
+
+    current = None
+
+    @classmethod
+    def today(cls):
+        return cls.current
+
+
+def _task(name):
+    """Returns the undecorated function the scheduler runs for the named task."""
+    (registered,) = [t for t in scheduler.registered_tasks if t["name"] == name]
+    return inspect.unwrap(registered["func"])
+
+
+@pytest.fixture
+def set_today(monkeypatch):
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    def _set(value):
+        FakeDate.current = value
+
+    return _set
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (datetime(2025, 8, 18).date(), True),  # Monday
+        (datetime(2025, 8, 17).date(), False),  # Sunday
+        (datetime(2025, 8, 19).date(), False),  # Tuesday
+        (datetime(2025, 8, 23).date(), False),  # Saturday
+    ],
+)
+def test_is_reminder_day(set_today, day, expected):
+    set_today(day)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_close_reminder_sends_on_monday(session, case, set_today, monkeypatch):
+    sent = []
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", lambda c, s: sent.append(c))
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+    set_today(datetime(2025, 8, 18).date())
+
+    _task("case-close-reminder")(session, case.project)
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_skips_other_days(session, case, set_today, monkeypatch):
+    sent = []
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", lambda c, s: sent.append(c))
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+    set_today(datetime(2025, 8, 19).date())
+
+    _task("case-close-reminder")(session, case.project)
+
+    assert sent == []
+
+
