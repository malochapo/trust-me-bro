+
+
+def test_get_participant_role_time_seconds_stops_at_first_milestone(
+    case, participant_role
+):
+    """Tests that a case's cost stops at the earliest milestone, not the latest one.
+
+    A case that is escalated and later marked stable must not bill the time between the
+    escalation and the stable status to the participant.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    assumed_at = now - timedelta(hours=3)
+    escalated_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at
+    participant_role.renounced_at = None
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at
+    case.stable_at = stable_at
+
+    # the cut-off is the escalation, so only the first hour counts
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults():
+    """Tests that unset project cost values use the project model defaults instead of failing."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+        Project,
+    )
+
+    default_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    # both values unset
+    project = Project(annual_employee_cost=None, business_year_hours=None)
+    assert get_hourly_rate(project) == default_rate
+
+    # only the annual employee cost unset
+    project = Project(annual_employee_cost=None, business_year_hours=1000)
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    # only the business year hours unset
+    project = Project(annual_employee_cost=60000, business_year_hours=None)
+    assert get_hourly_rate(project) == math.ceil(60000 / DEFAULT_BUSINESS_YEAR_HOURS)
