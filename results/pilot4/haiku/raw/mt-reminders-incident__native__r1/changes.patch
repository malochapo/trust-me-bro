+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled as case_scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _freeze_today(monkeypatch, day: date):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(case_scheduled, "date", FrozenDate)
+
+
+def _original_task(name: str):
+    # the scheduler and timing/project decorators all wrap the original function
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    func = task["func"]
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _freeze_today(monkeypatch, day)
+    assert case_scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "task_name,status,timestamp_field",
+    [
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+    ],
+)
+def test_weekly_case_reminders_only_send_on_monday(
+    monkeypatch, session, case, task_name, status, timestamp_field
+):
+    sent = []
+    monkeypatch.setattr(
+        case_scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    case.status = status
+    setattr(case, timestamp_field, datetime.utcnow() - timedelta(days=8))
+    session.commit()
+
+    task = _original_task(task_name)
+
+    _freeze_today(monkeypatch, date(2025, 8, 12))  # Tuesday
+    task(db_session=session, project=case.project)
+    assert sent == []
+
+    _freeze_today(monkeypatch, date(2025, 8, 11))  # Monday
+    task(db_session=session, project=case.project)
+    assert sent == [case]
+
+
+@pytest.mark.parametrize(
+    "triage_age_days,created_age_days,expected_sent",
+    [
+        # no triage_at: counts from created_at
+        (None, 8, True),
+        (None, 2, False),
+        # triage_at present: it wins over created_at
+        (2, 8, False),
+        (8, 2, True),
+    ],
+)
+def test_case_close_reminder_falls_back_to_created_at(
+    monkeypatch, session, case, triage_age_days, created_age_days, expected_sent
+):
+    sent = []
+    monkeypatch.setattr(
+        case_scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    case.status = CaseStatus.triage
+    case.triage_at = (
+        None if triage_age_days is None else datetime.utcnow() - timedelta(days=triage_age_days)
+    )
+    case.created_at = datetime.utcnow() - timedelta(days=created_age_days)
+    session.commit()
+
+    _freeze_today(monkeypatch, date(2025, 8, 11))  # Monday
+    _original_task("case-close-reminder")(db_session=session, project=case.project)
+
+    assert sent == ([case] if expected_sent else [])
