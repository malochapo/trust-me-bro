index 00000000..78eb9e62
--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,102 @@
+from datetime import date, datetime
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FrozenDate(date):
+    frozen_today = None
+
+    @classmethod
+    def today(cls):
+        return cls.frozen_today
+
+
+@pytest.fixture
+def frozen_today(monkeypatch):
+    def _freeze(day: date):
+        FrozenDate.frozen_today = day
+        monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+    return _freeze
+
+
+def _registered_task(name):
+    # the scheduler decorators don't return the function, so look it up as the scheduler runs it
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    # the scheduler decorators wrap the task in a project context, we want the raw function
+    while hasattr(task, "__wrapped__"):
+        task = task.__wrapped__
+    return task
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(frozen_today, day, expected):
+    frozen_today(day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_close_reminder_counts_from_created_at_when_triage_at_missing(monkeypatch, frozen_today):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    # cases created in triage never get a triage_at timestamp
+    case = SimpleNamespace(
+        status=CaseStatus.triage, triage_at=None, created_at=datetime(2025, 8, 1)
+    )
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+
+    run = _registered_task("case-close-reminder")
+
+    frozen_today(date(2025, 8, 11))
+    run(db_session=None, project=SimpleNamespace(id=1))
+    assert sent == [case]
+
+
+@pytest.mark.parametrize(
+    "task_name,status,timestamp_attr",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+def test_weekly_reminders_sent_on_monday_only(
+    monkeypatch, frozen_today, task_name, status, timestamp_attr
+):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    case = SimpleNamespace(status=status, **{timestamp_attr: datetime(2025, 8, 1)})
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+
+    run = _registered_task(task_name)
+
+    # Monday, more than a week since the case entered its status
+    frozen_today(date(2025, 8, 11))
+    run(db_session=None, project=SimpleNamespace(id=1))
+    assert sent == [case]
+
+    # Tuesday, same case, should not be reminded again
+    sent.clear()
+    frozen_today(date(2025, 8, 12))
+    run(db_session=None, project=SimpleNamespace(id=1))
+    assert sent == []
