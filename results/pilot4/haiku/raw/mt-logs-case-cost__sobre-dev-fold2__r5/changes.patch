@@ -418,3 +418,59 @@ def test_case_cost_stops_at_stable_time(
 
     assert early_stable_cost == 0
     assert early_stable_time == 0
+
+
+def test_get_participant_role_time_seconds_stops_at_first_stop_timestamp(
+    case, participant_role
+):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at.
+
+    Regression test: the cut-off used to be the latest of these timestamps, which
+    billed the escalated-to-stable window for every participant once a case was stable.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+
+    # the participant was assigned 4 hours ago, the case was escalated 3 hours ago
+    # and marked stable 1 hour ago, so the role should only be billed for 1 hour
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = now - timedelta(hours=4)
+    participant_role.renounced_at = None
+
+    case.status = CaseStatus.stable
+    case.escalated_at = now - timedelta(hours=3)
+    case.stable_at = now - timedelta(hours=1)
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == 3600
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(case):
+    """Tests that projects with NULL cost settings fall back to the project model defaults.
+
+    Regression test: projects created before these fields had defaults have NULL values,
+    which made the hourly rate calculation raise a TypeError and skip the case cost.
+    """
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    default_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == default_rate
+
+    case.project.annual_employee_cost = 100000
+    case.project.business_year_hours = None
+    assert get_hourly_rate(case.project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = 1000
+    assert get_hourly_rate(case.project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
