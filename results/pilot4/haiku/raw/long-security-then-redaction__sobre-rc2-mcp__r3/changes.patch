diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..f8c4695d
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,74 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    """A JSONPath that targets a masked key must not produce an entity, even on raw payloads
+    that still hold the sensitive value (for example, instances stored before masking)."""
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {
+        "session_token": "tok-secret-value",
+        "asset": [{"id": "arn:aws:iam::123456789012:role/Test"}],
+    }
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="$..session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
+    assert all(e.value != MASK for e in entities)
+    assert all(e.value != "tok-secret-value" for e in entities)
+
+
+def test_find_entities_masked_values_do_not_group_unrelated_instances(
+    session, signal_instance, project
+):
+    """Two instances with different tokens must not share an entity created from the mask."""
+    from dispatch.entity.service import find_entities
+
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="$..session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    signal_instance.raw = {"session_token": "tok-one"}
+    first = find_entities(session, signal_instance, entity_types)
+    signal_instance.raw = {"session_token": "tok-two"}
+    second = find_entities(session, signal_instance, entity_types)
+
+    assert first == []
+    assert second == []
+
+
+def test_find_entities_still_extracts_unmasked_fields(session, signal_instance, project):
+    """Masking must not suppress entities from fields that are not masked."""
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {
+        "session_token": "tok-secret-value",
+        "asset": [{"id": "arn:aws:iam::123456789012:role/Test"}],
+    }
+    entity_types = [
+        EntityType(
+            name="AWS IAM Role ARN",
+            jpath="asset[*].id",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert len(entities) == 1
+    assert entities[0].value == "arn:aws:iam::123456789012:role/Test"
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..1e0952dd
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,18 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+
+
+def test_delete_custom_event_requires_incident_event_permission(client):
+    """Deleting a custom incident event must be gated by IncidentEventPermission."""
+    routes = [
+        route
+        for route in client.app.routes
+        if getattr(route, "path", "").endswith("/{incident_id}/event/{event_uuid}")
+        and "DELETE" in getattr(route, "methods", set())
+    ]
+    assert len(routes) == 1, "expected exactly one DELETE custom event route"
+
+    dependencies = [dep.dependency for dep in routes[0].dependencies]
+    permission_dependencies = [d for d in dependencies if isinstance(d, PermissionsDependency)]
+    assert any(
+        IncidentEventPermission in d.permissions_classes for d in permission_dependencies
+    ), "DELETE custom event route is missing PermissionsDependency([IncidentEventPermission])"
