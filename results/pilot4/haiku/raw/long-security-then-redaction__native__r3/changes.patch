diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..d626e324
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,52 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_extracts_masked_value(session, project):
+    # the raw payload is still unmasked here, as it is in the database before the signal flow runs
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        raw={"session_token": "ghp_real_secret", "asset": [{"id": "arn:aws:iam::1:role/Test"}]},
+    )
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
+    assert MASK not in {entity.value for entity in entities}
+
+
+def test_find_entities_masked_values_do_not_group_instances(session, project):
+    entity_type = EntityType(
+        name="Session Token", jpath="credentials[*].session_token", regular_expression=None, project=project
+    )
+    first = SignalInstanceFactory(
+        project=project,
+        raw={"credentials": [{"session_token": "ghp_first"}, {"session_token": "ghp_second"}]},
+    )
+    second = SignalInstanceFactory(
+        project=project,
+        raw={"credentials": [{"session_token": "ghp_third"}]},
+    )
+
+    assert find_entities(session, first, [entity_type]) == []
+    assert find_entities(session, second, [entity_type]) == []
+
+
+def test_find_entities_still_extracts_unmasked_values_alongside_masked_ones(session, project):
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        raw={"session_token": "ghp_real_secret", "asset": [{"id": "arn:aws:iam::1:role/Test"}]},
+    )
+    entity_types = [
+        EntityType(name="AWS IAM Role ARN", jpath="asset[*].id", regular_expression=None, project=project),
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [entity.value for entity in entities] == ["arn:aws:iam::1:role/Test"]
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..7b054b8b
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,26 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permission_classes(route: APIRoute) -> list:
+    classes = []
+    for dependency in route.dependencies:
+        if isinstance(dependency.dependency, PermissionsDependency):
+            classes.extend(dependency.dependency.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check being dropped from the delete custom event route."""
+    routes = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    assert IncidentEventPermission in _permission_classes(routes[0])
