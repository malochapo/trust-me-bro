+def test_case_cost_stops_at_first_milestone_when_escalated_then_stable(
+    case, session, participant, participant_role
+):
+    """Tests that cost stops at escalated_at, not stable_at, when a case was escalated first."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=4)
+    escalated_at = now - timedelta(hours=3)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+    case.stable_at = stable_at.replace(tzinfo=None)
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(
+        case=case, participant_role=participant_role
+    )
+
+    # the cost must stop at escalation (1 hour after assumed_at), not at stable (3 hours after)
+    expected_time_seconds = int((escalated_at - assumed_at).total_seconds())
+    assert time_seconds == expected_time_seconds
+
+
+def test_get_hourly_rate_uses_project_defaults_when_unset(project):
+    """Tests that missing annual employee cost or business year hours fall back to the defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    project.annual_employee_cost = 60000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(60000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+
+def test_calculate_case_response_cost_with_unset_project_values(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that a project without cost settings still gets a response cost."""
+    import math
+    from dispatch.case_cost.service import (
+        calculate_case_response_cost,
+        calculate_response_cost,
+    )
+    from dispatch.case.enums import CostModelType
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    default_hourly_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+    expected_cost = calculate_response_cost(
+        hourly_rate=default_hourly_rate,
+        total_response_time_seconds=(
+            participant_activity.ended_at - participant_activity.started_at
+        ).total_seconds(),
+    )
+    assert costs[CostModelType.new] == expected_cost
+    assert CostModelType.classic in costs
