+def test_case_cost_stops_at_first_escalated_or_stable_time(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of escalated_at and stable_at.
+
+    A case that was escalated before it was marked stable must stop accruing cost
+    at the escalation, not jump forward to the stable time.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = three_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # Escalated 2 hours ago, then marked stable 1 hour ago
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago
+    case.stable_at = one_hour_ago
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # cost stops at the escalation: 3h - 2h = 1h of role time
+    expected_seconds = int((two_hours_ago - three_hours_ago).total_seconds())
+    assert time_seconds == expected_seconds
+
+
+@pytest.mark.parametrize(
+    "annual_employee_cost,business_year_hours,expected_rate",
+    [
+        (None, None, 25),  # both defaults: ceil(50000 / 2080)
+        (None, 1000, 50),  # cost default: ceil(50000 / 1000)
+        (60000, None, 29),  # hours default: ceil(60000 / 2080)
+        (60000, 1000, 60),  # nothing missing
+    ],
+)
+def test_get_hourly_rate_uses_project_defaults_for_unset_values(
+    annual_employee_cost, business_year_hours, expected_rate
+):
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import Project
+
+    project = Project(
+        annual_employee_cost=annual_employee_cost,
+        business_year_hours=business_year_hours,
+    )
+
+    assert get_hourly_rate(project) == expected_rate
+
+
+def test_calculate_case_response_cost_new_with_unset_project_values(case, session, project):
+    """Regression: NULL project cost fields used to raise a TypeError in the cost job."""
+    from dispatch.case_cost.service import calculate_case_response_cost_new
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    case.project = project
+
+    assert calculate_case_response_cost_new(case=case, db_session=session) == 0
