diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..f0b92403
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,38 @@
+from dispatch.entity_type.models import EntityType
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    """A value under a masked key must not become an entity, even when the payload is unmasked."""
+    from dispatch.entity.service import find_entities
+
+    # the payload has not been through the processing flow, so it is still unmasked
+    signal_instance.raw = {
+        "session_token": "ghp_realsecret",
+        "user": {"login": "alice"},
+    }
+
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+    # masking must not alter the stored payload
+    assert signal_instance.raw["session_token"] == "ghp_realsecret"
+
+    # unmasked fields are still extracted
+    entity_types = [
+        EntityType(
+            name="Login",
+            jpath="user.login",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [str(e.value) for e in entities] == ["alice"]
diff --git a/tests/incident/test_incident_view_permissions.py b/tests/incident/test_incident_view_permissions.py
new file mode 100644
index 00000000..3bfba7e0
--- /dev/null
+++ b/tests/incident/test_incident_view_permissions.py
@@ -0,0 +1,20 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+
+
+def test_delete_custom_event_route_requires_event_permission():
+    """Deleting a custom incident event must be guarded by IncidentEventPermission."""
+    from dispatch.incident.views import router
+
+    routes = [
+        route
+        for route in router.routes
+        if route.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    guards = [
+        dep.dependency.permissions_classes
+        for dep in routes[0].dependencies
+        if isinstance(dep.dependency, PermissionsDependency)
+    ]
+    assert [IncidentEventPermission] in guards
