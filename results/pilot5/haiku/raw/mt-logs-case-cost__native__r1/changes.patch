+
+def test_get_participant_role_time_seconds_stops_at_first_milestone(
+    case, participant_role
+):
+    """Tests that participant time stops at the earliest of escalated_at, stable_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = three_hours_ago
+    participant_role.renounced_at = None
+
+    # The case was escalated two hours ago and marked stable one hour ago, so the
+    # cost should stop at the escalation, not at the later stable time.
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago
+    case.stable_at = one_hour_ago
+    case.closed_at = None
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == 3600  # one hour between assumed_at and escalated_at
+
+
+def test_get_hourly_rate_defaults_when_missing(project):
+    """Tests that missing project cost values fall back to the project model defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(50000 / 2080)
+
+    project.annual_employee_cost = 120000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(120000 / 2080)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(50000 / 1000)
+
+
+def test_calculate_case_response_cost_with_missing_project_values(
+    case, session, participant_activity
+):
+    """Tests that a case still gets a cost when its project has no employee cost or hours set."""
+    import math
+    from dispatch.case_cost.service import calculate_case_response_cost, calculate_response_cost
+    from dispatch.case.enums import CostModelType
+
+    participant_activity.case = case
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    expected_cost = calculate_response_cost(
+        hourly_rate=math.ceil(50000 / 2080),
+        total_response_time_seconds=(
+            participant_activity.ended_at - participant_activity.started_at
+        ).total_seconds(),
+    )
+    assert costs[CostModelType.new] == expected_cost
