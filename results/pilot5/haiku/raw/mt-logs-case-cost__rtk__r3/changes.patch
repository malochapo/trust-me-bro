+def test_case_cost_stops_at_earliest_cutoff_timestamp(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of stable, escalated or closed, not the latest."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    escalated_at = now - timedelta(hours=1)
+    stable_at = now - timedelta(minutes=30)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # the case was escalated before it was marked as stable, so the earliest cut-off is escalated_at
+    case.status = CaseStatus.stable
+    case.stable_at = stable_at
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    expected_seconds = int((escalated_at - two_hours_ago).total_seconds())
+    assert time_seconds == expected_seconds
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(case, session, case_cost_type):
+    """Tests that projects without an annual employee cost or business year hours use the model defaults."""
+    import math
+
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost, get_hourly_rate
+    from dispatch.project.models import Project
+
+    default_cost = Project.__table__.c.annual_employee_cost.default.arg
+    default_hours = Project.__table__.c.business_year_hours.default.arg
+
+    project = case.project
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(default_cost / default_hours)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / default_hours)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(default_cost / 1000)
+
+    # the case still gets a cost instead of raising a TypeError
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = project
+    costs = calculate_case_response_cost(case=case, db_session=session)
+    assert CostModelType.new in costs
+    assert CostModelType.classic in costs
