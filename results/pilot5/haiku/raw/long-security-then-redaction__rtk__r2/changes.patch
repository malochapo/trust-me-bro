diff --git a/tests/entity/test_entity_service.py b/tests/entity/test_entity_service.py
index 54251a28..ead11d2b 100644
--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,38 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_yields_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK
+
+    # session_token is a default redacted field, so its value must not become an entity
+    signal_instance.raw = {
+        "session_token": "ghp_realtoken123",
+        "user": {"name": "alice", "password": "hunter2"},
+    }
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Password",
+            jpath="user.password",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User name",
+            jpath="user.name",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {str(e.value) for e in entities}
+    assert values == {"alice"}
+    assert MASK not in values
