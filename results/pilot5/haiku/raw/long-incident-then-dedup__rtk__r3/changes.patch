@@ -0,0 +1,93 @@
+import datetime
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (datetime.date(2025, 8, 11), True),  # Monday
+        (datetime.date(2025, 8, 12), False),
+        (datetime.date(2025, 8, 13), False),
+        (datetime.date(2025, 8, 14), False),
+        (datetime.date(2025, 8, 15), False),
+        (datetime.date(2025, 8, 16), False),
+        (datetime.date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    from dispatch.case import scheduled
+
+    class FakeDate(datetime.date):
+        @classmethod
+        def today(cls):
+            return today
+
+    mocker.patch.object(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_close_reminder(mocker, cases):
+    import inspect
+    from types import SimpleNamespace
+
+    from dispatch.case import scheduled
+    from dispatch.scheduler import scheduler
+
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=cases)
+    mocker.patch.object(scheduled, "_is_reminder_day", return_value=True)
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    # the scheduler decorator doesn't return the task, so look it up by name and call the
+    # undecorated function so it runs against the cases above, not the org/db context
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(
+        db_session=None, project=SimpleNamespace(id=1)
+    )
+    return send
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(mocker):
+    from types import SimpleNamespace
+
+    now = datetime.datetime.utcnow()
+    case = SimpleNamespace(
+        name="case-1",
+        triage_at=None,
+        created_at=now - datetime.timedelta(days=8),
+    )
+
+    send = _run_close_reminder(mocker, [case])
+
+    send.assert_called_once_with(case, None)
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(mocker):
+    from types import SimpleNamespace
+
+    now = datetime.datetime.utcnow()
+    case = SimpleNamespace(
+        name="case-2",
+        triage_at=None,
+        created_at=now - datetime.timedelta(days=2),
+    )
+
+    send = _run_close_reminder(mocker, [case])
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at(mocker):
+    from types import SimpleNamespace
+
+    now = datetime.datetime.utcnow()
+    case = SimpleNamespace(
+        name="case-3",
+        triage_at=now - datetime.timedelta(days=8),
+        created_at=now - datetime.timedelta(days=30),
+    )
+
+    send = _run_close_reminder(mocker, [case])
+
+    send.assert_called_once_with(case, None)
