+def test_get_hourly_rate_uses_project_defaults_for_missing_values():
+    """Tests that projects without cost settings fall back to the project model defaults."""
+    import math
+    from types import SimpleNamespace
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    default_rate = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    no_cost = SimpleNamespace(annual_employee_cost=None, business_year_hours=2080)
+    no_hours = SimpleNamespace(annual_employee_cost=50000, business_year_hours=None)
+    neither = SimpleNamespace(annual_employee_cost=None, business_year_hours=None)
+
+    assert get_hourly_rate(no_cost) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 2080)
+    assert get_hourly_rate(no_hours) == math.ceil(50000 / DEFAULT_BUSINESS_YEAR_HOURS)
+    assert get_hourly_rate(neither) == default_rate
+
+
+def test_calculate_case_response_cost_classic_project_without_cost_settings(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that a case in a project with no cost settings still gets a classic cost."""
+    import math
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost_classic
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = now - timedelta(hours=1)
+    participant_role.renounced_at = now
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case_cost_type.model_type = CostModelType.classic
+    case_cost_type.project = case.project
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    cost = calculate_case_response_cost_classic(case=case, db_session=session)
+    assert cost == math.ceil(50000 / 2080)
+
+
