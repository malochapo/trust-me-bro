+def test_participant_role_time_stops_at_earliest_cutoff(case, participant_role):
+    """Tests that cost stops at the earliest of escalated_at, stable_at and closed_at.
+
+    A case escalated before it was marked stable must not keep billing participants
+    for the time between escalation and the stable transition.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    assumed_at = now - timedelta(hours=3)
+    escalated_at = now - timedelta(hours=2)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at
+    participant_role.renounced_at = None
+
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at
+    case.stable_at = stable_at
+    case.closed_at = None
+
+    # Only the window from assumed_at to escalated_at (1 hour) should count
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == 3600
+
+
