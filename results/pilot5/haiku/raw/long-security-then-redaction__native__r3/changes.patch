diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..a2ed82cd
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,50 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def _find(session, project, raw, jpath):
+    signal_instance = SignalInstanceFactory(raw=raw)
+    entity_type = EntityType(
+        name="Test Entity Type",
+        jpath=jpath,
+        regular_expression=None,
+        project=project,
+    )
+    return find_entities(session, signal_instance, [entity_type])
+
+
+def test_masked_value_never_becomes_entity(session, project):
+    raw = {
+        "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+        "session_token": "ghp_secret_session_token",
+    }
+
+    entities = _find(session, project, raw, "session_token")
+    assert entities == []
+
+    entities = _find(session, project, raw, "$..*")
+    assert all(entity.value != MASK for entity in entities)
+    assert all("ghp_secret_session_token" != entity.value for entity in entities)
+
+
+def test_value_under_masked_nested_key_never_becomes_entity(session, project):
+    raw = {
+        "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+        "authorization": {"token": "Bearer abc123"},
+    }
+
+    entities = _find(session, project, raw, "authorization.token")
+    assert entities == []
+
+
+def test_unmasked_value_still_becomes_entity(session, project):
+    raw = {
+        "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+        "session_token": "ghp_secret_session_token",
+        "user": "analyst@example.com",
+    }
+
+    entities = _find(session, project, raw, "user")
+    assert [entity.value for entity in entities] == ["analyst@example.com"]
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..ee4006f6
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,20 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_dependency_classes(path: str, method: str) -> list:
+    """Returns the permission classes declared on the matching incident route."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            for dependency in route.dependencies:
+                if isinstance(dependency.dependency, PermissionsDependency):
+                    return dependency.dependency.permissions_classes
+    return []
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check being dropped from the custom event delete route."""
+    permissions = _route_dependency_classes("/{incident_id}/event/{event_uuid}", "DELETE")
+    assert IncidentEventPermission in permissions
