+def test_snooze_checks_later_filters_after_expired_one(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # snooze the entity, as a per-user snooze does
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    # the expired snooze comes first so that a valid snooze after it must still be applied
+    expired_filter = SignalFilterFactory(
+        name="expired-snooze",
+        description="expired last week",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="valid-snooze",
+        description="valid until next month",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+    signal.filters.append(expired_filter)
+    signal.filters.append(valid_filter)
+    session.commit()
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "new"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
