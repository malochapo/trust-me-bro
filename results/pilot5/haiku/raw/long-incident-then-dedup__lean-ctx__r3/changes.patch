@@ -0,0 +1,60 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = today
+        assert scheduled._is_reminder_day() is expected
+
+
+def _case_close_reminder_body():
+    """Returns the undecorated case close reminder job."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize(
+    "triage_age_days,created_age_days,expected_sent",
+    [
+        (None, 8, True),  # no triage_at: counts from creation, over a week
+        (None, 2, False),  # no triage_at: counts from creation, under a week
+        (8, 30, True),  # triage_at is used when present
+        (2, 30, False),
+    ],
+)
+def test_case_close_reminder_counts_from_triage_or_created(
+    session, case, triage_age_days, created_age_days, expected_sent
+):
+    now = datetime.utcnow()
+    case.status = CaseStatus.triage
+    case.triage_at = None if triage_age_days is None else now - timedelta(days=triage_age_days)
+    case.created_at = now - timedelta(days=created_age_days)
+    session.commit()
+
+    with (
+        mock.patch.object(scheduled, "_is_reminder_day", return_value=True),
+        mock.patch.object(scheduled, "send_case_close_reminder") as mock_send,
+    ):
+        _case_close_reminder_body()(db_session=session, project=case.project)
+
+    assert mock_send.called is expected_sent
