+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+TUESDAY = date(2025, 8, 19)
+
+
+def _freeze_today(mocker, frozen: date):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return cls(frozen.year, frozen.month, frozen.day)
+
+    mocker.patch("dispatch.case.scheduled.date", FrozenDate)
+
+
+def test_is_reminder_day_only_on_monday(mocker):
+    _freeze_today(mocker, MONDAY)
+    assert scheduled._is_reminder_day() is True
+
+    _freeze_today(mocker, TUESDAY)
+    assert scheduled._is_reminder_day() is False
+
+
+def _task_body(name: str):
+    # the scheduler decorator returns None, so look the task up by its registered name
+    # and unwrap the timer/project-context decorators to call the body directly
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize(
+    "task_name,status,timestamp_field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+def test_long_running_case_reminders_sent_on_monday_only(
+    session, case, mocker, task_name, status, timestamp_field
+):
+    task = _task_body(task_name)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = status
+    setattr(case, timestamp_field, datetime.utcnow() - timedelta(days=14))
+    session.commit()
+
+    _freeze_today(mocker, TUESDAY)
+    task(db_session=session, project=case.project)
+    send.assert_not_called()
+
+    _freeze_today(mocker, MONDAY)
+    task(db_session=session, project=case.project)
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(session, case, mocker):
+    task = _task_body("case-close-reminder")
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=14)
+    session.commit()
+
+    _freeze_today(mocker, MONDAY)
+    task(db_session=session, project=case.project)
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, case, mocker):
+    task = _task_body("case-close-reminder")
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+
+    _freeze_today(mocker, MONDAY)
+    task(db_session=session, project=case.project)
+    send.assert_not_called()
