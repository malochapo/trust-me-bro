+def test_get_hourly_rate_falls_back_to_project_defaults(
+    project, annual_employee_cost, business_year_hours
+):
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+    )
+
+    project.annual_employee_cost = annual_employee_cost
+    project.business_year_hours = business_year_hours
+
+    expected_cost = annual_employee_cost or DEFAULT_ANNUAL_EMPLOYEE_COST
+    expected_hours = business_year_hours or DEFAULT_BUSINESS_YEAR_HOURS
+    assert get_hourly_rate(project) == math.ceil(expected_cost / expected_hours)
+
