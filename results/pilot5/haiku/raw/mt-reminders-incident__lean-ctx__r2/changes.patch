+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = today
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _close_reminder_cases_run(mocker, cases):
+    """Runs the undecorated case close reminder job over the given cases."""
+    mocker.patch.object(scheduled, "_is_reminder_day", return_value=True)
+    mocker.patch.object(scheduled, "get_all_by_status", return_value=cases)
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+
+    # the decorators return nothing, so the job is looked up by its registered name
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    job = inspect.unwrap(task["func"])
+    job(db_session=mocker.MagicMock(), project=SimpleNamespace(id=1))
+    return send
+
+
+def test_case_close_reminder_falls_back_to_created_at(mocker):
+    now = datetime.utcnow()
+    case = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=8))
+
+    send = _close_reminder_cases_run(mocker, [case])
+
+    send.assert_called_once()
+    assert send.call_args.args[0] is case
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(mocker):
+    now = datetime.utcnow()
+    case = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=2))
+
+    send = _close_reminder_cases_run(mocker, [case])
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at(mocker):
+    now = datetime.utcnow()
+    case = SimpleNamespace(
+        triage_at=now - timedelta(days=2), created_at=now - timedelta(days=30)
+    )
+
+    send = _close_reminder_cases_run(mocker, [case])
+
+    send.assert_not_called()
