+@pytest.mark.parametrize(
+    "minutes_ago, expected_dedup",
+    [
+        (10, True),  # inside a 30 minute window
+        (45, False),  # outside a 30 minute window
+    ],
+)
+def test_filter_deduplicate_window_is_in_minutes(
+    session, signal, project, minutes_ago, expected_dedup
+):
+    """A deduplication filter's window is entered in minutes, as the UI labels it."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        CaseFactory,
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    case = CaseFactory(project=project)
+    session.add(case)
+    session.commit()
+
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        case=case,
+        raw=json.dumps({"id": "earlier"}),
+    )
+    session.add(earlier_instance)
+    session.commit()
+    earlier_instance.created_at = datetime.now(timezone.utc) - timedelta(minutes=minutes_ago)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "new"}),
+    )
+    session.add(new_instance)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=new_instance)
+
+    assert (new_instance.filter_action == SignalFilterAction.deduplicate) is expected_dedup
+    if expected_dedup:
+        assert new_instance.case_id == case.id
+
+
+@pytest.mark.parametrize("expired_first", [True, False])
+def test_filter_actions_snooze_expired_filter_does_not_skip_active(
+    session, entity, signal, project, expired_first
+):
+    """An expired snooze filter must not stop the check of later active snooze filters."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+    signal.entity_types.append(entity_type)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    expired = dict(
+        name="snooze-expired",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+    )
+    active = dict(
+        name="snooze-active",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+    )
+
+    # the signal's filters are returned in creation order, so create them in the order under test
+    specs = [expired, active] if expired_first else [active, expired]
+    signal.filters = [
+        SignalFilterFactory(
+            description="test",
+            expression=expression,
+            action="snooze",
+            project=project,
+            **spec,
+        )
+        for spec in specs
+    ]
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=signal_instance)
+
+    assert signal_instance.filter_action == SignalFilterAction.snooze
