@@ -0,0 +1,88 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    _FakeDate._today = today
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _close_reminder_job():
+    # scheduler.add() doesn't return the function, so look it up by its registered name and
+    # unwrap the timer and project task decorators to get the raw job with an explicit session
+    [task] = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    return task["func"].__wrapped__.__wrapped__
+
+
+def _triage_case(session, project=None, triage_at=None, created_at=None):
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    # the factory's status param doesn't stick, so set the status after creating the case
+    kwargs = {"triage_at": triage_at, "created_at": created_at}
+    if project:
+        kwargs["project"] = project
+    case = CaseFactory(**kwargs)
+    case.status = CaseStatus.triage
+    session.commit()
+    return case
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at(session, monkeypatch):
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    send = mock.Mock()
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", send)
+
+    old_case = _triage_case(
+        session, triage_at=None, created_at=datetime.utcnow() - timedelta(days=8)
+    )
+    _triage_case(
+        session,
+        project=old_case.project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    _close_reminder_job()(db_session=session, project=old_case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == old_case.id
+
+
+def test_case_close_reminder_prefers_triage_at_when_set(session, monkeypatch):
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    send = mock.Mock()
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", send)
+
+    case = _triage_case(
+        session,
+        triage_at=datetime.utcnow() - timedelta(days=1),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+
+    _close_reminder_job()(db_session=session, project=case.project)
+
+    send.assert_not_called()
