index 00000000..2c86a453
--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,89 @@
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.fixture
+def sent_close_reminders(monkeypatch):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    return sent
+
+
+def make_triaging_case(session, *, triage_at, created_at):
+    # CaseFactory's Params override any status passed in, so we set the fields after creating
+    case = CaseFactory()
+    case.status = CaseStatus.triage
+    case.triage_at = triage_at
+    case.created_at = created_at
+    session.commit()
+    return case
+
+
+def run_case_close_reminder(session, project):
+    # the decorator doesn't return the job, so we look it up in the scheduler registry and
+    # call the undecorated function so the test runs in the current session
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    task["func"].__wrapped__.__wrapped__(db_session=session, project=project)
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, sent_close_reminders
+):
+    case = make_triaging_case(
+        session, triage_at=None, created_at=datetime.utcnow() - timedelta(days=8)
+    )
+
+    run_case_close_reminder(session, case.project)
+
+    assert sent_close_reminders == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, sent_close_reminders):
+    case = make_triaging_case(
+        session, triage_at=None, created_at=datetime.utcnow() - timedelta(days=2)
+    )
+
+    run_case_close_reminder(session, case.project)
+
+    assert sent_close_reminders == []
+
+
+def test_case_close_reminder_counts_from_triage_at_when_set(session, sent_close_reminders):
+    case = make_triaging_case(
+        session,
+        triage_at=datetime.utcnow() - timedelta(days=8),
+        created_at=datetime.utcnow() - timedelta(days=1),
+    )
+
+    run_case_close_reminder(session, case.project)
+
+    assert sent_close_reminders == [case]
