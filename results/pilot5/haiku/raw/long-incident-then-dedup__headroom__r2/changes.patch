+@pytest.mark.parametrize("minutes_ago, expected", [(10, True), (40, False)])
+def test_filter_actions_deduplicate_window_is_minutes(
+    session, signal, project, minutes_ago, expected
+):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_dedup
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the window is set in minutes in the UI, so an instance this many minutes old is in or out
+    existing_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(existing_instance)
+    session.commit()
+    existing_instance.created_at = datetime.now(timezone.utc) - timedelta(minutes=minutes_ago)
+    session.commit()
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    filter_dedup(db_session=session, signal_instance=signal_instance)
+
+    assert (signal_instance.filter_action == SignalFilterAction.deduplicate) is expected
+
+
+def test_filter_actions_snooze_expired_before_valid(session, entity, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # the expired snooze comes first, so it must not stop the valid snooze after it from applying
+    expired_filter = SignalFilterFactory(
+        name="snooze-expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="snooze-valid",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+
+    signal.filters = [expired_filter, valid_filter]
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
