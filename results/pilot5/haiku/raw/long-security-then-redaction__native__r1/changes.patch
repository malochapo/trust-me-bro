diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..e063c2e4
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,40 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    signal_instance.raw = {
+        "id": "abc",
+        "session_token": "super-secret-token",
+        "nested": [{"Password": "hunter2"}, {"value": "visible"}],
+    }
+
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Password",
+            jpath="nested[*].Password",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Visible",
+            jpath="nested[*].value",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {str(e.value) for e in entities}
+
+    assert values == {"visible"}
+    assert MASK not in values
+    assert "super-secret-token" not in values
+    assert "hunter2" not in values
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..abc84b3e
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,31 @@
+from fastapi.params import Depends
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(endpoint_name: str) -> APIRoute:
+    matches = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute) and route.endpoint.__name__ == endpoint_name
+    ]
+    assert len(matches) == 1, f"expected exactly one route for {endpoint_name}"
+    return matches[0]
+
+
+def _permission_classes(route: APIRoute) -> list:
+    classes = []
+    for dependency in route.dependencies:
+        if isinstance(dependency, Depends) and isinstance(
+            dependency.dependency, PermissionsDependency
+        ):
+            classes.extend(dependency.dependency.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Regression test: delete_custom_event must keep its IncidentEventPermission check."""
+    route = _get_route("delete_custom_event")
+    assert IncidentEventPermission in _permission_classes(route)
