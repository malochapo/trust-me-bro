@@ -0,0 +1,31 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+
+
+def test_masked_values_never_become_entities(session, signal_instance, project):
+    """A secret that was masked must not be extracted, even when its JSONPath matches.
+
+    Regression guard: the masked value "[REDACTED]" was turned into an entity, so unrelated
+    instances shared the same entity and were grouped into one case.
+    """
+    signal_instance.raw = {"session_token": "super-secret", "user": "alice"}
+
+    # "*" matches every field, including the masked session_token
+    entity_types = [
+        EntityType(name="Field", jpath="*", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [entity.value for entity in entities] == ["alice"]
+
+
+def test_jsonpath_to_masked_field_yields_no_entity(session, signal_instance, project):
+    """Entities are not created from a JSONPath that points at a masked key."""
+    signal_instance.raw = {"session_token": "super-secret", "user": "alice"}
+
+    entity_types = [
+        EntityType(
+            name="Session token", jpath="session_token", regular_expression=None, project=project
+        ),
+    ]
+    assert find_entities(session, signal_instance, entity_types) == []
