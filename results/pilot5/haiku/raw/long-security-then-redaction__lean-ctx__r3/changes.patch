@@ -0,0 +1,34 @@
+import pytest
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_permissions(path: str, method: str) -> list:
+    """Returns the permission classes declared on the matching route (empty if none)."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return [
+                permission
+                for dependency in route.dependant.dependencies
+                if isinstance(dependency.call, PermissionsDependency)
+                for permission in dependency.call.permissions_classes
+            ]
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+@pytest.mark.parametrize(
+    "method,path",
+    [
+        ("POST", "/{incident_id}/event"),
+        ("PATCH", "/{incident_id}/event"),
+        ("DELETE", "/{incident_id}/event/{event_uuid}"),
+    ],
+)
+def test_custom_event_routes_require_event_permission(method, path):
+    """Custom event write routes must keep their IncidentEventPermission check.
+
+    Regression guard: the DELETE route silently lost its check in 28c21e1e.
+    """
+    assert IncidentEventPermission in _route_permissions(path, method)
