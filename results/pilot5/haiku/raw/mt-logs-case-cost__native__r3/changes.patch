+def test_get_participant_role_time_seconds_stops_at_first_cutoff_event(
+    case, participant, participant_role
+):
+    """Tests that a case escalated and later marked stable stops accruing cost at escalation.
+
+    The cost cut-off is the earliest of the stable, escalated and closed timestamps. Using the
+    latest one would retroactively reprice cases that were already escalated when they became
+    stable.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    three_hours_ago = now - timedelta(hours=3)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = three_hours_ago
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    case.status = CaseStatus.stable
+    case.escalated_at = two_hours_ago
+    case.stable_at = one_hour_ago
+
+    # Only the first hour (assumed -> escalated) should count
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+    assert time_seconds == 3600
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(project):
+    """Tests that projects with NULL cost settings fall back to the project model defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import DEFAULT_ANNUAL_EMPLOYEE_COST, DEFAULT_BUSINESS_YEAR_HOURS
+
+    expected = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == expected
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+
+def test_calculate_case_response_cost_with_null_project_cost_settings(
+    session, case, participant, participant_role, case_cost_type
+):
+    """Tests that a project with NULL cost settings still gets a response cost for all models."""
+    from datetime import datetime, timedelta, timezone
+    import math
+
+    from dispatch.case.enums import CaseStatus, CostModelType
+    from dispatch.case_cost.service import calculate_case_response_cost
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = now - timedelta(hours=1)
+    participant_role.renounced_at = now  # Exactly one hour, so the rounding is deterministic
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+    case.status = CaseStatus.triage
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    results = calculate_case_response_cost(case=case, db_session=session)
+
+    # One hour at full engagement, at the default hourly rate
+    assert results[CostModelType.classic] == math.ceil(50000 / 2080)
