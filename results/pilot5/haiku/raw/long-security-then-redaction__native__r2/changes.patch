diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..b0a03aca
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,35 @@
+from dispatch.entity_type.models import EntityType
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    # the session token is stored unmasked, as it is before processing runs
+    signal_instance.raw = {
+        "id": "not-a-real-id",
+        "session_token": "abc123",
+        "asset": [{"id": "arn:aws:iam::123456789012:role/Test"}],
+    }
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+    # an entity type that targets a field outside the masked keys still works
+    entity_types = [
+        EntityType(
+            name="AWS IAM Role ARN",
+            jpath="asset[0].id",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [e.value for e in entities] == ["arn:aws:iam::123456789012:role/Test"]
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..46d41a76
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def get_route_permissions(path: str, method: str) -> list:
+    """Returns the permission classes declared on the given incident route."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return [
+                permission_class
+                for dependency in route.dependencies
+                if isinstance(dependency.dependency, PermissionsDependency)
+                for permission_class in dependency.dependency.permissions_classes
+            ]
+    raise AssertionError(f"Route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission."""
+    permissions = get_route_permissions("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    assert IncidentEventPermission in permissions
