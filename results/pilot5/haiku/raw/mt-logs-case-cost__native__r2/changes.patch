+def test_case_cost_stops_at_first_milestone_when_escalated_then_stable(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that cost stops at the earliest milestone (escalation), not at a later stable_at.
+
+    Otherwise the cost accrued between escalation and stable is booked retroactively
+    the moment the case is marked stable.
+    """
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=5)
+    escalated_at = now - timedelta(hours=3)
+    stable_at = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+    case_cost_type.project = case.project
+
+    # Escalated two hours after the participant joined, then marked stable an hour later
+    case.status = CaseStatus.stable
+    case.escalated_at = escalated_at.replace(tzinfo=None)
+    case.stable_at = stable_at.replace(tzinfo=None)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # 2 hours between joining and escalation, not 4 hours until stable
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate_uses_project_defaults_for_missing_values(project):
+    """Tests that missing annual employee cost or business year hours fall back to the defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+    )
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(
+        DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS
+    )
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+
+def test_calculate_case_response_cost_project_without_cost_settings(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that a project with no cost settings still gets a cost."""
+    from dispatch.case_cost.service import calculate_case_response_cost
+    from dispatch.case.enums import CostModelType
+
+    participant_activity.case = case
+    case_cost_type.model_type = CostModelType.new
+    case_cost_type.project = case.project
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    assert costs[CostModelType.new] > 0
