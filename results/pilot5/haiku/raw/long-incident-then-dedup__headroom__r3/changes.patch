@@ -0,0 +1,69 @@
+import inspect
+
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is expected
+
+
+def run_case_close_reminder(cases):
+    """Runs the case close reminder job for the given cases, with the reminder day forced on."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    with (
+        mock.patch("dispatch.case.scheduled.get_all_by_status", return_value=cases),
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as send,
+        mock.patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+    ):
+        job(db_session=mock.MagicMock(), project=SimpleNamespace(id=1))
+    return send
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at():
+    now = datetime.utcnow()
+    case = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=8))
+
+    send = run_case_close_reminder([case])
+
+    send.assert_called_once()
+    assert send.call_args.args[0] is case
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at():
+    now = datetime.utcnow()
+    case = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=2))
+
+    send = run_case_close_reminder([case])
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at():
+    now = datetime.utcnow()
+    case = SimpleNamespace(triage_at=now - timedelta(days=2), created_at=now - timedelta(days=30))
+
+    send = run_case_close_reminder([case])
+
+    send.assert_not_called()
