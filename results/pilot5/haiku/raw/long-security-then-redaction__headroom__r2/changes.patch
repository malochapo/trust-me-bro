diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..0d067dc2
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,21 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_find_entities_never_creates_entity_from_masked_value(session, signal_instance, project):
+    """A masked value is not a real entity, so it must not be used to group instances."""
+    signal_instance.raw = redact_raw({"session_token": "ghp_secret_value"})
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert MASK not in {entity.value for entity in entities}
+    assert entities == []
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..9d59b429
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,20 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the custom event delete route losing its permission check."""
+    route = next(
+        r for r in router.routes if isinstance(r, APIRoute) and r.name == "delete_custom_event"
+    )
+
+    permission_dependencies = [
+        d.dependency for d in route.dependencies if isinstance(d.dependency, PermissionsDependency)
+    ]
+
+    assert any(
+        IncidentEventPermission in dependency.permissions_classes
+        for dependency in permission_dependencies
+    )
