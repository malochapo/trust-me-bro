+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def freeze_today(monkeypatch, day: date):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+
+# 2025-08-18 is a Monday, so this covers one full week
+WEEK = [date(2025, 8, 18) + timedelta(days=i) for i in range(7)]
+
+
+@pytest.mark.parametrize("day", WEEK, ids=lambda d: d.strftime("%a"))
+def test_is_reminder_day_only_on_mondays(monkeypatch, day):
+    freeze_today(monkeypatch, day)
+
+    assert scheduled._is_reminder_day() is (day.weekday() == 0)
+
+
+@pytest.mark.parametrize(
+    "task_name,status,timestamp_field",
+    [
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+    ],
+)
+def test_long_running_case_reminder_only_sent_on_monday(
+    session, case, mocker, monkeypatch, task_name, status, timestamp_field
+):
+    case.status = status
+    setattr(case, timestamp_field, datetime.utcnow() - timedelta(days=8))
+    session.flush()
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+    task = next(t for t in scheduler.registered_tasks if t["name"] == task_name)
+    # unwrap the timer and project-context decorators to run the task body
+    run = task["func"].__wrapped__.__wrapped__
+
+    freeze_today(monkeypatch, date(2025, 8, 18))  # Monday
+    run(db_session=session, project=case.project)
+    send.assert_called_once_with(case, session)
+
+    send.reset_mock()
+    freeze_today(monkeypatch, date(2025, 8, 19))  # Tuesday
+    run(db_session=session, project=case.project)
+    send.assert_not_called()
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, case, mocker, monkeypatch
+):
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.flush()
+    send = mocker.patch.object(scheduled, "send_case_close_reminder")
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    run = task["func"].__wrapped__.__wrapped__
+
+    freeze_today(monkeypatch, date(2025, 8, 18))  # Monday
+    run(db_session=session, project=case.project)
+
+    send.assert_called_once_with(case, session)
