+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+from tests.factories import CaseFactory
+
+
+def _patch_today(mocker, day: date):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    mocker.patch("dispatch.case.scheduled.date", FakeDate)
+
+
+def _run(name, session, project):
+    # scheduler.add returns None, so look the task up by name and unwrap
+    # the project context and timing decorators to call it directly
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    task.__wrapped__.__wrapped__(db_session=session, project=project)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, day, expected):
+    _patch_today(mocker, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_stable_reminder_sends_on_monday(mocker, session):
+    _patch_today(mocker, date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(stable_at=datetime.utcnow() - timedelta(days=8))
+    case.status = CaseStatus.stable
+
+    _run("case-stable-reminder", session, case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_stable_reminder_does_not_send_on_other_days(mocker, session):
+    _patch_today(mocker, date(2025, 8, 19))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(stable_at=datetime.utcnow() - timedelta(days=8))
+    case.status = CaseStatus.stable
+
+    _run("case-stable-reminder", session, case.project)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_sends_on_monday(mocker, session):
+    _patch_today(mocker, date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(triage_at=datetime.utcnow() - timedelta(days=8))
+    case.status = CaseStatus.triage
+
+    _run("case-close-reminder", session, case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_does_not_send_on_other_days(mocker, session):
+    _patch_today(mocker, date(2025, 8, 19))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(triage_at=datetime.utcnow() - timedelta(days=8))
+    case.status = CaseStatus.triage
+
+    _run("case-close-reminder", session, case.project)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(mocker, session):
+    _patch_today(mocker, date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(triage_at=None, created_at=datetime.utcnow() - timedelta(days=8))
+    case.status = CaseStatus.triage
+
+    _run("case-close-reminder", session, case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(mocker, session):
+    _patch_today(mocker, date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    case = CaseFactory(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+    case.status = CaseStatus.triage
+
+    _run("case-close-reminder", session, case.project)
+
+    send.assert_not_called()
