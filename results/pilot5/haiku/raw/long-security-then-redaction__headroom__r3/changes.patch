diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..dc1593ee
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,26 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Ensures deleting a custom incident event is guarded by IncidentEventPermission."""
+    route = next(
+        r
+        for r in router.routes
+        if isinstance(r, APIRoute)
+        and r.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in r.methods
+    )
+
+    permission_dependencies = [
+        dependency.dependency
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+    ]
+
+    assert any(
+        IncidentEventPermission in dependency.permissions_classes
+        for dependency in permission_dependencies
+    )
