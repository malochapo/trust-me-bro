@@ -0,0 +1,97 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected, monkeypatch):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _make_triage_case(session, *, triage_at, created_at):
+    # CaseFactory ignores status passed as a kwarg (it is a factory Param), so set it here
+    case = CaseFactory(triage_at=triage_at, created_at=created_at)
+    case.status = CaseStatus.triage
+    session.flush()
+    return case
+
+
+def _run_case_close_reminder(session, project, monkeypatch):
+    """Runs the close reminder job on a Monday and returns the cases it reminded."""
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    job(db_session=session, project=project)
+    return sent
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, monkeypatch
+):
+    case = _make_triage_case(
+        session,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+
+    sent = _run_case_close_reminder(session, case.project, monkeypatch)
+
+    assert case in sent
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, monkeypatch):
+    case = _make_triage_case(
+        session,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    sent = _run_case_close_reminder(session, case.project, monkeypatch)
+
+    assert case not in sent
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at(session, monkeypatch):
+    recently_triaged = _make_triage_case(
+        session,
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    long_triaged = _make_triage_case(
+        session,
+        triage_at=datetime.utcnow() - timedelta(days=8),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+
+    sent = _run_case_close_reminder(session, long_triaged.project, monkeypatch)
+
+    assert long_triaged in sent
+    assert recently_triaged not in sent
