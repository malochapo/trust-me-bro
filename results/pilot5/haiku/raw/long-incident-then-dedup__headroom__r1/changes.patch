@@ -0,0 +1,82 @@
+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+    assert scheduled._is_reminder_day() is expected
+
+
+def _triage_case(triage_at, created_at):
+    return SimpleNamespace(id=1, triage_at=triage_at, created_at=created_at)
+
+
+@pytest.fixture
+def close_reminder_job(monkeypatch):
+    """Returns the undecorated case close reminder job with the reminder day forced on."""
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    # the scheduler decorator doesn't return the function, so look it up by its task name
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    return inspect.unwrap(task["func"])
+
+
+@pytest.fixture
+def close_reminder_sends(monkeypatch):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    return sent
+
+
+def test_case_close_reminder_counts_from_triage_at(
+    monkeypatch, close_reminder_job, close_reminder_sends
+):
+    case = _triage_case(
+        triage_at=datetime.utcnow() - timedelta(days=8),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    close_reminder_job(db_session=None, project=SimpleNamespace(id=1))
+    assert close_reminder_sends == [case]
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at(
+    monkeypatch, close_reminder_job, close_reminder_sends
+):
+    case = _triage_case(triage_at=None, created_at=datetime.utcnow() - timedelta(days=8))
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    close_reminder_job(db_session=None, project=SimpleNamespace(id=1))
+    assert close_reminder_sends == [case]
+
+
+def test_case_close_reminder_without_triage_at_recently_created_is_not_sent(
+    monkeypatch, close_reminder_job, close_reminder_sends
+):
+    case = _triage_case(triage_at=None, created_at=datetime.utcnow() - timedelta(days=3))
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    close_reminder_job(db_session=None, project=SimpleNamespace(id=1))
+    assert close_reminder_sends == []
