@@ -0,0 +1,65 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+
+
+class _FakeDate(date):
+    _today = None
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _FakeDate._today = day
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _unwrap_task(name):
+    task = next(t for t in scheduled.scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize(
+    "days_in_triage, should_send",
+    [
+        (8, True),
+        (2, False),
+    ],
+)
+def test_case_close_reminder_without_triage_at(
+    monkeypatch, session, case, days_in_triage, should_send
+):
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=days_in_triage)
+    session.commit()
+
+    _unwrap_task("case-close-reminder")(session, case.project)
+
+    assert (case in sent) is should_send
