+def test_filter_snooze_skips_expired_snooze_filter(session, signal, project):
+    from datetime import datetime, timedelta
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_snooze
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    # the expired snooze comes first, the valid one after it
+    expired_filter = SignalFilterFactory(
+        name="expired",
+        description="expired snooze",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.utcnow() - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="valid",
+        description="valid snooze",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.utcnow() + timedelta(days=30),
+        project=project,
+    )
+    signal.filters.append(expired_filter)
+    signal.filters.append(valid_filter)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    filter_snooze(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
