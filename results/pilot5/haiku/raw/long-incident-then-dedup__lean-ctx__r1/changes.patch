@@ -0,0 +1,62 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case.enums import CaseStatus
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    mock_date = mocker.patch("dispatch.case.scheduled.date")
+    mock_date.today.return_value = today
+
+    assert _is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "triage_days_ago, created_days_ago, expected_sent",
+    [
+        (None, 8, True),  # never triaged with a timestamp: count from creation
+        (None, 3, False),  # no timestamp and created recently
+        (2, 30, False),  # triage_at is what counts, not created_at
+        (8, 30, True),
+    ],
+)
+def test_case_close_reminder_counts_from_triage_or_creation(
+    mocker, session, project, triage_days_ago, created_days_ago, expected_sent
+):
+    now = datetime.utcnow()
+    triage_at = now - timedelta(days=triage_days_ago) if triage_days_ago is not None else None
+    case = CaseFactory(
+        project=project,
+        triage_at=triage_at,
+        created_at=now - timedelta(days=created_days_ago),
+    )
+    # set after creating, the factory's status param would otherwise override it
+    case.status = CaseStatus.triage
+    session.commit()
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+    mocker.patch("dispatch.case.scheduled._is_reminder_day", return_value=True)
+
+    # the scheduler decorator returns None, so look the job up by name and
+    # call the undecorated function so it runs against this test's session
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(db_session=session, project=project)
+
+    assert send.called is expected_sent
