+@pytest.mark.parametrize("minutes_apart,expected_dedup", [(10, True), (45, False)])
+def test_filter_dedup_window_is_in_minutes(session, signal, project, minutes_apart, expected_dedup):
+    from datetime import datetime, timedelta
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_dedup
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the UI sets the window in minutes; this filter uses the 30 minute option
+    signal_filter = SignalFilterFactory(
+        name="test",
+        description="dedupe30",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now() - timedelta(minutes=minutes_apart),
+    )
+    session.add(earlier_instance)
+    session.commit()
+
+    later_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(later_instance)
+    session.commit()
+
+    filter_dedup(db_session=session, signal_instance=later_instance)
+    assert (later_instance.filter_action == SignalFilterAction.deduplicate) is expected_dedup
+
