index 00000000..bb03c07b
--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,61 @@
+from datetime import date, datetime, timedelta
+from inspect import unwrap
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+TUESDAY = date(2025, 8, 19)
+
+
+def _on(day):
+    return mock.patch.object(scheduled, "date", **{"today.return_value": day})
+
+
+def _job(name):
+    # the scheduler decorator returns None, so look the raw job up by name
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return unwrap(task["func"])
+
+
+@pytest.mark.parametrize("today, expected_sends", [(MONDAY, 1), (TUESDAY, 0)])
+def test_case_close_reminder_sends_only_on_mondays(session, case, today, expected_sends):
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    with _on(today), mock.patch.object(scheduled, "send_case_close_reminder") as mock_send:
+        _job("case-close-reminder")(db_session=session, project=case.project)
+
+    assert mock_send.call_count == expected_sends
+
+
+@pytest.mark.parametrize("today, expected_sends", [(MONDAY, 1), (TUESDAY, 0)])
+def test_case_stable_reminder_sends_only_on_mondays(session, case, today, expected_sends):
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    with _on(today), mock.patch.object(scheduled, "send_case_close_reminder") as mock_send:
+        _job("case-stable-reminder")(db_session=session, project=case.project)
+
+    assert mock_send.call_count == expected_sends
+
+
+@pytest.mark.parametrize("days_since_created, expected_sends", [(8, 1), (3, 0)])
+def test_case_close_reminder_counts_from_created_at_without_triage_at(
+    session, case, days_since_created, expected_sends
+):
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=days_since_created)
+    session.commit()
+
+    with _on(MONDAY), mock.patch.object(scheduled, "send_case_close_reminder") as mock_send:
+        _job("case-close-reminder")(db_session=session, project=case.project)
+
+    assert mock_send.call_count == expected_sends
