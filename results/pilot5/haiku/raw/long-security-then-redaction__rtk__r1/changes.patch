diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..aec967e2
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,30 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import redact_raw
+
+
+def _session_token_entity_type(project):
+    return EntityType(
+        name="Session token",
+        jpath="session_token",
+        regular_expression=None,
+        project=project,
+    )
+
+
+def test_find_entities_does_not_extract_unredacted_masked_value(session, signal_instance, project):
+    """Entity types applied to stored payloads (not yet masked) must not extract the secret."""
+    signal_instance.raw = {"session_token": "abc123"}
+
+    entities = find_entities(session, signal_instance, [_session_token_entity_type(project)])
+
+    assert entities == []
+
+
+def test_find_entities_does_not_extract_mask_marker(session, signal_instance, project):
+    """A masked payload holds the mask marker in place of the secret; it must not become an entity."""
+    signal_instance.raw = redact_raw({"session_token": "abc123"})
+
+    entities = find_entities(session, signal_instance, [_session_token_entity_type(project)])
+
+    assert entities == []
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..20e727c6
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permission_classes(path: str, method: str) -> list:
+    """Returns the permission classes declared on the route matching path and method."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return [
+                permission
+                for dependency in route.dependencies
+                if isinstance(dependency.dependency, PermissionsDependency)
+                for permission in dependency.dependency.permissions_classes
+            ]
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the IncidentEventPermission check being dropped from the delete route."""
+    assert IncidentEventPermission in _permission_classes(
+        "/{incident_id}/event/{event_uuid}", "DELETE"
+    )
