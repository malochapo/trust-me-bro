+def test_case_cost_stops_at_first_status_change(
+    case, session, participant, participant_role, case_cost_type
+):
+    """Tests that case cost stops at the earliest of escalated/stable/closed, not the latest."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+
+    # Participant assumed the role 3 hours ago and is still active
+    participant_role.role = ParticipantRoleType.assignee  # Full engagement multiplier
+    participant_role.assumed_at = (now - timedelta(hours=3)).replace(tzinfo=None)
+    participant_role.renounced_at = now.replace(tzinfo=None)
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # Case was escalated 2 hours ago and later marked stable 1 hour ago
+    case.status = CaseStatus.stable
+    case.escalated_at = (now - timedelta(hours=2)).replace(tzinfo=None)
+    case.stable_at = (now - timedelta(hours=1)).replace(tzinfo=None)
+
+    # Cost must stop at the escalation (1 hour of work), not at stable (2 hours of work)
+    time_seconds = get_participant_role_time_seconds(
+        case=case, participant_role=participant_role
+    )
+    assert time_seconds == 3600
+
+
+def test_get_hourly_rate_falls_back_to_project_defaults(case):
+    """Tests that projects with missing cost settings use the project model defaults."""
+    import math
+
+    from dispatch.case_cost.service import get_hourly_rate
+    from dispatch.project.models import (
+        DEFAULT_ANNUAL_EMPLOYEE_COST,
+        DEFAULT_BUSINESS_YEAR_HOURS,
+    )
+
+    project = case.project
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    expected = math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / DEFAULT_BUSINESS_YEAR_HOURS)
+    assert get_hourly_rate(project) == expected
+
+    # Only the missing value falls back, the set one is still used
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == math.ceil(DEFAULT_ANNUAL_EMPLOYEE_COST / 1000)
+
+    project.annual_employee_cost = 120000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(120000 / DEFAULT_BUSINESS_YEAR_HOURS)
+
+
+def test_calculate_case_response_cost_with_missing_project_settings(case, session):
+    """Tests that a case still gets a cost when its project has no cost settings."""
+    from dispatch.case_cost.service import calculate_case_response_cost
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    costs = calculate_case_response_cost(case=case, db_session=session)
+
+    assert all(isinstance(amount, int) for amount in costs.values())
