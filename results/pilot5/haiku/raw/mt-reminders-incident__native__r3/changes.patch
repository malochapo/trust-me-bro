+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    """Stands in for `datetime.date` so the scheduled module sees a chosen day."""
+
+    _today = None
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+def _set_today(monkeypatch, day: date):
+    _FakeDate._today = day
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+
+def _task_body(name):
+    # the scheduler decorator doesn't return the function, so look it up by its registered name
+    # and strip the timer and project-context decorators so the body runs against fakes
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.fixture
+def sent(monkeypatch):
+    sent_to = []
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent_to.append(case),
+    )
+    return sent_to
+
+
+# 2025-08-18 is a Monday, 2025-08-19 is a Tuesday
+MONDAY = date(2025, 8, 18)
+TUESDAY = date(2025, 8, 19)
+
+
+@pytest.mark.parametrize(
+    "today, expected_sent",
+    [(MONDAY, True), (TUESDAY, False)],
+)
+def test_case_stable_reminder_only_sends_on_mondays(
+    monkeypatch, sent, today, expected_sent
+):
+    case = SimpleNamespace(stable_at=datetime.utcnow() - timedelta(days=8))
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    _set_today(monkeypatch, today)
+
+    _task_body("case-stable-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    assert (case in sent) is expected_sent
+
+
+@pytest.mark.parametrize(
+    "today, expected_sent",
+    [(MONDAY, True), (TUESDAY, False)],
+)
+def test_case_close_reminder_only_sends_on_mondays(
+    monkeypatch, sent, today, expected_sent
+):
+    case = SimpleNamespace(triage_at=datetime.utcnow() - timedelta(days=8))
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    _set_today(monkeypatch, today)
+
+    _task_body("case-close-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    assert (case in sent) is expected_sent
+
+
+def test_case_close_reminder_counts_from_creation_when_triage_at_missing(monkeypatch, sent):
+    # cases that predate triage_at have no triage timestamp, so the weekly clock starts at creation
+    old_case = SimpleNamespace(
+        triage_at=None, created_at=datetime.utcnow() - timedelta(days=8)
+    )
+    new_case = SimpleNamespace(
+        triage_at=None, created_at=datetime.utcnow() - timedelta(days=2)
+    )
+    monkeypatch.setattr(
+        scheduled, "get_all_by_status", lambda **kwargs: [old_case, new_case]
+    )
+    _set_today(monkeypatch, MONDAY)
+
+    _task_body("case-close-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    assert sent == [old_case]
