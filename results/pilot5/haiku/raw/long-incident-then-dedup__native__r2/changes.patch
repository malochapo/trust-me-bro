@@ -0,0 +1,74 @@
+import pytest
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class _FixedDate(date):
+        @classmethod
+        def today(cls):
+            return cls(day.year, day.month, day.day)
+
+    monkeypatch.setattr(scheduled, "date", _FixedDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _monday():
+    class _FixedDate(date):
+        @classmethod
+        def today(cls):
+            return cls(2025, 8, 18)
+
+    return _FixedDate
+
+
+def _close_reminder_job():
+    """Returns the undecorated case close reminder job body."""
+    from dispatch.scheduler import scheduler
+
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    # timer -> scheduled_project_task -> job body
+    return task["func"].__wrapped__.__wrapped__
+
+
+@pytest.mark.parametrize(
+    "triage_at,created_days_ago,expected",
+    [
+        (None, 8, True),  # no triage timestamp, created over a week ago
+        (datetime.utcnow() - timedelta(days=8), 30, True),  # triaged over a week ago
+        (datetime.utcnow() - timedelta(days=2), 30, False),  # triaged recently
+        (None, 2, False),  # no triage timestamp, created recently
+    ],
+)
+def test_case_close_reminder_counts_from_created_at_when_not_triaged(
+    monkeypatch, triage_at, created_days_ago, expected
+):
+    monkeypatch.setattr(scheduled, "date", _monday())
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    case = SimpleNamespace(
+        triage_at=triage_at,
+        created_at=datetime.utcnow() - timedelta(days=created_days_ago),
+    )
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+
+    _close_reminder_job()(db_session=None, project=SimpleNamespace(id=1))
+
+    assert bool(sent) is expected
