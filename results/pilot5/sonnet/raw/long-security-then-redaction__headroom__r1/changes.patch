diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..ddf41520
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,19 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_find_entities_ignores_masked_values(session, signal_instance, project):
+    signal_instance.raw = redact_raw(
+        {"session_token": "abc123", "nested": [{"password": "hunter2"}], "user": "alice"}
+    )
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", project=project),
+        EntityType(name="Passwords", jpath="nested[*].password", project=project),
+        EntityType(name="User", jpath="user", project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [e.value for e in entities] == ["alice"]
+    assert MASK not in {e.value for e in entities}
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..a158f23f
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,25 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"{method} {path} not found")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting an incident timeline event must be guarded by IncidentEventPermission."""
+    route = _route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permissions = [
+        permission
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission in dependency.dependency.permissions_classes
+    ]
+
+    assert IncidentEventPermission in permissions
