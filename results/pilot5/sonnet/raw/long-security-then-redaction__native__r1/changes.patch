diff --git a/tests/entity/test_entity_masked_values.py b/tests/entity/test_entity_masked_values.py
new file mode 100644
index 00000000..5a3f393a
--- /dev/null
+++ b/tests/entity/test_entity_masked_values.py
@@ -0,0 +1,20 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_ignores_masked_values(session, project):
+    """A value masked by redact_raw must never become an entity."""
+    signal_instance = SignalInstanceFactory(
+        raw=redact_raw({"session_token": "abc123", "user": {"login": "octocat"}})
+    )
+    assert signal_instance.raw["session_token"] == MASK
+
+    entity_types = [
+        EntityType(name="Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Login", jpath="user.login", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [e.value for e in entities] == ["octocat"]
diff --git a/tests/incident/test_incident_view_permissions.py b/tests/incident/test_incident_view_permissions.py
new file mode 100644
index 00000000..c573719a
--- /dev/null
+++ b/tests/incident/test_incident_view_permissions.py
@@ -0,0 +1,22 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident timeline event must be guarded by IncidentEventPermission."""
+    route = _route("/{incident_id}/event/{event_uuid}", "DELETE")
+    permissions = [
+        dep.dependency.permissions_classes
+        for dep in route.dependencies
+        if isinstance(dep.dependency, PermissionsDependency)
+    ]
+    assert [IncidentEventPermission] in permissions
