diff --git a/tests/entity/test_entity_masked_values.py b/tests/entity/test_entity_masked_values.py
new file mode 100644
index 00000000..75ceb0c3
--- /dev/null
+++ b/tests/entity/test_entity_masked_values.py
@@ -0,0 +1,20 @@
+from dispatch.entity import service as entity_service
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_find_entities_ignores_masked_values(session, signal_instance, project):
+    signal_instance.raw = redact_raw(
+        {"session_token": "abc123", "nested": [{"password": "hunter2", "user": "alice"}]}
+    )
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", project=project),
+        EntityType(name="Password", jpath="nested[*].password", project=project),
+        EntityType(name="User", jpath="nested[*].user", project=project),
+    ]
+
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert values == {"alice"}
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..96a25dcc
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,22 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permissions_for(route):
+    """Returns the permission classes declared via PermissionsDependency on a route."""
+    permissions = []
+    for dependency in route.dependencies:
+        if isinstance(dependency.dependency, PermissionsDependency):
+            permissions.extend(dependency.dependency.permissions_classes)
+    return permissions
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting a custom incident event must be guarded by IncidentEventPermission."""
+    routes = [
+        r
+        for r in router.routes
+        if r.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in r.methods
+    ]
+    assert len(routes) == 1
+    assert IncidentEventPermission in _permissions_for(routes[0])
