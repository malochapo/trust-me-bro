diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..c6815a69
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,41 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def _session_token_type(project):
+    return EntityType(
+        name="Session token", jpath="session_token", regular_expression=None, project=project
+    )
+
+
+def test_find_entities_ignores_masked_value(session, signal_instance, project):
+    signal_instance.raw = redact_raw({**signal_instance.raw, "session_token": "abc123"})
+    assert signal_instance.raw["session_token"] == MASK
+
+    entities = find_entities(session, signal_instance, [_session_token_type(project)])
+
+    assert entities == []
+
+
+def test_find_entities_ignores_value_not_yet_masked(session, signal_instance, project):
+    signal_instance.raw = {**signal_instance.raw, "session_token": "abc123"}
+
+    entities = find_entities(session, signal_instance, [_session_token_type(project)])
+
+    assert entities == []
+
+
+def test_find_entities_ignores_masked_values_under_wildcard(session, signal_instance, project):
+    signal_instance.raw = {
+        **signal_instance.raw,
+        "events": [{"password": "p1", "user": "alice"}, {"password": "p2", "user": "bob"}],
+    }
+    types = [
+        EntityType(name="Pw", jpath="events[*].password", regular_expression=None, project=project),
+        EntityType(name="User", jpath="events[*].user", regular_expression=None, project=project),
+    ]
+
+    values = {str(e.value) for e in find_entities(session, signal_instance, types)}
+
+    assert values == {"alice", "bob"}
diff --git a/tests/incident/test_incident_view_permissions.py b/tests/incident/test_incident_view_permissions.py
new file mode 100644
index 00000000..63580425
--- /dev/null
+++ b/tests/incident/test_incident_view_permissions.py
@@ -0,0 +1,33 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route(method: str, path: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"route {method} {path} not found")
+
+
+def _permission_classes(route: APIRoute) -> set:
+    classes = set()
+    for dependency in route.dependencies:
+        call = dependency.dependency
+        if isinstance(call, PermissionsDependency):
+            classes.update(call.permissions_classes)
+    return classes
+
+
+def test_custom_event_routes_require_incident_event_permission():
+    """Every route that changes incident timeline events must enforce IncidentEventPermission."""
+    for method, path in [
+        ("POST", "/{incident_id}/event"),
+        ("PATCH", "/{incident_id}/event"),
+        ("DELETE", "/{incident_id}/event/{event_uuid}"),
+        ("POST", "/{incident_id}/exportTimeline"),
+    ]:
+        assert IncidentEventPermission in _permission_classes(_route(method, path)), (
+            f"{method} {path} is missing IncidentEventPermission"
+        )
