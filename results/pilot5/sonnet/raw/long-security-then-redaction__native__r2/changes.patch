diff --git a/tests/incident/test_incident_route_permissions.py b/tests/incident/test_incident_route_permissions.py
new file mode 100644
index 00000000..9ffd0129
--- /dev/null
+++ b/tests/incident/test_incident_route_permissions.py
@@ -0,0 +1,30 @@
+import pytest
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permissions_for(path, method):
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            return [
+                permission
+                for dependency in route.dependencies
+                if isinstance(dependency.dependency, PermissionsDependency)
+                for permission in dependency.dependency.permissions_classes
+            ]
+    raise AssertionError(f"route {method} {path} not found")
+
+
+@pytest.mark.parametrize(
+    "path,method",
+    [
+        ("/{incident_id}/event", "POST"),
+        ("/{incident_id}/event", "PATCH"),
+        ("/{incident_id}/exportTimeline", "POST"),
+        ("/{incident_id}/event/{event_uuid}", "DELETE"),
+    ],
+)
+def test_incident_event_routes_require_event_permission(path, method):
+    """Mutating incident event routes must declare IncidentEventPermission."""
+    assert IncidentEventPermission in _permissions_for(path, method)
