diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..cf3730cb
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,27 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def _session_token_type(project):
+    return EntityType(name="Session token", jpath="session_token", project=project)
+
+
+def test_find_entities_skips_masked_value(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = redact_raw({"session_token": "abc123", "other": "x"})
+    assert signal_instance.raw["session_token"] == MASK
+
+    assert find_entities(session, signal_instance, [_session_token_type(project)]) == []
+
+
+def test_find_entities_never_extracts_unmasked_sensitive_value(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {"session_token": "abc123", "nested": [{"Password": "hunter2"}]}
+    entity_types = [
+        _session_token_type(project),
+        EntityType(name="Password", jpath="nested[*].Password", project=project),
+    ]
+
+    assert find_entities(session, signal_instance, entity_types) == []
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..18447b06
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,21 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_permissions(path: str, method: str):
+    """Returns the permission classes declared on a route via PermissionsDependency."""
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            return [
+                permission
+                for dependency in route.dependencies
+                if isinstance(dependency.dependency, PermissionsDependency)
+                for permission in dependency.dependency.permissions_classes
+            ]
+    raise AssertionError(f"route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident timeline event must declare IncidentEventPermission."""
+    permissions = _route_permissions("/{incident_id}/event/{event_uuid}", "DELETE")
+    assert IncidentEventPermission in permissions
