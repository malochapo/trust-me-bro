+def test_get_participant_role_time_seconds__uses_earliest_cutoff(case, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import (
+        get_engagement_multiplier,
+        get_participant_role_time_seconds,
+    )
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)
+    assumed_at = now - timedelta(hours=20)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at
+    participant_role.renounced_at = None
+
+    case.status = CaseStatus.closed
+    case.stable_at = assumed_at + timedelta(hours=2)
+    case.escalated_at = assumed_at + timedelta(hours=5)
+    case.closed_at = assumed_at + timedelta(hours=10)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # the participant's time ends when the case became stable, not when it was closed
+    expected = 2 * 3600 * get_engagement_multiplier(ParticipantRoleType.assignee)
+    assert time_seconds == pytest.approx(expected)
+
