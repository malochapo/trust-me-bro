+def test_case_cost_stops_at_earliest_status_timestamp(case, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.case.enums import CaseStatus
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    started_at = now - timedelta(hours=10)
+    stable_at = now - timedelta(hours=6)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = started_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active, so the status timestamps decide
+
+    case.status = CaseStatus.stable
+    case.stable_at = stable_at
+    case.escalated_at = now - timedelta(hours=2)
+    case.closed_at = now - timedelta(hours=1)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # the later escalated_at and closed_at must not extend the cost past stable_at
+    expected_seconds = (stable_at - started_at).total_seconds()
+    assert abs(time_seconds - expected_seconds) < 1
+
+
+def test_get_hourly_rate_uses_project_defaults_for_unset_values(project):
+    """Tests that a project without cost settings falls back to the project model's defaults."""
+    import math
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = 2000
+    assert get_hourly_rate(project) == 50
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == math.ceil(50000 / 2000)
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == math.ceil(100000 / 2080)
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == math.ceil(50000 / 2080)
