diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..a77f78ed
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,32 @@
+from dispatch.entity import service as entity_service
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_ignores_masked_values(session, project):
+    entity_types = [
+        EntityType(name="Session token", jpath="$..session_token", project=project),
+        EntityType(name="Actor", jpath="actor", project=project),
+    ]
+
+    # instances of the same signal differ only in the (masked) token
+    entity_ids = []
+    for actor in ("alice", "bob"):
+        raw = redact_raw({"actor": actor, "session_token": f"tok-{actor}"})
+        assert raw["session_token"] == MASK
+        instance = SignalInstanceFactory(raw=raw)
+        entities = entity_service.find_entities(session, instance, entity_types)
+        assert [e.value for e in entities] == [actor]
+        entity_ids.append(entities[0].id)
+
+    assert entity_ids[0] != entity_ids[1]
+
+
+def test_find_entities_ignores_masked_values_among_several_matches(session, project):
+    entity_types = [EntityType(name="Token", jpath="$..token", project=project)]
+    instance = SignalInstanceFactory(raw={"a": {"token": MASK}, "b": {"token": "visible"}})
+
+    entities = entity_service.find_entities(session, instance, entity_types)
+
+    assert [e.value for e in entities] == ["visible"]
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..b295f87f
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,18 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident event must be guarded by IncidentEventPermission."""
+    (route,) = [
+        r
+        for r in router.routes
+        if r.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in r.methods
+    ]
+    guards = [
+        d.dependency
+        for d in route.dependencies
+        if isinstance(d.dependency, PermissionsDependency)
+    ]
+
+    assert any(IncidentEventPermission in g.permissions_classes for g in guards)
