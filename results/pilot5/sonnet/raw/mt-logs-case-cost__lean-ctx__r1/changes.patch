+def test_case_cost_stops_at_earliest_status_timestamp(case, participant_role):
+    """Tests that cost stops at the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+    from dispatch.case.enums import CaseStatus
+
+    now = datetime.now(timezone.utc)
+    assumed_at = now - timedelta(hours=10)
+    escalated_at = now - timedelta(hours=8)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = assumed_at.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+
+    # the case was escalated, then later marked stable and closed
+    case.status = CaseStatus.closed
+    case.escalated_at = escalated_at
+    case.stable_at = now - timedelta(hours=4)
+    case.closed_at = now - timedelta(hours=1)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    assert time_seconds == int((escalated_at - assumed_at).total_seconds())
+
+
+def test_get_hourly_rate__unset_project_values_use_defaults(project):
+    """Tests that a project without annual employee cost or business year hours still gets a rate."""
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == 25  # 50000 / 2080, rounded up
+
+    project.annual_employee_cost = 104000
+    assert get_hourly_rate(project) == 50  # business year hours falls back to 2080
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 1000
+    assert get_hourly_rate(project) == 50  # annual employee cost falls back to 50000
