@@ -322,3 +322,26 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_creates_masked_entity(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Any password", jpath="$..password", regular_expression=None, project=project),
+        EntityType(name="User", jpath="user", regular_expression=None, project=project),
+    ]
+    raw = {"session_token": "abc123", "user": "alice", "nested": [{"password": "hunter2"}]}
+
+    # payload stored before redaction ran
+    signal_instance.raw = raw
+    entities = find_entities(session, signal_instance, entity_types)
+    assert {e.value for e in entities} == {"alice"}
+
+    # payload already redacted
+    signal_instance.raw = redact_raw(raw)
+    entities = find_entities(session, signal_instance, entity_types)
+    assert {e.value for e in entities} == {"alice"}
+    assert all(e.value != MASK for e in entities)
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..606e0d6d
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,19 @@
+from dispatch.incident.views import router
+from dispatch.auth.permissions import IncidentEventPermission
+
+
+def _permissions_for(method: str, path: str):
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            return [
+                dep.dependency.permissions_classes
+                for dep in route.dependencies
+                if hasattr(dep.dependency, "permissions_classes")
+            ]
+    raise AssertionError(f"route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident event must be guarded by IncidentEventPermission."""
+    perms = _permissions_for("DELETE", "/{incident_id}/event/{event_uuid}")
+    assert any(IncidentEventPermission in p for p in perms)
