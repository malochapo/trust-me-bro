+def test_case_cost_stops_at_earliest_status_timestamp(case, participant, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    two_hours_ago = now - timedelta(hours=2)
+    one_hour_ago = now - timedelta(hours=1)
+
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = two_hours_ago.replace(tzinfo=None)
+    participant_role.renounced_at = None  # still active
+    participant.participant_roles = [participant_role]
+    case.participants = [participant]
+
+    # the case went stable an hour ago and was closed afterwards
+    case.status = CaseStatus.closed
+    case.stable_at = one_hour_ago
+    case.escalated_at = None
+    case.closed_at = now - timedelta(minutes=10)
+
+    time_seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # the cost must not keep accruing between stable_at and closed_at
+    assert time_seconds == int((one_hour_ago - two_hours_ago).total_seconds())
+
+
+def test_get_hourly_rate__missing_values_use_project_defaults(project):
+    """Tests that unset project cost settings fall back to the project model defaults."""
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = 2000
+    assert get_hourly_rate(project) == 50
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == 25  # 50000 / 2000
+
+    project.annual_employee_cost = 100000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == 49  # ceil(100000 / 2080)
+
+    project.annual_employee_cost = None
+    assert get_hourly_rate(project) == 25  # ceil(50000 / 2080)
+
+
+def test_calculate_case_response_cost_new__project_without_cost_settings(
+    case, session, participant_activity, case_cost_type
+):
+    """Tests that a project with no cost settings no longer raises a TypeError."""
+    from dispatch.case_cost.service import calculate_case_response_cost_new
+
+    case.project.annual_employee_cost = None
+    case.project.business_year_hours = None
+
+    assert calculate_case_response_cost_new(case=case, db_session=session) >= 0
