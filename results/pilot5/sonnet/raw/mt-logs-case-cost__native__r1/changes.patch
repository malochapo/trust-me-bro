+def test_case_cost_stops_at_earliest_status_timestamp(case, participant_role):
+    """Tests that the cost cut-off is the earliest of stable_at, escalated_at and closed_at."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case.enums import CaseStatus
+    from dispatch.case_cost.service import get_participant_role_time_seconds
+    from dispatch.participant_role.models import ParticipantRoleType
+
+    now = datetime.now(timezone.utc)
+    participant_role.role = ParticipantRoleType.assignee
+    participant_role.assumed_at = (now - timedelta(hours=10)).replace(tzinfo=None)
+    participant_role.renounced_at = None
+
+    case.status = CaseStatus.closed
+    case.stable_at = now - timedelta(hours=8)
+    case.escalated_at = now - timedelta(hours=6)
+    case.closed_at = now - timedelta(hours=1)
+
+    seconds = get_participant_role_time_seconds(case=case, participant_role=participant_role)
+
+    # cost stops at stable_at (2 hours after assuming the role), not at the later timestamps
+    assert abs(seconds - 2 * 3600) < 1
+
+
+def test_get_hourly_rate__missing_values_use_project_defaults(project):
+    from dispatch.case_cost.service import get_hourly_rate
+
+    project.annual_employee_cost = None
+    project.business_year_hours = 2080
+    assert get_hourly_rate(project) == 25  # ceil(50000 / 2080)
+
+    project.annual_employee_cost = 104000
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == 50  # 104000 / 2080
+
+    project.annual_employee_cost = None
+    project.business_year_hours = None
+    assert get_hourly_rate(project) == 25
