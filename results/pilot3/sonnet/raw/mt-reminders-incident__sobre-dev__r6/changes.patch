@@ -0,0 +1,67 @@
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _registered_task(name):
+    # scheduler.add does not return the decorated function, so look it up by name
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize(
+    "triage_age_days,created_age_days,expected_sent",
+    [
+        (10, 10, True),  # triaging for over a week
+        (2, 30, False),  # triage_at wins over created_at
+        (None, 10, True),  # no triage_at: count from created_at
+        (None, 2, False),
+    ],
+)
+def test_case_close_reminder(
+    monkeypatch, triage_age_days, created_age_days, expected_sent
+):
+    now = datetime.utcnow()
+    case = SimpleNamespace(
+        triage_at=None if triage_age_days is None else now - timedelta(days=triage_age_days),
+        created_at=now - timedelta(days=created_age_days),
+    )
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: [case])
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda c, db_session: sent.append(c)
+    )
+
+    _registered_task("case-close-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    assert (sent == [case]) is expected_sent
