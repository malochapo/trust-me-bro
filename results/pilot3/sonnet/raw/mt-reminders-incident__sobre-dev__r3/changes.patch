+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+def _close_reminder_job():
+    # scheduler.add registers the job and returns None, so unwrap the registered function
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    return inspect.unwrap(task["func"])
+
+
+def _run_close_reminder(cases, today):
+    with (
+        patch.object(scheduled, "date") as mock_date,
+        patch.object(scheduled, "get_all_by_status", return_value=cases),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        mock_date.today.return_value = today
+        _close_reminder_job()(db_session=None, project=SimpleNamespace(id=1))
+    return send
+
+
+def _case(triage_at, created_at):
+    return SimpleNamespace(triage_at=triage_at, created_at=created_at)
+
+
+MONDAY = date(2025, 8, 18)
+
+
+def test_close_reminder_falls_back_to_created_at_when_triage_at_missing():
+    case = _case(None, datetime.utcnow() - timedelta(days=10))
+    assert _run_close_reminder([case], MONDAY).call_count == 1
+
+
+def test_close_reminder_missing_triage_at_young_case_not_reminded():
+    case = _case(None, datetime.utcnow() - timedelta(days=2))
+    assert _run_close_reminder([case], MONDAY).call_count == 0
+
+
+def test_close_reminder_prefers_triage_at_over_created_at():
+    case = _case(datetime.utcnow() - timedelta(days=2), datetime.utcnow() - timedelta(days=30))
+    assert _run_close_reminder([case], MONDAY).call_count == 0
+
+
+def test_close_reminder_not_sent_off_monday():
+    case = _case(None, datetime.utcnow() - timedelta(days=10))
+    assert _run_close_reminder([case], date(2025, 8, 19)).call_count == 0
