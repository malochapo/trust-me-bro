@@ -0,0 +1,22 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _permission_classes(route):
+    classes = []
+    for dependency in route.dependencies:
+        call = dependency.dependency
+        if isinstance(call, PermissionsDependency):
+            classes.extend(call.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Regression: deleting an incident timeline event must check IncidentEventPermission."""
+    routes = [
+        r
+        for r in router.routes
+        if r.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in r.methods
+    ]
+    assert len(routes) == 1
+    assert IncidentEventPermission in _permission_classes(routes[0])
