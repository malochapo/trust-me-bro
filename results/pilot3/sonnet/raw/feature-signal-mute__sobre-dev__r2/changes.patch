+def filter_mute(*, signal_instance: SignalInstance) -> SignalInstance:
+    """Marks the signal instance as muted if its signal definition is currently muted."""
+    muted_until = signal_instance.signal.muted_until
+    if not muted_until:
+        return signal_instance
+
+    if muted_until.tzinfo is None:
+        muted_until = muted_until.replace(tzinfo=timezone.utc)
+
+    if muted_until > datetime.now(timezone.utc):
+        signal_instance.filter_action = SignalFilterAction.mute
+
+    return signal_instance
+
