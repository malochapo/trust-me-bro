+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+
+
+def _on(day):
+    """Returns a stand-in for `date` whose today() is the given day."""
+    fake = mock.Mock(wraps=date)
+    fake.today.return_value = day
+    return fake
+
+
+def _unwrap(name):
+    """Returns the undecorated task registered with the scheduler under name."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_mondays(offset):
+    day = MONDAY + timedelta(days=offset)
+    with mock.patch.object(scheduled, "date", _on(day)):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize(
+    "task_name,status,attr",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize("offset,expected", [(0, True), (1, False), (6, False)])
+def test_long_running_case_reminders_sent_on_mondays_only(task_name, status, attr, offset, expected):
+    case = mock.Mock(status=status)
+    setattr(case, attr, datetime.utcnow() - timedelta(days=14))
+    func = _unwrap(task_name)
+
+    with (
+        mock.patch.object(scheduled, "date", _on(MONDAY + timedelta(days=offset))),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    assert send.called is expected
+
+
+@pytest.mark.parametrize("age_days,expected", [(14, True), (3, False)])
+def test_close_reminder_counts_from_created_at_without_triage_at(age_days, expected):
+    case = mock.Mock(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=age_days),
+    )
+    func = _unwrap("case-close-reminder")
+
+    with (
+        mock.patch.object(scheduled, "date", _on(MONDAY)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    log_exception.assert_not_called()
+    assert send.called is expected
