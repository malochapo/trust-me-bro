+def test_filter_signal_muted(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalBase, SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = datetime.utcnow() + timedelta(hours=1)
+    instance = SignalInstanceFactory(project=project, signal=signal, raw=json.dumps({"id": "a"}))
+    session.add(instance)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=instance)
+    assert instance.filter_action == SignalFilterAction.mute
+
+    # the mute ends by itself
+    signal.muted_until = datetime.utcnow() - timedelta(minutes=1)
+    expired = SignalInstanceFactory(project=project, signal=signal, raw=json.dumps({"id": "b"}))
+    session.add(expired)
+    session.commit()
+    filter_signal(db_session=session, signal_instance=expired)
+    assert expired.filter_action != SignalFilterAction.mute
+
+    # aware timestamps are stored as naive UTC
+    signal_in = SignalBase(
+        owner="o",
+        project={"name": "proj"},
+        name="x", muted_until=datetime(2030, 1, 1, 12, tzinfo=timezone(timedelta(hours=2)))
+    )
+    assert signal_in.muted_until == datetime(2030, 1, 1, 10)
