+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    """A filter's window is stored in minutes (as the UI offers), not seconds."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.now(timezone.utc)
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=10),
+    )
+    session.add(earlier_instance)
+
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now,
+    )
+    session.add(new_instance)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-30-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.deduplicate
+    assert new_instance.case_id == earlier_instance.case_id
+
+
+def test_filter_actions_snooze_skips_expired_filter(session, entity, signal, project):
+    """An expired snooze filter must not stop later, still valid snooze filters from applying."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    now = datetime.now(tz=timezone.utc)
+    for name, expiration in (
+        ("expired snooze", now - timedelta(days=7)),
+        ("valid snooze", now + timedelta(days=30)),
+    ):
+        # create the filter before touching signal.filters: the factory commits the session
+        signal_filter = SignalFilterFactory(
+            name=name,
+            description="test",
+            expression=expression,
+            action="snooze",
+            expiration=expiration,
+            project=project,
+        )
+        signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
+
+
