+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize("day,expected", [(18 + i, i == 0) for i in range(7)])
+def test_is_reminder_day_only_on_monday(day, expected):
+    # 2025-08-18 is a Monday
+    with mock.patch.object(scheduled, "date", _FakeDate):
+        _FakeDate._today = date(2025, 8, day)
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize("status", [CaseStatus.triage, CaseStatus.stable])
+@pytest.mark.parametrize("day,expected", [(18, True), (19, False), (17, False)])
+def test_weekly_reminders_sent_only_on_monday(status, day, expected):
+    case = mock.Mock()
+    old = datetime.utcnow() - timedelta(days=10)
+    case.triage_at = old
+    case.stable_at = old
+    name = "case-close-reminder" if status == CaseStatus.triage else "case-stable-reminder"
+    func = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    # unwrap the project decorator to reach the task body
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+
+    with (
+        mock.patch.object(scheduled, "date", _FakeDate),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _FakeDate._today = date(2025, 8, day)
+        func(db_session=mock.Mock(), project=mock.Mock(id=1))
+    assert send.called is expected
+
+
+def _close_reminder_body():
+    func = next(
+        t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize("age_days,expected", [(10, True), (3, False)])
+def test_close_reminder_falls_back_to_created_at_without_triage_at(age_days, expected):
+    case = mock.Mock()
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=age_days)
+
+    with (
+        mock.patch.object(scheduled, "date", _FakeDate),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exc,
+    ):
+        _FakeDate._today = date(2025, 8, 18)
+        _close_reminder_body()(db_session=mock.Mock(), project=mock.Mock(id=1))
+    assert not log_exc.called
+    assert send.called is expected
