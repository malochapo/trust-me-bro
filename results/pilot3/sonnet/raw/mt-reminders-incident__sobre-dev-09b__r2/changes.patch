+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with mock.patch.object(scheduled, "date") as mock_date:
+        mock_date.today.return_value = day
+        assert scheduled._is_reminder_day() is expected
+
+
+def _job_body(name):
+    """Returns the undecorated job function registered with the scheduler."""
+    func = next(t["func"] for t in scheduled.scheduler.registered_tasks if t["name"] == name)
+    # unwrap the timer and project-context decorators to exercise the job body
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.mark.parametrize("name", ["case-stable-reminder", "case-close-reminder"])
+@pytest.mark.parametrize("day, sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_only_sent_on_mondays(name, day, sent):
+    case = mock.Mock(
+        triage_at=datetime.utcnow() - timedelta(days=10),
+        stable_at=datetime.utcnow() - timedelta(days=10),
+    )
+
+    with mock.patch.object(scheduled, "date") as mock_date, mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        mock_date.today.return_value = day
+        _job_body(name)(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    assert send.called is sent
+
+
+@pytest.mark.parametrize(
+    "age_days, sent", [(10, True), (3, False)]
+)
+def test_close_reminder_falls_back_to_created_at_without_triage_at(age_days, sent):
+    case = mock.Mock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=age_days))
+
+    with mock.patch.object(scheduled, "date") as mock_date, mock.patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), mock.patch.object(scheduled, "send_case_close_reminder") as send, mock.patch.object(
+        scheduled.log, "exception"
+    ) as log_exception:
+        mock_date.today.return_value = date(2025, 8, 18)  # Monday
+        _job_body("case-close-reminder")(db_session=mock.Mock(), project=mock.Mock(id=1))
+
+    log_exception.assert_not_called()
+    assert send.called is sent
