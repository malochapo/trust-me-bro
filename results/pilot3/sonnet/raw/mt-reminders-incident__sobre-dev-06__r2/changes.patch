@@ -0,0 +1,72 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+def _freeze(monkeypatch, day):
+    _FakeDate._today = day
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+
+MONDAY = date(2025, 8, 18)
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(monkeypatch, offset):
+    _freeze(monkeypatch, MONDAY + timedelta(days=offset))
+    assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize(
+    "func_name,status,field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize("offset,expected", [(0, True), (1, False)])
+def test_long_running_case_reminders_sent_on_mondays(
+    monkeypatch, func_name, status, field, offset, expected
+):
+    _freeze(monkeypatch, MONDAY + timedelta(days=offset))
+    case = MagicMock(**{field: datetime.utcnow() - timedelta(days=10)})
+    # the scheduler decorator registers the task and returns None, so look it up there
+    task = next(t for t in scheduler.registered_tasks if t["name"] == func_name)
+    func = inspect.unwrap(task["func"])
+
+    with patch.object(scheduled, "get_all_by_status", return_value=[case]), patch.object(
+        scheduled, "send_case_close_reminder"
+    ) as send:
+        func(db_session=MagicMock(), project=MagicMock(id=1))
+
+    assert send.called is expected
+
+
+def test_close_reminder_counts_from_created_at_without_triage_at(monkeypatch):
+    _freeze(monkeypatch, MONDAY)
+    old = MagicMock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=10))
+    recent = MagicMock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    func = inspect.unwrap(task["func"])
+
+    with patch.object(scheduled, "get_all_by_status", return_value=[old, recent]), patch.object(
+        scheduled, "send_case_close_reminder"
+    ) as send, patch.object(scheduled.log, "exception") as log_exception:
+        func(db_session=MagicMock(), project=MagicMock(id=1))
+
+    log_exception.assert_not_called()
+    assert [c.args[0] for c in send.call_args_list] == [old]
