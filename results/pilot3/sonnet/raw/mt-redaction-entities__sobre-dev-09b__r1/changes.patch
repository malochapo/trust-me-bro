diff --git a/tests/entity/test_entity_service.py b/tests/entity/test_entity_service.py
index 54251a28..0678e550 100644
--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,32 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_ignores_masked_values(session, project):
+    from dispatch.signal.redaction import MASK
+
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    # already masked payload, as in signal_instance_create_flow
+    masked = SignalInstanceFactory(raw={"session_token": MASK, "user": "alice"})
+    entities = entity_service.find_entities(session, masked, entity_types)
+    assert [e.value for e in entities] == ["alice"]
+
+    # payload that has not been masked yet must not yield the secret either
+    unmasked = SignalInstanceFactory(raw={"session_token": "ghp_abc123", "user": "alice"})
+    entities = entity_service.find_entities(session, unmasked, entity_types)
+    assert [e.value for e in entities] == ["alice"]
