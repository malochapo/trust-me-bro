@@ -0,0 +1,82 @@
+import inspect
+
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    today_value = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls.today_value
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day_only_on_monday(day, expected):
+    _FakeDate.today_value = day
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+def _run_close_reminder(cases):
+    # unwrap the timer and scheduled_project_task decorators to call the job directly
+    registered = next(
+        t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    job = inspect.unwrap(registered["func"])
+    with (
+        patch.object(scheduled, "get_all_by_status", return_value=cases),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+        patch.object(scheduled, "_is_reminder_day", return_value=True),
+        patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        job(db_session=None, project=SimpleNamespace(id=1))
+    return send, log_exception
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at():
+    old = datetime.utcnow() - timedelta(days=10)
+    case = SimpleNamespace(triage_at=None, created_at=old)
+
+    send, log_exception = _run_close_reminder([case])
+
+    log_exception.assert_not_called()
+    send.assert_called_once()
+
+
+def test_case_close_reminder_without_triage_at_skips_recent_case():
+    case = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+
+    send, log_exception = _run_close_reminder([case])
+
+    log_exception.assert_not_called()
+    send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at():
+    case = SimpleNamespace(
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+
+    send, _ = _run_close_reminder([case])
+
+    send.assert_not_called()
