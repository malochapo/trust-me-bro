+def is_muted(*, signal: Signal) -> bool:
+    """Returns True if the signal is muted at the current time."""
+    muted_until = signal.muted_until
+    if not muted_until:
+        return False
+    if muted_until.tzinfo is None:
+        muted_until = muted_until.replace(tzinfo=timezone.utc)
+    return muted_until > datetime.now(timezone.utc)
