+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _fake_today(day):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return FakeDate
+
+
+def _raw(name):
+    # the scheduler decorator doesn't return the function, so look it up by task name
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize("day_offset,expected", [(0, True), (1, False), (2, False), (6, False)])
+def test_is_reminder_day_only_on_monday(day_offset, expected):
+    monday = date(2025, 8, 18)
+    with patch.object(scheduled, "date", _fake_today(monday + timedelta(days=day_offset))):
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "name,status,field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize("today,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_weekly_reminders_sent_on_mondays(name, status, field, today, sent):
+    case = SimpleNamespace(**{field: datetime.utcnow() - timedelta(days=10)})
+    with (
+        patch.object(scheduled, "date", _fake_today(today)),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _raw(name)(db_session=None, project=SimpleNamespace(id=1))
+
+    assert send.called is sent
+
+
+@pytest.mark.parametrize("today,sent", [(date(2025, 8, 18), True), (date(2025, 8, 19), False)])
+def test_close_reminder_falls_back_to_created_at_without_triage_at(today, sent):
+    old = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=10))
+    recent = SimpleNamespace(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+    with (
+        patch.object(scheduled, "date", _fake_today(today)),
+        patch.object(scheduled, "get_all_by_status", return_value=[recent, old]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+        patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        _raw("case-close-reminder")(db_session=None, project=SimpleNamespace(id=1))
+
+    log_exception.assert_not_called()
+    assert [c.args[0] for c in send.call_args_list] == ([old] if sent else [])
