+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 20), False),
+        (date(2025, 8, 21), False),
+        (date(2025, 8, 22), False),
+        (date(2025, 8, 23), False),
+        (date(2025, 8, 24), False),  # Sunday
+        (date(2025, 8, 25), True),  # Monday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_close_reminder(monkeypatch, cases):
+    sent = []
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: cases)
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(scheduled, "send_case_close_reminder", lambda case, db: sent.append(case))
+    # scheduler.add does not return the function, so look it up and unwrap the decorators
+    task = next(
+        t for t in scheduled.scheduler.registered_tasks if t["name"] == "case-close-reminder"
+    )
+    func = task["func"]
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    func(db_session=None, project=SimpleNamespace(id=1))
+    return sent
+
+
+def test_case_close_reminder_falls_back_to_created_at(monkeypatch):
+    now = datetime.utcnow()
+    no_triage_at = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=10))
+    new_case = SimpleNamespace(triage_at=None, created_at=now - timedelta(days=2))
+    triaged = SimpleNamespace(triage_at=now - timedelta(days=8), created_at=now - timedelta(days=30))
+    recent = SimpleNamespace(triage_at=now - timedelta(days=1), created_at=now - timedelta(days=30))
+
+    sent = _run_close_reminder(monkeypatch, [no_triage_at, new_case, triaged, recent])
+
+    assert sent == [no_triage_at, triaged]
