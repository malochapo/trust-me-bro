+def test_filter_signal_muted(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = (datetime.now(timezone.utc) + timedelta(hours=1)).replace(tzinfo=None)
+    instance = SignalInstanceFactory(project=project, signal=signal, raw=json.dumps({"id": "m"}))
+    session.add(instance)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=instance)
+    assert instance.filter_action == SignalFilterAction.mute
+
+
+def test_filter_signal_mute_expired(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = (datetime.now(timezone.utc) - timedelta(hours=1)).replace(tzinfo=None)
+    instance = SignalInstanceFactory(project=project, signal=signal, raw=json.dumps({"id": "e"}))
+    session.add(instance)
+    session.commit()
+
