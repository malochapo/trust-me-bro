@@ -0,0 +1,87 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+MONDAY = date(2025, 8, 18)
+
+
+def _registered_job(name):
+    """`scheduler.add` returns None, so look the job up in the registry."""
+    return next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+
+
+def _fake_date(today):
+    fake = MagicMock(wraps=date)
+    fake.today.return_value = today
+    return fake
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    today = MONDAY + timedelta(days=offset)
+    with patch.object(scheduled, "date", _fake_date(today)):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize(
+    "job_name, status, field",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at"),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at"),
+    ],
+)
+@pytest.mark.parametrize("offset, expected_sends", [(0, 1), (1, 0)])
+def test_weekly_case_reminders_sent_on_monday_only(job_name, status, field, offset, expected_sends):
+    case = MagicMock()
+    setattr(case, field, datetime.utcnow() - timedelta(days=14))
+    today = MONDAY + timedelta(days=offset)
+
+    with (
+        patch.object(scheduled, "date", _fake_date(today)),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]) as get_cases,
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        inspect.unwrap(_registered_job(job_name))(db_session=MagicMock(), project=MagicMock(id=1))
+
+    assert get_cases.call_args.kwargs["statuses"] == [status]
+    assert send.call_count == expected_sends
+
+
+@pytest.mark.parametrize("offset, expected_sends", [(0, 1), (1, 0)])
+def test_case_close_reminder_counts_from_created_at_without_triage_at(offset, expected_sends):
+    case = MagicMock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=14))
+    today = MONDAY + timedelta(days=offset)
+
+    with (
+        patch.object(scheduled, "date", _fake_date(today)),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+        patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        inspect.unwrap(_registered_job("case-close-reminder"))(
+            db_session=MagicMock(), project=MagicMock(id=1)
+        )
+
+    log_exception.assert_not_called()
+    assert send.call_count == expected_sends
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at():
+    case = MagicMock(triage_at=None, created_at=datetime.utcnow() - timedelta(days=2))
+
+    with (
+        patch.object(scheduled, "date", _fake_date(MONDAY)),
+        patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        inspect.unwrap(_registered_job("case-close-reminder"))(
+            db_session=MagicMock(), project=MagicMock(id=1)
+        )
+
+    send.assert_not_called()
