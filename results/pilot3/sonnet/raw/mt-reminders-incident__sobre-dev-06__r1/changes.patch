@@ -0,0 +1,80 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _fake_date(day):
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return FakeDate
+
+
+MONDAY = date(2025, 8, 18)
+
+
+def _task(name):
+    """Returns the undecorated function registered with the scheduler under `name`."""
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == name]
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = MONDAY + timedelta(days=offset)
+    with mock.patch.object(scheduled, "date", _fake_date(day)):
+        assert scheduled._is_reminder_day() is (offset == 0)
+
+
+@pytest.mark.parametrize("offset,expected", [(0, 1), (1, 0), (6, 0)])
+def test_case_stable_reminder_sends_only_on_monday(offset, expected):
+    case = mock.Mock(stable_at=datetime.utcnow() - timedelta(days=10))
+    day = MONDAY + timedelta(days=offset)
+    with (
+        mock.patch.object(scheduled, "date", _fake_date(day)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _task("case-stable-reminder")(db_session=mock.Mock(), project=mock.Mock(id=1))
+    assert send.call_count == expected
+
+
+@pytest.mark.parametrize("offset,expected", [(0, 1), (1, 0), (6, 0)])
+def test_case_close_reminder_sends_only_on_monday(offset, expected):
+    case = mock.Mock(status=CaseStatus.triage, triage_at=datetime.utcnow() - timedelta(days=10))
+    day = MONDAY + timedelta(days=offset)
+    with (
+        mock.patch.object(scheduled, "date", _fake_date(day)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _task("case-close-reminder")(db_session=mock.Mock(), project=mock.Mock(id=1))
+    assert send.call_count == expected
+
+
+@pytest.mark.parametrize(
+    "created_days_ago,expected", [(10, 1), (3, 0)]
+)
+def test_case_close_reminder_falls_back_to_created_at(created_days_ago, expected):
+    case = mock.Mock(
+        status=CaseStatus.triage,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=created_days_ago),
+    )
+    with (
+        mock.patch.object(scheduled, "date", _fake_date(MONDAY)),
+        mock.patch.object(scheduled, "get_all_by_status", return_value=[case]),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+        mock.patch.object(scheduled.log, "exception") as log_exception,
+    ):
+        _task("case-close-reminder")(db_session=mock.Mock(), project=mock.Mock(id=1))
+    log_exception.assert_not_called()
+    assert send.call_count == expected
