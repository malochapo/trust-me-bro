+def test_filter_actions_snooze_expired_filter_does_not_mask_valid_one(
+    session, entity, signal, project
+):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_snooze
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    now = datetime.now(timezone.utc)
+    expired_filter = SignalFilterFactory(
+        name="snooze-expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=now - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="snooze-valid",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=now + timedelta(days=30),
+        project=project,
+    )
+
+    # the expired filter comes first; it must not stop the valid one from being evaluated
+    signal.filters = [expired_filter, valid_filter]
+    session.commit()
+
+    filter_snooze(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
+
+
