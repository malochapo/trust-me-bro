+
+
+def test_find_entities_skips_masked_values(session, project):
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    signal_instance = SignalInstanceFactory(
+        raw=redact_raw(
+            {
+                "id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198",
+                "session_token": "abc123",
+                "user": {"name": "alice"},
+            }
+        )
+    )
+    assert signal_instance.raw["session_token"] == MASK
+
+    entity_types = [
+        EntityType(name="Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="User", jpath="user.name", regular_expression=None, project=project),
+    ]
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+    assert [str(e.value) for e in entities] == ["alice"]
