+def test_find_entities_skips_masked_values(session, signal_instance, project):
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    signal_instance.raw = redact_raw(
+        {"session_token": "abc123", "asset": [{"id": "a"}], "nested": {"Password": "p"}}
+    )
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", project=project),
+        EntityType(name="Any Password", jpath="$..Password", project=project),
+        EntityType(name="Asset", jpath="asset[*].id", project=project),
+    ]
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+    assert [e.value for e in entities] == ["a"]
+    assert all(e.value != MASK for e in entities)
