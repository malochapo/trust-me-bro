+def test_find_entities_skips_masked_values(session, signal_instance, project):
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    signal_instance.raw = redact_raw(
+        {"session_token": "abc123", "nested": [{"Password": "hunter2"}], "user": "alice"}
+    )
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Password", jpath="nested[*].Password", regular_expression=None, project=project),
+        EntityType(name="User", jpath="user", regular_expression=None, project=project),
+    ]
+    entities = entity_service.find_entities(session, signal_instance, entity_types)
+    values = {e.value for e in entities}
+    assert MASK not in values
+    assert values == {"alice"}
