@@ -0,0 +1,92 @@
+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+def _job_body(name):
+    """Returns the undecorated body of a registered scheduled job."""
+    fn = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    while hasattr(fn, "__wrapped__"):
+        fn = fn.__wrapped__
+    return fn
+
+
+class _FakeDate(date):
+    today_value = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls.today_value
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    _FakeDate.today_value = day
+    with patch.object(scheduled, "date", _FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+class _Case:
+    def __init__(self, status):
+        self.triage_at = datetime.utcnow() - timedelta(days=10)
+        self.stable_at = datetime.utcnow() - timedelta(days=10)
+        self.status = status
+
+
+@pytest.mark.parametrize(
+    "job_name, status, day, sends",
+    [
+        ("case-close-reminder", CaseStatus.triage, date(2025, 8, 18), True),
+        ("case-close-reminder", CaseStatus.triage, date(2025, 8, 19), False),
+        ("case-stable-reminder", CaseStatus.stable, date(2025, 8, 18), True),
+        ("case-stable-reminder", CaseStatus.stable, date(2025, 8, 19), False),
+    ],
+)
+def test_weekly_reminders_only_on_monday(job_name, status, day, sends):
+    _FakeDate.today_value = day
+    case = _Case(status)
+    fn = _job_body(job_name)
+
+    with patch.object(scheduled, "date", _FakeDate), patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), patch.object(scheduled, "send_case_close_reminder") as send:
+        fn(db_session=None, project=type("P", (), {"id": 1})())
+
+    assert send.called is sends
+
+
+@pytest.mark.parametrize(
+    "triage_at, created_days_ago, sends",
+    [
+        (None, 10, True),  # missing triage_at: count from created_at
+        (None, 3, False),
+        (datetime.utcnow() - timedelta(days=10), 1, True),  # triage_at wins over created_at
+    ],
+)
+def test_close_reminder_falls_back_to_created_at(triage_at, created_days_ago, sends):
+    _FakeDate.today_value = date(2025, 8, 18)
+    case = _Case(CaseStatus.triage)
+    case.triage_at = triage_at
+    case.created_at = datetime.utcnow() - timedelta(days=created_days_ago)
+
+    with patch.object(scheduled, "date", _FakeDate), patch.object(
+        scheduled, "get_all_by_status", return_value=[case]
+    ), patch.object(scheduled, "send_case_close_reminder") as send, patch.object(
+        scheduled.log, "exception"
+    ) as log_exception:
+        _job_body("case-close-reminder")(db_session=None, project=type("P", (), {"id": 1})())
+
+    log_exception.assert_not_called()
+    assert send.called is sends
