@@ -0,0 +1,19 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route(path, method):
+    return next(r for r in router.routes if r.path == path and method in r.methods)
+
+
+def _permission_classes(route):
+    classes = []
+    for dep in route.dependencies:
+        if isinstance(dep.dependency, PermissionsDependency):
+            classes.extend(dep.dependency.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    route = _route("/{incident_id}/event/{event_uuid}", "DELETE")
+    assert IncidentEventPermission in _permission_classes(route)
