@@ -236,3 +236,49 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snooze_counts_scoped_to_signal(session, entity, entity_type):
+    """Snooze counts with a signal_id only include filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    session.flush()
+    entity.entity_type = entity_type
+    session.flush()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    active = SignalFilter(
+        name="active",
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        expression=expression,
+        project_id=1,
+    )
+    expired = SignalFilter(
+        name="expired",
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        expression=expression,
+        project_id=1,
+    )
+    signal1.filters.append(active)
+    signal2.filters.append(expired)
+    session.commit()
+
+    def stats(signal_id=None):
+        return get_signal_stats(
+            db_session=session,
+            entity_value=entity.value,
+            entity_type_id=entity_type.id,
+            signal_id=signal_id,
+            num_days=None,
+        )
+
+    s1, s2, both = stats(signal1.id), stats(signal2.id), stats()
+    assert (s1.num_snoozes_active, s1.num_snoozes_expired) == (1, 0)
+    assert (s2.num_snoozes_active, s2.num_snoozes_expired) == (0, 1)
+    assert (both.num_snoozes_active, both.num_snoozes_expired) == (1, 1)
