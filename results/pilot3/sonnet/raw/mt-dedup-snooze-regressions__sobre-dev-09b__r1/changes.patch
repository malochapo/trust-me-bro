diff --git a/tests/signal/test_signal_service.py b/tests/signal/test_signal_service.py
index c253a7f3..b48d03fd 100644
--- a/tests/signal/test_signal_service.py
+++ b/tests/signal/test_signal_service.py
@@ -824,3 +824,112 @@ def test_canary_signals_not_deduplicated(session, signal, project):
     # Check that the canary signal instance is not deduplicated (should have same case_id as before)
     assert canary_signal_instance.case_id == initial_case_id
     assert canary_signal_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_is_in_minutes(session, signal, project):
+    """A dedup filter's window (set in minutes in the UI) must span minutes, not seconds."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        CaseFactory,
+        EntityFactory,
+        EntityTypeFactory,
+        SignalFilterFactory,
+        SignalInstanceFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    case = CaseFactory(project=project)
+    session.add(case)
+
+    # first instance opened a case ten minutes ago
+    first_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        case=case,
+        raw=json.dumps({"id": "first"}),
+    )
+    first_instance.created_at = datetime.now(timezone.utc) - timedelta(minutes=10)
+    session.add(first_instance)
+
+    second_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "second"}),
+    )
+    session.add(second_instance)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-30-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,  # minutes, as offered by the UI
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=second_instance)
+    assert second_instance.filter_action == SignalFilterAction.deduplicate
+    assert second_instance.case_id == case.id
+
+
+def test_filter_actions_snooze_expired_filter_does_not_mask_active_one(
+    session, entity, signal, project
+):
+    """An expired snooze filter must not stop later, still valid snooze filters from applying."""
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+    expired_filter = SignalFilterFactory(
+        name="snooze-expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+    active_filter = SignalFilterFactory(
+        name="snooze-active",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+
+    # the expired filter comes first
+    signal.filters = [expired_filter, active_filter]
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
