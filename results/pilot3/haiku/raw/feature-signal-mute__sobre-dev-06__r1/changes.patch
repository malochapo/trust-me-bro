+def test_filter_actions_mute(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        CaseFactory,
+        EntityFactory,
+        EntityTypeFactory,
+        SignalFilterFactory,
+        SignalInstanceFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # an existing case that a deduplicated instance would otherwise join
+    case = CaseFactory(project=project)
+    session.add(case)
+
+    # an active snooze filter with no expression, which would snooze every instance
+    snooze_filter = SignalFilterFactory(
+        project=project,
+        action="snooze",
+        expression=[],
+        expiration=datetime.now(timezone.utc) + timedelta(hours=1),
+    )
+    session.add(snooze_filter)
+    signal.filters.append(snooze_filter)
+    signal.muted_until = datetime.now(timezone.utc) + timedelta(hours=1)
+    session.add(signal)
+
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        case=case,
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_1)
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        case=None,
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert signal_instance_2.filter_action == SignalFilterAction.mute
+    assert signal_instance_2.case_id is None
+
+
+def test_filter_actions_mute_expired(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    signal.muted_until = datetime.now(timezone.utc) - timedelta(minutes=1)
+    session.add(signal)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    assert not filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.none
