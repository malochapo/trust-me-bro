+def test_create_with_reason(session, user, project):
+    from dispatch.signal.service import create_signal_filter, get_signal_filter
+    from dispatch.signal.models import SignalFilterCreate
+
+    signal_filter_in = SignalFilterCreate(
+        name="with reason",
+        expression=[{}],
+        reason="Known noisy scanner",
+        project=project,
+    )
+    signal_filter = create_signal_filter(
