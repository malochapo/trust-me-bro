+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    # the session token is masked, so only the unmasked user may become an entity
+    signal_instance.raw = {"session_token": "abc123", "user": "alice"}
+    entity_types = [
+        EntityType(
+            name="Wildcard",
+            jpath="*",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {e.value for e in entities}
+    assert values == {"alice"}
