+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # outside a 30 minute window
+    signal_instance_old = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=40),
+    )
+    session.add(signal_instance_old)
+
+    # inside a 30 minute window, ten minutes apart from the new instance
+    signal_instance_recent = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+    )
+    session.add(signal_instance_recent)
+
+    signal_instance_new = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_new)
+    session.commit()
+
+    # the UI labels filter windows in minutes
+    signal_filter = SignalFilterFactory(
+        name="dedupe-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    session.commit()
+    assert filter_signal(db_session=session, signal_instance=signal_instance_new)
+    assert signal_instance_new.filter_action == SignalFilterAction.deduplicate
+    assert signal_instance_new.case_id == signal_instance_recent.case_id
+
+
