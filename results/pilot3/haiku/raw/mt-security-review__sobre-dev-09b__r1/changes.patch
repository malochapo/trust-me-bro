@@ -0,0 +1,25 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"Route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting an incident custom event must be guarded by IncidentEventPermission."""
+    route = _get_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    guarded_permissions = [
+        permission
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission in dependency.dependency.permissions_classes
+    ]
+
+    assert IncidentEventPermission in guarded_permissions
