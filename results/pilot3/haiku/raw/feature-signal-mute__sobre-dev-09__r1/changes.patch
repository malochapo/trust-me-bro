+def test_signal_instance_create_flow_muted_signal_creates_no_case(session, signal_instance):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.case import service as case_service
+    from dispatch.signal.flows import signal_instance_create_flow
+    from dispatch.signal.models import SignalFilterAction
+
+    signal_instance.case = None
+    signal_instance.signal.muted_until = datetime.now(timezone.utc) + timedelta(hours=1)
+    session.add(signal_instance)
+    session.commit()
+
+    with mock.patch.object(case_service, "create") as mock_case_create:
+        post_flow_instance = signal_instance_create_flow(
+            signal_instance_id=signal_instance.id,
+            db_session=session,
+        )
+
+    mock_case_create.assert_not_called()
+    assert post_flow_instance.filter_action == SignalFilterAction.mute
+    assert post_flow_instance.case_id is None
