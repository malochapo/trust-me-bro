+def _create_dedupe_window_test_instances(session, signal, project, minutes_ago):
+    from datetime import datetime, timedelta, timezone
+    from tests.factories import EntityTypeFactory, EntityFactory, SignalInstanceFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # earlier instance, created minutes_ago
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_1)
+    session.commit()
+    signal_instance_1.created_at = datetime.now(timezone.utc) - timedelta(minutes=minutes_ago)
+    session.commit()
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+    return entity_type, signal_instance_2
+
+
+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    """A deduplication filter window is in minutes, as set in the UI."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalFilterFactory
+
+    entity_type, signal_instance_2 = _create_dedupe_window_test_instances(
+        session, signal, project, minutes_ago=10
+    )
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe1",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert signal_instance_2.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_outside_window_minutes(session, signal, project):
+    """An earlier instance older than the deduplication window does not deduplicate."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalFilterFactory
+
+    entity_type, signal_instance_2 = _create_dedupe_window_test_instances(
+        session, signal, project, minutes_ago=40
+    )
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe1",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    assert not filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert signal_instance_2.filter_action == SignalFilterAction.none
+
+
