+import pytest
+
+from datetime import date
+
+
+class FakeDate(date):
+    """A date whose today() returns the class's pinned day."""
+
+    pinned = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls(cls.pinned.year, cls.pinned.month, cls.pinned.day)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    from dispatch.case import scheduled
+
+    FakeDate.pinned = day
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_close_reminder(monkeypatch, session, case):
+    """Runs the case close reminder job on a Monday and returns the cases reminded."""
+    import inspect
+
+    from dispatch.case import scheduled
+    from dispatch.scheduler import scheduler
+
+    reminded = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: reminded.append(case),
+    )
+
+    # the decorators open their own sessions, so run the undecorated job body
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    job(db_session=session, project=case.project)
+    return reminded
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(monkeypatch, session, case):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    assert _run_close_reminder(monkeypatch, session, case) == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(monkeypatch, session, case):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+
+    assert _run_close_reminder(monkeypatch, session, case) == []
+
+
+def test_case_close_reminder_prefers_triage_at(monkeypatch, session, case):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+
+    case.status = CaseStatus.triage
+    case.created_at = datetime.utcnow() - timedelta(days=30)
+    case.triage_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+
+    assert _run_close_reminder(monkeypatch, session, case) == []
