diff --git a/tests/entity/test_entity_service.py b/tests/entity/test_entity_service.py
index 54251a28..283304cd 100644
--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,26 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_creates_entities_from_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {
+        "user": "alice",
+        "session_token": "tok-secret-123",
+        "password": "hunter2",
+    }
+
+    # a path naming a masked field must yield nothing, not the mask marker
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", regular_expression=None, project=project),
+    ]
+    assert find_entities(session, signal_instance, entity_types) == []
+
+    # a wildcard matching masked and unmasked fields keeps only the unmasked value
+    entity_types = [
+        EntityType(name="Any field", jpath="$.*", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [e.value for e in entities] == ["alice"]
