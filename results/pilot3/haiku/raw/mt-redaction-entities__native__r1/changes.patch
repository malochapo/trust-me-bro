+
+
+def test_find_entities_skips_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK
+
+    signal_instance.raw = {**signal_instance.raw, "session_token": "tok-123"}
+
+    # a masked field must not become an entity, even when the stored payload is unmasked
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert len(entities) == 0
+
+    # the mask itself must not become an entity either
+    values = {e.value for e in entities}
+    assert MASK not in values
+
+    # unmasked fields still produce entities
+    entity_types = [
+        EntityType(
+            name="AWS IAM Role ARN",
+            jpath="asset[0].id",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert len(entities) == 1
+    assert str(entities[0].value) == "arn:aws:iam::123456789012:role/Test"
