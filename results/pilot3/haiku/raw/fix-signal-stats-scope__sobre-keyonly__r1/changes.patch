+
+def test_get_signal_stats_snooze_counts_scoped_to_signal(session, entity, entity_type):
+    """Test that snooze counts only include filters attached to the requested signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    # Setup: Create two signals, each with its own snooze filters for the same entity
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    session.flush()
+
+    entity.entity_type = entity_type
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # signal1 has one active snooze filter
+    active_filter1 = SignalFilter(
+        name="Active Snooze 1",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        project_id=1,
+    )
+    # signal2 has two active snooze filters and one expired snooze filter
+    active_filter2 = SignalFilter(
+        name="Active Snooze 2",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        project_id=1,
+    )
+    active_filter3 = SignalFilter(
+        name="Active Snooze 3",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) + timedelta(days=2),
+        project_id=1,
+    )
+    expired_filter = SignalFilter(
+        name="Expired Snooze",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        project_id=1,
+    )
+    signal1.filters.append(active_filter1)
+    signal2.filters.extend([active_filter2, active_filter3, expired_filter])
+    session.commit()
+
+    # Execute: Stats scoped to each signal
+    signal1_data = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal1.id,
+    )
+    signal2_data = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+    )
+
+    # Execute: Stats without a signal, which should count every snooze filter
+    all_data = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+    )
+
+    # Assert: Each signal only counts its own snooze filters
+    assert signal1_data.num_snoozes_active == 1
+    assert signal1_data.num_snoozes_expired == 0
+    assert signal2_data.num_snoozes_active == 2
+    assert signal2_data.num_snoozes_expired == 1
+
+    # Assert: Without a signal, all snooze filters are counted
+    assert all_data.num_snoozes_active == 3
+    assert all_data.num_snoozes_expired == 1
