+def is_muted(signal: Signal, now: datetime | None = None) -> bool:
+    """Returns True if the signal definition is muted at the given time (default: now)."""
+    if not signal.muted_until:
+        return False
+    muted_until = signal.muted_until
+    if muted_until.tzinfo is None:
+        muted_until = muted_until.replace(tzinfo=timezone.utc)
+    now = now or datetime.now(timezone.utc)
+    return muted_until > now
+
