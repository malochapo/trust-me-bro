+def test_signal_instance_create_flow_muted_signal(session, signal, project):
+    from dispatch.case import service as case_service
+    from dispatch.signal.flows import signal_instance_create_flow
+    from dispatch.signal.models import SignalFilterAction
+    from tests.factories import SignalInstanceFactory
+    from datetime import datetime, timedelta, timezone
+
+    signal.muted_until = datetime.now(timezone.utc) + timedelta(hours=1)
+    session.commit()
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        case=None,
+        raw={"id": "foo"},
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    with mock.patch.object(case_service, "create") as mock_case_create:
+        result = signal_instance_create_flow(
+            signal_instance_id=signal_instance.id, db_session=session
