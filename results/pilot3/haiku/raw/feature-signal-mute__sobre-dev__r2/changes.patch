+def test_update__muted_until(session, project, signal):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import ProjectRead, SignalUpdate
+    from dispatch.signal.service import update
+
+    muted_until = datetime.now(timezone.utc).replace(microsecond=0) + timedelta(hours=2)
+    signal_in = SignalUpdate(
+        id=signal.id,
+        name=signal.name,
+        owner=signal.owner,
+        project=ProjectRead(
+            id=project.id,
+            name=project.name,
+            display_name=project.display_name,
+        ),
+        muted_until=muted_until,
+    )
+    update(db_session=session, signal=signal, signal_in=signal_in)
+    session.commit()
+    session.refresh(signal)
+    assert signal.muted_until == muted_until
+
+    # an explicit null in an update unmutes the signal
+    signal_in = SignalUpdate(
+        id=signal.id,
+        name=signal.name,
+        owner=signal.owner,
+        project=ProjectRead(
+            id=project.id,
+            name=project.name,
+            display_name=project.display_name,
+        ),
+        muted_until=None,
+    )
+    update(db_session=session, signal=signal, signal_in=signal_in)
+    session.commit()
+    session.refresh(signal)
+    assert signal.muted_until is None
