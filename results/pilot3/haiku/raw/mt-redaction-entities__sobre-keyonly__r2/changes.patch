@@ -322,3 +322,26 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_creates_entity_from_masked_value(session, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK
+
+    # the session token is masked by default, so a JSONPath pointing at it must not yield an entity
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    first = SignalInstanceFactory(raw={"id": "4893bde0-f8bc-4472-a7dc-8b44b26b2198", "session_token": "ghp_first"})
+    second = SignalInstanceFactory(raw={"id": "5893bde0-f8bc-4472-a7dc-8b44b26b2198", "session_token": "ghp_second"})
+
+    for instance in (first, second):
+        entities = find_entities(session, instance, entity_types)
+        assert all(e.value != MASK for e in entities)
+        assert entities == []
