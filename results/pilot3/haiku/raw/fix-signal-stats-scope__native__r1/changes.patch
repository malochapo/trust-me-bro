diff --git a/tests/signal/test_signal_stats_service.py b/tests/signal/test_signal_stats_service.py
index 34b4261d..002a32cf 100644
--- a/tests/signal/test_signal_stats_service.py
+++ b/tests/signal/test_signal_stats_service.py
@@ -236,3 +236,78 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snooze_counts_scoped_to_signal_id(
+    session, entity, entity_type, signal_filter
+):
+    """Snooze counts with a signal_id should only include snooze filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilterAction
+    from tests.factories import SignalFilterFactory
+
+    # Setup: two signals, both sharing the same entity via their filter expressions
+    signal1 = Signal(name="Snooze Signal 1", variant="snooze-signal-1", project_id=1)
+    signal2 = Signal(name="Snooze Signal 2", variant="snooze-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    session.flush()
+
+    entity.entity_type = entity_type
+    entity_expression = [
+        {"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}
+    ]
+
+    # signal1 has one active snooze filter for the entity
+    signal_filter.action = SignalFilterAction.snooze
+    signal_filter.expiration = datetime.now(timezone.utc) + timedelta(days=1)
+    signal_filter.expression = entity_expression
+    signal1.filters.append(signal_filter)
+
+    # signal2 has one active and one expired snooze filter for the entity
+    active_filter = SignalFilterFactory(
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        expression=entity_expression,
+    )
+    expired_filter = SignalFilterFactory(
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        expression=entity_expression,
+    )
+    signal2.filters.extend([active_filter, expired_filter])
+    session.commit()
+
+    # Execute: scoped to signal1
+    signal1_stats = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal1.id,
+    )
+
+    # Execute: scoped to signal2
+    signal2_stats = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+    )
+
+    # Execute: no signal_id, should count snooze filters across all signals
+    all_stats = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+    )
+
+    # Assert: signal1 only sees its own active snooze filter
+    assert signal1_stats.num_snoozes_active == 1
+    assert signal1_stats.num_snoozes_expired == 0
+
+    # Assert: signal2 only sees its own active and expired snooze filters
+    assert signal2_stats.num_snoozes_active == 1
+    assert signal2_stats.num_snoozes_expired == 1
+
+    # Assert: without signal_id, all snooze filters are counted
+    assert all_stats.num_snoozes_active == 2
+    assert all_stats.num_snoozes_expired == 1
