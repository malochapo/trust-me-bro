+
+def test_get_signal_stats_snooze_counts_scoped_to_signal_id(session, entity, entity_type):
+    """Snooze counts with a signal_id must only include snooze filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilterAction
+    from tests.factories import SignalFilterFactory
+
+    entity.entity_type = entity_type
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    signal1 = Signal(name="Snooze Signal 1", variant="snooze-signal-1", project_id=1)
+    signal2 = Signal(name="Snooze Signal 2", variant="snooze-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    session.flush()
+
+    # signal1 gets an active snooze filter, signal2 gets an expired one
+    active_filter = SignalFilterFactory(
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        expression=expression,
+    )
+    expired_filter = SignalFilterFactory(
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        expression=expression,
+    )
+    signal1.filters.append(active_filter)
+    signal2.filters.append(expired_filter)
+    session.commit()
+
+    # Without signal_id, both signals' snooze filters are counted
+    signal_data_all = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        num_days=None,
+    )
+    assert signal_data_all.num_snoozes_active == 1
+    assert signal_data_all.num_snoozes_expired == 1
+
+    # With signal_id, only the filter attached to that signal is counted
+    signal_data_signal1 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal1.id,
+        num_days=None,
+    )
+    assert signal_data_signal1.num_snoozes_active == 1
+    assert signal_data_signal1.num_snoozes_expired == 0
+
+    signal_data_signal2 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+        num_days=None,
+    )
+    assert signal_data_signal2.num_snoozes_active == 0
+    assert signal_data_signal2.num_snoozes_expired == 1
