@@ -0,0 +1,94 @@
+import inspect
+from datetime import date
+
+import pytest
+
+
+def run_case_close_reminder(session, project):
+    """Runs the raw job; the scheduled wrapper opens its own connections."""
+    from dispatch.scheduler import scheduler
+
+    job = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(job)(db_session=session, project=project)
+
+
+@pytest.fixture
+def frozen_today(monkeypatch):
+    """Pins date.today() in the case scheduler to the given date."""
+    from dispatch.case import scheduled
+
+    def _freeze(day: date):
+        class FrozenDate(date):
+            @classmethod
+            def today(cls):
+                return cls(day.year, day.month, day.day)
+
+        monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+    return _freeze
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(frozen_today, day, expected):
+    from dispatch.case.scheduled import _is_reminder_day
+
+    frozen_today(day)
+    assert _is_reminder_day() is expected
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, project, frozen_today, mocker
+):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    frozen_today(date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    # a case created directly in triage never gets a triage_at
+    case = CaseFactory(
+        project=project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    case.status = CaseStatus.triage
+    session.commit()
+
+    run_case_close_reminder(session, project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at(
+    session, project, frozen_today, mocker
+):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    frozen_today(date(2025, 8, 18))
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    # created long ago, but only triaging for a day, so no reminder yet
+    case = CaseFactory(
+        project=project,
+        triage_at=datetime.utcnow() - timedelta(days=1),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    case.status = CaseStatus.triage
+    session.commit()
+
+    run_case_close_reminder(session, project)
+
+    send.assert_not_called()
