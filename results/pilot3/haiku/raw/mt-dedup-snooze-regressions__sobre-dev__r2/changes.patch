+@pytest.mark.parametrize(
+    "window,age_minutes,expected_action",
+    [
+        (30, 10, "deduplicate"),  # 10 min ago is inside a 30 min window
+        (5, 10, "none"),  # 10 min ago is outside a 5 min window
+    ],
+)
+def test_filter_actions_deduplicate_window_is_minutes(
+    session, signal, project, window, age_minutes, expected_action
+):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    now = datetime.now(timezone.utc)
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=age_minutes),
+    )
+    session.add(earlier_instance)
+
+    later_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now,
+    )
+    session.add(later_instance)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=later_instance)
+    assert later_instance.filter_action == expected_action
+
+
