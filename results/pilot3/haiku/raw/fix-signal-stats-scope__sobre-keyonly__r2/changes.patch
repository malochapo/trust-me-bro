+
+def test_get_signal_stats_snooze_counts_scoped_to_signal(session, entity, entity_type, signal):
+    """Snooze counts for a signal id must only include snooze filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    entity.entity_type = entity_type
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # signal1 has one active snooze filter for the entity
+    signal_filter_active = SignalFilter(
+        name="Test Active Snooze",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        project_id=signal.project_id,
+    )
+    signal.filters.append(signal_filter_active)
+
+    # signal2 has one active and one expired snooze filter for the same entity
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=signal.project_id)
+    signal_filter_other_active = SignalFilter(
+        name="Test Other Active Snooze",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        project_id=signal.project_id,
+    )
+    signal_filter_other_expired = SignalFilter(
+        name="Test Other Expired Snooze",
+        action=SignalFilterAction.snooze,
+        expression=expression,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        project_id=signal.project_id,
+    )
+    signal2.filters.extend([signal_filter_other_active, signal_filter_other_expired])
+    session.add(signal2)
+    session.commit()
+
+    # Scoped to signal1: only its own active snooze filter counts
+    signal_data_signal1 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal.id,
+    )
+    assert signal_data_signal1.num_snoozes_active == 1
+    assert signal_data_signal1.num_snoozes_expired == 0
+
+    # Scoped to signal2: its active and expired snooze filters count
+    signal_data_signal2 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+    )
+    assert signal_data_signal2.num_snoozes_active == 1
+    assert signal_data_signal2.num_snoozes_expired == 1
+
+    # Unscoped: every signal's snooze filters count
+    signal_data_all = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+    )
+    assert signal_data_all.num_snoozes_active == 2
+    assert signal_data_all.num_snoozes_expired == 1
