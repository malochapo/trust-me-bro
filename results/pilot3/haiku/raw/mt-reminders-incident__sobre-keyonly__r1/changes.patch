@@ -0,0 +1,74 @@
+import inspect
+from datetime import date as real_date, datetime
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FakeDate(real_date):
+    _today = real_date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (real_date(2025, 8, 18), True),  # Monday
+        (real_date(2025, 8, 19), False),  # Tuesday
+        (real_date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    FakeDate._today = day
+    with mock.patch.object(scheduled, "date", FakeDate):
+        assert scheduled._is_reminder_day() is expected
+
+
+def run_case_close_reminder(db_session, project):
+    # the scheduler wraps the job, so we call the innermost function directly
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(db_session=db_session, project=project)
+
+
+class FakeDatetime(datetime):
+    @classmethod
+    def utcnow(cls):
+        return datetime(2025, 8, 18, 12, 0)
+
+
+@pytest.fixture
+def monday(monkeypatch):
+    FakeDate._today = real_date(2025, 8, 18)
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+    monkeypatch.setattr(scheduled, "datetime", FakeDatetime)
+
+
+def test_case_close_reminder_without_triage_at_counts_from_created_at(session, case, monday):
+    case.status = CaseStatus.triage.value
+    case.triage_at = None
+    case.created_at = datetime(2025, 8, 1)
+    session.commit()
+
+    with mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        run_case_close_reminder(db_session=session, project=case.project)
+
+    send.assert_called_once_with(case, session)
+
+
+def test_case_close_reminder_without_triage_at_skips_recent_case(session, case, monday):
+    case.status = CaseStatus.triage.value
+    case.triage_at = None
+    case.created_at = datetime(2025, 8, 15)
+    session.commit()
+
+    with mock.patch.object(scheduled, "send_case_close_reminder") as send:
+        run_case_close_reminder(db_session=session, project=case.project)
+
+    send.assert_not_called()
