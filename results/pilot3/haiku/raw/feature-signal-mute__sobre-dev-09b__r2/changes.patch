+def filter_mute(*, db_session: Session, signal_instance: SignalInstance) -> SignalInstance:
+    """
+    Apply the mute action to the signal instance if its signal definition is muted.
+
+    Args:
+        db_session (Session): Database session.
+        signal_instance (SignalInstance): Signal instance to be filtered.
+
+    Returns:
+        SignalInstance: The filtered signal instance.
+    """
+    muted_until = signal_instance.signal.muted_until
+    if not muted_until:
+        return signal_instance
+
+    if muted_until.tzinfo is None:
+        muted_until = muted_until.replace(tzinfo=timezone.utc)
+
+    if muted_until > datetime.now(timezone.utc):
+        signal_instance.filter_action = SignalFilterAction.mute
+
+    return signal_instance
+
