+def test_filter_actions_mute(session, entity, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory, SignalFilterFactory
+
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    # a snooze that would match this instance, it must not be evaluated while muted
+    signal_filter = SignalFilterFactory(
+        name="snooze-while-muted",
+        description="test",
+        expression=[{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}],
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(minutes=5),
+        project=project,
+    )
+    signal.filters = [signal_filter]
+    signal.muted_until = datetime.now(timezone.utc) + timedelta(minutes=5)
+    session.commit()
+
+    case_id = signal_instance.case_id
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.mute
+    assert signal_instance.case_id == case_id
+
+
+def test_filter_actions_mute_expired(session, entity, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import SignalInstanceFactory
+
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    signal.muted_until = datetime.now(timezone.utc) - timedelta(minutes=5)
+    session.commit()
+
+    # the mute has ended, so the instance is processed normally and is not filtered
+    assert not filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.none
