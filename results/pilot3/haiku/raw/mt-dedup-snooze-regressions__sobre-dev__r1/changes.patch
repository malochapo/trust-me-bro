+def test_filter_window_is_in_minutes(session, signal, project):
+    """A dedup filter's window is entered in minutes in the UI and must be applied as minutes."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # previous instance ten minutes old, inside a 30 minute window
+    recent_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=10),
+        raw=json.dumps({"id": "recent"}),
+    )
+    session.add(recent_instance)
+
+    # previous instance forty minutes old, outside a 30 minute window
+    old_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=40),
+        raw=json.dumps({"id": "old"}),
+    )
+    session.add(old_instance)
+
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "new"}),
+    )
+    session.add(new_instance)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe30",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    # only the ten minute old instance is inside the window, so the new instance is deduplicated
+    assert filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == SignalFilterAction.deduplicate
+
+    # with only the forty minute old instance in range, nothing is deduplicated
+    session.delete(recent_instance)
+    session.commit()
+    new_instance.filter_action = None
+    new_instance.case_id = None
+    session.commit()
+
+    assert not filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_snooze_after_expired_snooze(session, entity, signal, project):
+    """An expired snooze filter must not stop evaluation of later active snooze filters."""
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # expired last week, listed first
+    expired_filter = SignalFilterFactory(
+        name="snooze_expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+
+    # valid until next month, listed second
+    valid_filter = SignalFilterFactory(
+        name="snooze_valid",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+
+    signal.filters = [expired_filter, valid_filter]
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
