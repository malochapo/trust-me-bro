+def test_update_muted_until(session, project, signal):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.project.models import ProjectRead
+    from dispatch.signal.models import SignalUpdate
+    from dispatch.signal.service import update
+
+    def _update(muted_until):
+        signal_in = SignalUpdate(
+            id=signal.id,
+            name=signal.name,
+            owner=signal.owner,
+            project=ProjectRead.from_orm(project),
+            muted_until=muted_until,
+        )
+        return update(db_session=session, signal=signal, signal_in=signal_in)
+
+    muted_until = datetime.now(timezone.utc) + timedelta(hours=1)
+    assert _update(muted_until).muted_until == muted_until
+
+    # an explicit null unmutes the signal definition
+    assert _update(None).muted_until is None
+
