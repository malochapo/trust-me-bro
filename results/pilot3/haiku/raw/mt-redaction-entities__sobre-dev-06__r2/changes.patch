diff --git a/tests/entity/test_entity_service.py b/tests/entity/test_entity_service.py
index 54251a28..98c888cd 100644
--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,29 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_ignores_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import redact_raw
+
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    # the token is masked before extraction, so no entity should be created from it
+    signal_instance.raw = redact_raw({"session_token": "ghp_first"})
+    assert find_entities(session, signal_instance, entity_types) == []
+
+    signal_instance.raw = redact_raw({"session_token": "ghp_second"})
+    assert find_entities(session, signal_instance, entity_types) == []
+
+    # an unmasked value under the same path is still extracted
+    signal_instance.raw = {"session_token": "ghp_third"}
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [str(entity.value) for entity in entities] == ["ghp_third"]
