@@ -236,3 +236,69 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snooze_counts_scoped_to_signal_id(session, entity, entity_type):
+    """Test that snooze filter counts with a signal_id only include that signal's filters."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction
+
+    # Setup: Two signals, each with its own active snooze filter matching the same entity
+    entity.entity_type = entity_type
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    session.add_all([signal1, signal2])
+    session.flush()
+
+    active_expiration = datetime.now(timezone.utc) + timedelta(days=1)
+    signal_filter1 = SignalFilter(
+        name="Test Snooze Filter 1",
+        action=SignalFilterAction.snooze,
+        expiration=active_expiration,
+        expression=expression,
+        project_id=1,
+    )
+    signal_filter2 = SignalFilter(
+        name="Test Snooze Filter 2",
+        action=SignalFilterAction.snooze,
+        expiration=active_expiration,
+        expression=expression,
+        project_id=1,
+    )
+    signal1.filters.append(signal_filter1)
+    signal2.filters.append(signal_filter2)
+    session.commit()
+
+    # Execute: Count snoozes for all signals and for each signal individually
+    signal_data_all = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        num_days=None,
+    )
+    signal_data_signal1 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal1.id,
+        num_days=None,
+    )
+    signal_data_signal2 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+        num_days=None,
+    )
+
+    # Assert: Without signal_id, both signals' snooze filters are counted
+    assert signal_data_all.num_snoozes_active == 2
+    assert signal_data_all.num_snoozes_expired == 0
+
+    # Assert: With signal_id, only that signal's snooze filter is counted
+    assert signal_data_signal1.num_snoozes_active == 1
+    assert signal_data_signal1.num_snoozes_expired == 0
+    assert signal_data_signal2.num_snoozes_active == 1
+    assert signal_data_signal2.num_snoozes_expired == 0
