@@ -0,0 +1,75 @@
+import inspect
+from datetime import date
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    _today = None
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),  # Wednesday
+        (date(2025, 8, 14), False),  # Thursday
+        (date(2025, 8, 15), False),  # Friday
+        (date(2025, 8, 16), False),  # Saturday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _FakeDate._today = day
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_close_reminder_falls_back_to_created_at(monkeypatch, session, project):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    # a case in triage with no triage_at, created 8 days ago
+    old_case = CaseFactory(
+        project=project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    # a case in triage with no triage_at, created today
+    new_case = CaseFactory(
+        project=project,
+        triage_at=None,
+        created_at=datetime.utcnow(),
+    )
+    for case in (old_case, new_case):
+        case.status = CaseStatus.triage
+    session.commit()
+
+    _FakeDate._today = date(2025, 8, 11)  # Monday
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+    sent = []
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+
+    # the scheduler decorator registers the job and returns None, so look it up by name
+    # and unwrap the decorators to call it with the test session
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    job = inspect.unwrap(task["func"])
+    job(db_session=session, project=project)
+
+    assert sent == [old_case.id]
+    assert new_case.id not in sent
