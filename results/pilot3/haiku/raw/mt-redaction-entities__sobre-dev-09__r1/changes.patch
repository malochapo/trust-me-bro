+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import redact_raw
+
+    # the session token is masked before entity extraction runs
+    signal_instance.raw = redact_raw({"session_token": "ghp_abc123", "user": "alice"})
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {e.value for e in entities}
+    assert "[REDACTED]" not in values
+    assert values == {"alice"}
