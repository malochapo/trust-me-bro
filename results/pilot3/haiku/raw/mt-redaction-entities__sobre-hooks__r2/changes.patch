+    from dispatch.entity.service import find_entities
+
+    # the session token is masked (its key is in SIGNAL_REDACTED_RAW_FIELDS), so it must not become an entity
+    signal_instance.raw = {"session_token": "ghp_secret_one", "user": {"name": "alice"}}
+    entity_types = [
