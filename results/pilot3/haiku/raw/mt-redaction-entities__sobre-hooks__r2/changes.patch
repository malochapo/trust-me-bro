+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+    # unmasked values are still extracted from the same payload
+    entity_types = [
+        EntityType(
+            name="User Name",
+            jpath="user.name",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [str(e.value) for e in entities] == ["alice"]
