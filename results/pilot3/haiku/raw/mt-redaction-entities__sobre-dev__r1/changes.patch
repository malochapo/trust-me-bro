+
+
+def test_find_entities_never_creates_entities_from_masked_values(session, project):
+    from dispatch.entity.service import find_entities
+
+    # the session token is masked, the username is not
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "session_token": "ghp_secret",
+            "user": "octocat",
+            "events": [{"session_token": "ghp_other_secret"}],
+        }
+    )
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Event Session Token",
+            jpath="events[*].session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {e.value for e in entities}
+    assert values == {"octocat"}
+    assert "[REDACTED]" not in values
