+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (11, True),  # Monday
+        (12, False),
+        (13, False),
+        (14, False),
+        (15, False),
+        (16, False),
+        (17, False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class PinnedDate(date):
+        @classmethod
+        def today(cls):
+            return cls(2025, 8, day)
+
+    monkeypatch.setattr(scheduled, "date", PinnedDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+@pytest.fixture
+def close_reminder_job(monkeypatch):
+    """Runs case_close_reminder's undecorated body on a Monday, recording sent reminders."""
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+    # the scheduler decorator returns None, so the job is looked up by its registered name
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    job = inspect.unwrap(task["func"])
+    return job, sent
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    session, close_reminder_job
+):
+    job, sent = close_reminder_job
+    case = CaseFactory(
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    case.status = CaseStatus.triage  # the factory's status param doesn't reach the model
+    session.commit()
+
+    job(db_session=session, project=case.project)
+
+    assert sent == [case.id]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, close_reminder_job):
+    job, sent = close_reminder_job
+    case = CaseFactory(
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+    case.status = CaseStatus.triage  # the factory's status param doesn't reach the model
+    session.commit()
+
+    job(db_session=session, project=case.project)
+
+    assert sent == []
+
+
+def test_case_close_reminder_counts_from_triage_at_when_set(session, close_reminder_job):
+    job, sent = close_reminder_job
+    case = CaseFactory(
+        triage_at=datetime.utcnow() - timedelta(days=8),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+    case.status = CaseStatus.triage  # the factory's status param doesn't reach the model
+    session.commit()
+
+    job(db_session=session, project=case.project)
+
+    assert sent == [case.id]
