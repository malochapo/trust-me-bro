+
+
+def test_find_entities_never_extracts_masked_values(session, project):
+    from dispatch.signal.redaction import MASK
+
+    entity_type = EntityType(
+        name="Session Token",
+        jpath="session_token",
+        regular_expression=None,
+        project=project,
+    )
+
+    # not yet processed: the stored payload still holds the real token
+    unprocessed = SignalInstanceFactory(raw={"session_token": "ghp_secret123"})
+    entities = entity_service.find_entities(session, unprocessed, [entity_type])
+    assert len(entities) == 0
+
+    # already processed: the flow has masked the token in the payload
+    processed = SignalInstanceFactory(raw={"session_token": MASK})
+    entities = entity_service.find_entities(session, processed, [entity_type])
+    assert len(entities) == 0
