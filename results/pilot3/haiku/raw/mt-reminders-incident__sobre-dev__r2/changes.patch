+import inspect
+
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),  # Saturday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FrozenDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_case_close_reminder(monkeypatch, session, project):
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+
+    # the scheduler wrappers open their own database session, so we call the job body directly
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(db_session=session, project=project)
+    return sent
+
+
+def _triage_case(session, project, **fields):
+    # CaseFactory's Params override a status kwarg, so we set the status after creating the case
+    case = CaseFactory(project=project, **fields)
+    case.status = CaseStatus.triage
+    session.add(case)
+    session.commit()
+    return case
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(
+    monkeypatch, session, project
+):
+    case = _triage_case(
+        session,
+        project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == [case.id]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(monkeypatch, session, project):
+    _triage_case(
+        session,
+        project,
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == []
+
+
+def test_case_close_reminder_counts_from_triage_at_when_set(monkeypatch, session, project):
+    # created long ago, but moved to triage recently, so no reminder yet
+    _triage_case(
+        session,
+        project,
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+    )
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == []
