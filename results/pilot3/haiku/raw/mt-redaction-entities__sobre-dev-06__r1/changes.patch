diff --git a/tests/entity/test_entity_service.py b/tests/entity/test_entity_service.py
index 54251a28..ab0897da 100644
--- a/tests/entity/test_entity_service.py
+++ b/tests/entity/test_entity_service.py
@@ -322,3 +322,44 @@ def test_find_entities_multiple_entity_types(session, signal_instance, project):
     values = {getattr(e, "value", None) for e in entities if hasattr(e, "value") and isinstance(e.value, str)}
     assert "arn:aws:iam::123456789012:role/Test" in values
     assert "arn:aws:s3:::ap-northeast-3-123456789012-s3-server-access-logs" in values
+
+
+def test_find_entities_never_returns_masked_values(session, project):
+    from dispatch.entity.service import find_entities
+
+    # the session token sits under a masked key, so it must not become an entity
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "session_token": "ghp_real_token_123",
+            "credentials": [{"session_token": "ghp_other_token_456", "user": "alice"}],
+            "user": "bob",
+        }
+    )
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Nested session token",
+            jpath="credentials[*].session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+    # unmasked fields are still extracted
+    entity_types = [
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [str(e.value) for e in entities] == ["bob"]
