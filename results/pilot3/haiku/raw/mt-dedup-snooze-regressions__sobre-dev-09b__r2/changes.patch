+@pytest.mark.parametrize(
+    "prior_minutes_ago, expected_action",
+    [
+        # inside a 30 minute window
+        (10, "deduplicate"),
+        # outside a 30 minute window
+        (45, "none"),
+    ],
+)
+def test_filter_actions_deduplicate_window_is_minutes(
+    session, signal, project, prior_minutes_ago, expected_action
+):
+    from datetime import datetime, timedelta
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the UI stores the window in minutes, so 30 means a 30 minute lookback
+    signal_filter = SignalFilterFactory(
+        name="dedupe-minutes",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    prior_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now() - timedelta(minutes=prior_minutes_ago),
+    )
+    session.add(prior_instance)
+    session.commit()
+
+    new_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(new_instance)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=new_instance)
+    assert new_instance.filter_action == expected_action
+
+
