@@ -236,3 +236,74 @@ def test_get_signal_stats_with_signal_id_filter(session, entity, entity_type):
         + signal_data_signal2.num_signal_instances_snoozed
         == 2
     )
+
+
+def test_get_signal_stats_snooze_counts_scoped_to_signal_id(session, entity, entity_type):
+    """Snooze counts with a signal_id only include snooze filters attached to that signal."""
+    from dispatch.signal.service import get_signal_stats
+    from dispatch.signal.models import Signal, SignalFilter, SignalFilterAction, SignalInstance
+
+    entity.entity_type = entity_type
+    expression = [
+        {"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}
+    ]
+
+    # signal1 has an active snooze filter, signal2 has an expired snooze filter,
+    # both matching the same entity
+    signal1 = Signal(name="Test Signal 1", variant="test-signal-1", project_id=1)
+    signal2 = Signal(name="Test Signal 2", variant="test-signal-2", project_id=1)
+    active_filter = SignalFilter(
+        name="active snooze",
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) + timedelta(days=1),
+        expression=expression,
+        project_id=1,
+    )
+    expired_filter = SignalFilter(
+        name="expired snooze",
+        action=SignalFilterAction.snooze,
+        expiration=datetime.now(timezone.utc) - timedelta(days=1),
+        expression=expression,
+        project_id=1,
+    )
+    signal1.filters.append(active_filter)
+    signal2.filters.append(expired_filter)
+
+    signal_instance1 = SignalInstance(signal=signal1, project_id=1)
+    signal_instance1.entities.append(entity)
+    signal_instance2 = SignalInstance(signal=signal2, project_id=1)
+    signal_instance2.entities.append(entity)
+
+    session.add_all([signal1, signal2, signal_instance1, signal_instance2])
+    session.commit()
+
+    # Without signal_id, both snooze filters are counted
+    signal_data_all = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        num_days=None,
+    )
+    assert signal_data_all.num_snoozes_active == 1
+    assert signal_data_all.num_snoozes_expired == 1
+
+    # With signal_id, only the filters attached to that signal are counted
+    signal_data_signal1 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal1.id,
+        num_days=None,
+    )
+    assert signal_data_signal1.num_snoozes_active == 1
+    assert signal_data_signal1.num_snoozes_expired == 0
+
+    signal_data_signal2 = get_signal_stats(
+        db_session=session,
+        entity_value=entity.value,
+        entity_type_id=entity_type.id,
+        signal_id=signal2.id,
+        num_days=None,
+    )
+    assert signal_data_signal2.num_snoozes_active == 0
+    assert signal_data_signal2.num_snoozes_expired == 1
