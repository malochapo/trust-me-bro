+def test_create_signal_with_muted_until(session, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalCreate
+    from dispatch.signal.service import create, get
+    from dispatch.project.models import ProjectRead
+
+    muted_until = datetime.now(timezone.utc) + timedelta(hours=1)
+    signal_in = SignalCreate(
+        name="muted signal",
+        owner="owner@example.com",
+        variant="muted variant",
+        external_id="muted-1",
+        project=ProjectRead(name=project.name, id=project.id, description=None, color=None),
+        muted_until=muted_until,
+    )
+    signal = create(db_session=session, signal_in=signal_in)
+    session.commit()
+
+    assert get(db_session=session, signal_id=signal.id).muted_until is not None
