+def is_muted(signal: Signal) -> bool:
+    """Returns True if the signal definition is muted at the current time."""
+    if not signal.muted_until:
+        return False
+
+    # muted_until is stored as a naive UTC datetime, the same as filter expiration
+    return signal.muted_until.replace(tzinfo=timezone.utc) > datetime.now(timezone.utc)
