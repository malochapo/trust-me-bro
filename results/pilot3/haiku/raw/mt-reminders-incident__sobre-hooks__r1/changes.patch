@@ -0,0 +1,93 @@
+from datetime import date as real_date
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (real_date(2025, 8, 18), True),  # Monday
+        (real_date(2025, 8, 19), False),  # Tuesday
+        (real_date(2025, 8, 20), False),  # Wednesday
+        (real_date(2025, 8, 21), False),  # Thursday
+        (real_date(2025, 8, 22), False),  # Friday
+        (real_date(2025, 8, 23), False),  # Saturday
+        (real_date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    from dispatch.case import scheduled
+
+    class FakeDate(real_date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_case_close_reminder(monkeypatch, session, project):
+    import inspect
+
+    from dispatch.case import scheduled
+    from dispatch.scheduler import scheduler
+
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+
+    # the decorator registers the job with the scheduler, so we look it up there and
+    # unwrap the timer and project context decorators to call it directly
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    inspect.unwrap(task["func"])(session, project)
+    return sent
+
+
+def test_case_close_reminder_counts_from_triage_at(monkeypatch, session, project):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    case.created_at = datetime.utcnow() - timedelta(days=30)
+    session.commit()
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == [case]
+
+
+def test_case_close_reminder_falls_back_to_created_at(monkeypatch, session, project):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    # triage_at is missing, so the reminder should count from when the case was created
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(monkeypatch, session, project):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+
+    assert _run_case_close_reminder(monkeypatch, session, project) == []
