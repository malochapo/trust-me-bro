+def test_signal_muted_until_is_stored_as_naive_utc():
+    from datetime import datetime
+    from dispatch.signal.models import SignalCreate, SignalUpdate
+
+    base = {"name": "signal", "owner": "owner", "project": {"name": "project"}}
+
+    assert SignalCreate(**base).muted_until is None
+    assert SignalCreate(**base, muted_until="2026-10-11T12:00:00Z").muted_until == datetime(
+        2026, 10, 11, 12
+    )
+    assert SignalCreate(**base, muted_until="2026-10-11T14:00:00+02:00").muted_until == datetime(
+        2026, 10, 11, 12
+    )
+
+    # an explicit null clears the mute, while an omitted field leaves it unchanged
+    update = SignalUpdate(id=1, muted_until=None, **base)
+    assert update.model_dump(exclude_unset=True)["muted_until"] is None
+    assert "muted_until" not in SignalUpdate(id=1, **base).model_dump(exclude_unset=True)
