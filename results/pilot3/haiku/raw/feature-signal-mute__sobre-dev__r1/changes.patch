+def test_update_muted_until_round_trip(session, project, signal):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import ProjectRead, SignalRead, SignalUpdate
+    from dispatch.signal.service import update
+
+    muted_until = datetime.now(timezone.utc).replace(microsecond=0) + timedelta(hours=1)
+
+    signal_in = SignalUpdate(
+        id=signal.id,
+        name=signal.name,
+        owner=signal.owner,
+        project=ProjectRead.from_orm(project),
+        muted_until=muted_until,
+    )
+    signal = update(db_session=session, signal=signal, signal_in=signal_in)
+
+    signal_read = SignalRead.from_orm(signal)
+    assert signal_read.muted_until.replace(tzinfo=timezone.utc) == muted_until
+
+    # sending null clears the mute
+    signal_in = SignalUpdate(
+        id=signal.id,
+        name=signal.name,
+        owner=signal.owner,
+        project=ProjectRead.from_orm(project),
+        muted_until=None,
+    )
+    signal = update(db_session=session, signal=signal, signal_in=signal_in)
+    assert SignalRead.from_orm(signal).muted_until is None
