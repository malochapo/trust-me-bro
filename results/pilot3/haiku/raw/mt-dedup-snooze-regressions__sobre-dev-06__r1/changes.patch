+def _deduplicate_window_filter_setup(session, signal, project, minutes_apart, window):
+    """Creates two instances for the same entity, minutes_apart apart, and a dedup filter."""
+    from datetime import datetime, timedelta, timezone
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.now(timezone.utc)
+    earlier_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        created_at=now - timedelta(minutes=minutes_apart),
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(earlier_instance)
+
+    later_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        created_at=now,
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(later_instance)
+    session.commit()
+
+    # the UI stores the window in minutes
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    return later_instance
+
+
+def test_filter_actions_deduplicate_within_window_minutes(session, signal, project):
+    """A dedup window of 30 (minutes) groups instances 10 minutes apart."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    later_instance = _deduplicate_window_filter_setup(
+        session, signal, project, minutes_apart=10, window=30
+    )
+
+    assert filter_signal(db_session=session, signal_instance=later_instance)
+    assert later_instance.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_outside_window_minutes(session, signal, project):
+    """A dedup window of 30 (minutes) does not group instances 40 minutes apart."""
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    later_instance = _deduplicate_window_filter_setup(
+        session, signal, project, minutes_apart=40, window=30
+    )
+
+    assert not filter_signal(db_session=session, signal_instance=later_instance)
+    assert later_instance.filter_action == SignalFilterAction.none
