diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..dbe97f58
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,30 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_masked_value_is_not_extracted_as_entity(session, signal_instance, project):
+    # the flow masks raw before extracting entities, so the JSONPath below reads MASK
+    signal_instance.raw = redact_raw({"session_token": "ghp_secret", "user": "alice"})
+
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+
+def test_unmasked_value_still_extracted_next_to_masked_one(session, signal_instance, project):
+    signal_instance.raw = redact_raw({"session_token": "ghp_secret", "email": "alice@example.com"})
+
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Email", jpath="email", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [e.value for e in entities] == ["alice@example.com"]
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..295ed622
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting a custom incident event must be guarded by IncidentEventPermission."""
+    routes = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_classes = [
+        permission_class
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in permission_classes
