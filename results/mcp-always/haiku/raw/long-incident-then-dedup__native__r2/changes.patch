@@ -0,0 +1,113 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+from tests.factories import CaseFactory
+
+
+def _patch_today(day: date):
+    """Pins date.today() in the scheduled module to the given day."""
+
+    class FrozenDate(date):
+        @classmethod
+        def today(cls):
+            return day
+
+    return mock.patch.object(scheduled, "date", FrozenDate)
+
+
+def _task(name: str):
+    """Returns the undecorated task function registered under name, so it can run without the scheduler."""
+    registered = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(registered["func"])
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 17), False),  # Sunday
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+    ],
+)
+def test_is_reminder_day(day, expected):
+    with _patch_today(day):
+        assert _is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "day, expected_calls",
+    [
+        (date(2025, 8, 18), 1),  # Monday: long-running triage case gets a reminder
+        (date(2025, 8, 19), 0),  # Tuesday: no reminder
+    ],
+)
+def test_case_close_reminder_only_on_mondays(session, project, day, expected_calls):
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    with (
+        _patch_today(day),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _task("case-close-reminder")(db_session=session, project=project)
+
+    assert send.call_count == expected_calls
+
+
+@pytest.mark.parametrize(
+    "day, expected_calls",
+    [
+        (date(2025, 8, 18), 1),  # Monday: long-running stable case gets a reminder
+        (date(2025, 8, 19), 0),  # Tuesday: no reminder
+    ],
+)
+def test_case_stable_reminder_only_on_mondays(session, project, day, expected_calls):
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    with (
+        _patch_today(day),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _task("case-stable-reminder")(db_session=session, project=project)
+
+    assert send.call_count == expected_calls
+
+
+@pytest.mark.parametrize(
+    "created_days_ago, expected_calls",
+    [
+        (8, 1),  # old enough to count a full week from creation
+        (3, 0),  # not yet a week old
+    ],
+)
+def test_case_close_reminder_falls_back_to_created_at(
+    session, project, created_days_ago, expected_calls
+):
+    case = CaseFactory(project=project)
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=created_days_ago)
+    session.add(case)
+    session.commit()
+
+    with (
+        _patch_today(date(2025, 8, 18)),
+        mock.patch.object(scheduled, "send_case_close_reminder") as send,
+    ):
+        _task("case-close-reminder")(db_session=session, project=project)
+
+    assert send.call_count == expected_calls
