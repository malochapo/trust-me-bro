diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..5b29ad6a
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,44 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_masked_value_is_never_extracted_as_entity(session, signal_instance, project):
+    """A JSONPath aimed at a masked key must not turn the placeholder into an entity.
+
+    Otherwise every instance gets the same "[REDACTED]" entity and deduplication
+    groups unrelated instances into one case.
+    """
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    # the flow masks the payload before entities are extracted from it
+    signal_instance.raw = redact_raw({"session_token": "abc123"})
+    assert signal_instance.raw["session_token"] == MASK
+
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+
+def test_unmasked_value_is_still_extracted_as_entity(session, signal_instance, project):
+    """Control: the same entity type still extracts a value that was not masked."""
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    signal_instance.raw = {"session_token": "abc123"}
+
+    entities = find_entities(session, signal_instance, entity_types)
+    assert len(entities) == 1
+    assert entities[0].value == "abc123"
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..8d2c1a98
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,23 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def get_route_permissions(method: str, path: str) -> list:
+    """Returns the permission classes declared on the matching incident route."""
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            permissions = []
+            for dependency in route.dependencies:
+                if isinstance(dependency.dependency, PermissionsDependency):
+                    permissions.extend(dependency.dependency.permissions_classes)
+            return permissions
+    raise AssertionError(f"Route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission.
+
+    This guards against the check being dropped again (see commit 28c21e1e).
+    """
+    permissions = get_route_permissions("DELETE", "/{incident_id}/event/{event_uuid}")
+    assert IncidentEventPermission in permissions
