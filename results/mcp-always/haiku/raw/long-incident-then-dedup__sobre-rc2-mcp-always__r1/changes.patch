+++ b/tests/signal/test_signal_dedup_window.py
@@ -0,0 +1,79 @@
+import json
+from datetime import datetime, timedelta
+
+
+def _setup_deduplicate_filter(session, signal, project, case, minutes_ago, window):
+    from dispatch.signal.models import SignalFilterAction
+    from tests.factories import (
+        EntityFactory,
+        EntityTypeFactory,
+        SignalFilterFactory,
+        SignalInstanceFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the earlier instance already opened a case
+    earlier = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.utcnow() - timedelta(minutes=minutes_ago),
+        case=case,
+    )
+    session.add(earlier)
+
+    signal_filter = SignalFilterFactory(
+        name="test",
+        description="dedupe window",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action=SignalFilterAction.deduplicate,
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    new = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        case=None,
+    )
+    session.add(new)
+    session.commit()
+    return new
+
+
+def test_deduplicate_window_is_in_minutes(session, signal, project, case):
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    # a 30 minute window (as set in the UI) still groups instances ten minutes apart
+    new = _setup_deduplicate_filter(
+        session, signal, project, case, minutes_ago=10, window=30
+    )
+
+    assert filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.deduplicate
+    assert new.case_id == case.id
+
+
+def test_deduplicate_window_excludes_instances_outside_it(session, signal, project, case):
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+
+    # the earlier instance is 40 minutes old, outside a 30 minute window
+    new = _setup_deduplicate_filter(
+        session, signal, project, case, minutes_ago=40, window=30
+    )
+
+    filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.none
