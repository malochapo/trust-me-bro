diff --git a/tests/case/test_case_scheduled.py b/tests/case/test_case_scheduled.py
new file mode 100644
index 00000000..417d6ac5
--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,81 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(mocker, today, expected):
+    mocked_date = mocker.patch("dispatch.case.scheduled.date")
+    mocked_date.today.return_value = today
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_case_close_reminder(db_session, project):
+    # the registered task loops over every organization and project, so
+    # unwrap it to the job body and run it against this project only
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    inspect.unwrap(task["func"])(db_session=db_session, project=project)
+
+
+def test_case_close_reminder_without_triage_at_uses_created_at(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+    session.refresh(case)
+
+    _run_case_close_reminder(session, case.project)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_without_triage_at_skips_recent_case(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+    session.refresh(case)
+
+    _run_case_close_reminder(session, case.project)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_uses_triage_at_when_set(mocker, session, case):
+    mocker.patch("dispatch.case.scheduled.date").today.return_value = date(2025, 8, 18)
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    case.status = CaseStatus.triage
+    case.created_at = datetime.utcnow() - timedelta(days=30)
+    case.triage_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+    session.refresh(case)
+
+    _run_case_close_reminder(session, case.project)
+
+    # triage_at is recent, so the case is not reminded even though it was created long ago
+    send.assert_not_called()
