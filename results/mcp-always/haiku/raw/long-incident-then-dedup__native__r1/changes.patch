+from datetime import date as real_date
+
+import pytest
+
+
+@pytest.mark.parametrize("days_after_monday", range(7))
+def test_is_reminder_day_only_on_monday(monkeypatch, days_after_monday):
+    from dispatch.case import scheduled
+
+    # 2025-08-11 is a Monday, so pin "today" to each day of that week in turn
+    today = real_date.fromordinal(real_date(2025, 8, 11).toordinal() + days_after_monday)
+
+    class PinnedDate(real_date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", PinnedDate)
+
+    assert scheduled._is_reminder_day() is (days_after_monday == 0)
+
+
+def _run_case_close_reminder(monkeypatch, session, case):
+    import inspect
+
+    from dispatch.case import scheduled
+
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case.id)
+    )
+
+    # the scheduler decorator doesn't return the function, so look the job up by name and
+    # unwrap the timer and project-context decorators to run the job body directly
+    from dispatch.scheduler import scheduler
+
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(task["func"])(db_session=session, project=case.project)
+    return sent
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(monkeypatch, session):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=8),
+    )
+    # CaseFactory pins status to New, so set the triage status after creation
+    case.status = CaseStatus.triage
+    session.commit()
+
+    assert _run_case_close_reminder(monkeypatch, session, case) == [case.id]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(monkeypatch, session):
+    from datetime import datetime, timedelta
+
+    from dispatch.case.enums import CaseStatus
+    from tests.factories import CaseFactory
+
+    case = CaseFactory(
+        triage_at=None,
+        created_at=datetime.utcnow() - timedelta(days=2),
+    )
+    # CaseFactory pins status to New, so set the triage status after creation
+    case.status = CaseStatus.triage
+    session.commit()
+
+    assert _run_case_close_reminder(monkeypatch, session, case) == []
+
+
+def test_case_close_reminder_prefers_triage_at_when_set(monkeypatch, session):
+    from datetime import datetime, timedelta
+
