+def _create_deduplicate_filter_test_instances(session, signal, project, created_at_offset):
+    from datetime import datetime, timedelta, timezone
+
+    from dispatch.signal.models import SignalFilterAction
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the earlier instance, created_at_offset ago, is the one the new instance may deduplicate against
+    earlier = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now(timezone.utc) - timedelta(minutes=created_at_offset),
+    )
+    session.add(earlier)
+
+    # the filter window is entered in minutes in the UI (5-30), so a 30 minute window
+    signal_filter = SignalFilterFactory(
+        name="dedupe-minutes",
+        description="window is in minutes",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    new = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(new)
+    session.commit()
+
+    return new, SignalFilterAction
+
+
+def test_filter_window_is_minutes_deduplicates_within_window(session, signal, project):
+    from dispatch.signal.service import filter_signal
+
+    new, SignalFilterAction = _create_deduplicate_filter_test_instances(
+        session, signal, project, created_at_offset=10
+    )
+
+    assert filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_window_is_minutes_does_not_deduplicate_outside_window(session, signal, project):
+    from dispatch.signal.service import filter_signal
+
+    new, SignalFilterAction = _create_deduplicate_filter_test_instances(
+        session, signal, project, created_at_offset=40
+    )
+
+    filter_signal(db_session=session, signal_instance=new)
+    assert new.filter_action == SignalFilterAction.none
