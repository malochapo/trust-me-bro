@@ -0,0 +1,120 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class FakeDate(date):
+    """A date whose today() is pinned, so the weekday checks are deterministic."""
+
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.fixture
+def pinned_today(monkeypatch):
+    def pin(day: date):
+        FakeDate._today = day
+        monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    return pin
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),
+    ],
+)
+def test_is_reminder_day(pinned_today, day, expected):
+    pinned_today(day)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _registered_task(name: str):
+    """Returns the undecorated task function registered under the given job name."""
+    task = next(t for t in scheduler.registered_tasks if t["name"] == name)
+    return inspect.unwrap(task["func"])
+
+
+@pytest.mark.parametrize(
+    "job_name,status,timestamp_field,day,should_send",
+    [
+        ("case-close-reminder", CaseStatus.triage, "triage_at", date(2025, 8, 18), True),
+        ("case-close-reminder", CaseStatus.triage, "triage_at", date(2025, 8, 19), False),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at", date(2025, 8, 18), True),
+        ("case-stable-reminder", CaseStatus.stable, "stable_at", date(2025, 8, 19), False),
+    ],
+)
+def test_weekly_reminders_only_sent_on_monday(
+    session, case, monkeypatch, pinned_today, job_name, status, timestamp_field, day, should_send
+):
+    # the case has been in its status for more than a week
+    case.status = status
+    setattr(case, timestamp_field, datetime.utcnow() - timedelta(days=8))
+    session.add(case)
+    session.commit()
+
+    sent = []
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+    pinned_today(day)
+
+    # run the task body against this session and project only, not every org and project
+    _registered_task(job_name)(db_session=session, project=case.project)
+
+    assert (case.id in sent) is should_send
+
+
+@pytest.mark.parametrize(
+    "triage_at_age_days,created_at_age_days,should_send",
+    [
+        # no triage_at, so the reminder counts from when the case was created
+        (None, 8, True),
+        (None, 3, False),
+        # triage_at is set, so it wins even when the case was created long ago
+        (1, 30, False),
+        (8, 1, True),
+    ],
+)
+def test_close_reminder_counts_from_triage_at_or_created_at(
+    session, case, monkeypatch, pinned_today, triage_at_age_days, created_at_age_days, should_send
+):
+    case.status = CaseStatus.triage
+    case.triage_at = (
+        None
+        if triage_at_age_days is None
+        else datetime.utcnow() - timedelta(days=triage_at_age_days)
+    )
+    case.created_at = datetime.utcnow() - timedelta(days=created_at_age_days)
+    session.add(case)
+    session.commit()
+
+    sent = []
+    monkeypatch.setattr(
+        scheduled,
+        "send_case_close_reminder",
+        lambda case, db_session: sent.append(case.id),
+    )
+    pinned_today(date(2025, 8, 18))
+
+    _registered_task("case-close-reminder")(db_session=session, project=case.project)
+
+    assert (case.id in sent) is should_send
