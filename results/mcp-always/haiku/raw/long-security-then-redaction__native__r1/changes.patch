diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..fa0c1002
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,66 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity import service as entity_service
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def _token_entity_type(project, jpath="session_token"):
+    return EntityType(
+        name="GitHub token",
+        jpath=jpath,
+        regular_expression=None,
+        project=project,
+    )
+
+
+def test_masked_value_is_not_extracted_as_entity(session, project):
+    """A key listed in SIGNAL_REDACTED_RAW_FIELDS must not produce an entity, even before processing."""
+    signal_instance = SignalInstanceFactory(
+        raw={"session_token": "ghp_secret_for_instance_one", "repository": "dispatch"},
+        project=project,
+    )
+
+    entities = entity_service.find_entities(
+        session, signal_instance, [_token_entity_type(project)]
+    )
+
+    assert entities == []
+
+
+def test_unrelated_instances_do_not_share_a_masked_entity(session, project):
+    """Two instances with different tokens must not both resolve to one shared masked entity."""
+    entity_type = _token_entity_type(project)
+    first = SignalInstanceFactory(raw={"session_token": "ghp_first"}, project=project)
+    second = SignalInstanceFactory(raw={"session_token": "ghp_second"}, project=project)
+
+    assert entity_service.find_entities(session, first, [entity_type]) == []
+    assert entity_service.find_entities(session, second, [entity_type]) == []
+
+
+def test_masked_value_is_skipped_but_unmasked_matches_remain(session, project):
+    """Only the masked match is dropped; other matches of the same JSONPath still become entities."""
+    signal_instance = SignalInstanceFactory(
+        raw={
+            "tokens": [
+                {"session_token": "ghp_masked"},
+                {"session_token": "ghp_also_masked"},
+            ],
+        },
+        project=project,
+    )
+    entity_type = _token_entity_type(project, jpath="tokens[*].session_token")
+
+    entities = entity_service.find_entities(session, signal_instance, [entity_type])
+
+    assert entities == []
+    assert MASK not in {e.value for e in entities}
+
+
+def test_masking_does_not_change_the_instance_raw(session, project):
+    """Extraction works on a masked copy and must leave the instance's raw payload as it was."""
+    raw = {"session_token": "ghp_secret", "repository": "dispatch"}
+    signal_instance = SignalInstanceFactory(raw=dict(raw), project=project)
+
+    entity_service.find_entities(session, signal_instance, [_token_entity_type(project)])
+
+    assert signal_instance.raw == raw
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..8e017949
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,21 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_permission_classes(endpoint_name: str) -> list:
+    """Returns the permission classes declared on a route's PermissionsDependency."""
+    routes = [r for r in router.routes if isinstance(r, APIRoute) and r.name == endpoint_name]
+    assert len(routes) == 1, f"expected exactly one route named {endpoint_name}"
+
+    permission_classes = []
+    for dependency in routes[0].dependencies:
+        if isinstance(dependency.dependency, PermissionsDependency):
+            permission_classes.extend(dependency.dependency.permissions_classes)
+    return permission_classes
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Guards against the permission check being dropped from the custom event delete route."""
+    assert IncidentEventPermission in _route_permission_classes("delete_custom_event")
