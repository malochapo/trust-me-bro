@@ -0,0 +1,111 @@
+import calendar
+from types import SimpleNamespace
+from datetime import date as real_date, datetime, timedelta
+
+import pytest
+
+
+class FakeDate(real_date):
+    """A date whose today() is pinned, so the weekday check is deterministic."""
+
+    _today = real_date(2025, 8, 18)  # a Monday
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+@pytest.fixture
+def scheduled(monkeypatch):
+    from dispatch.case import scheduled as case_scheduled
+
+    monkeypatch.setattr(case_scheduled, "date", FakeDate)
+    return case_scheduled
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (real_date(2025, 8, 18), True),  # Monday
+        (real_date(2025, 8, 19), False),
+        (real_date(2025, 8, 20), False),
+        (real_date(2025, 8, 21), False),
+        (real_date(2025, 8, 22), False),
+        (real_date(2025, 8, 23), False),
+        (real_date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(scheduled, day, expected):
+    FakeDate._today = day
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_is_reminder_day_uses_calendar_monday(scheduled):
+    # calendar.MONDAY is 0-based; the check must agree with weekday(), not isoweekday()
+    FakeDate._today = real_date(2025, 8, 18)
+
+    assert FakeDate.today().weekday() == calendar.MONDAY
+    assert scheduled._is_reminder_day() is True
+
+
+def _unwrapped_case_close_reminder():
+    # the scheduler decorator doesn't return the job, so look it up by name and
+    # unwrap the timer and project context decorators to reach the body
+    from dispatch.scheduler import scheduler
+
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    func = task["func"]
+    while hasattr(func, "__wrapped__"):
+        func = func.__wrapped__
+    return func
+
+
+@pytest.fixture
+def close_reminder_run(scheduled, monkeypatch):
+    """Runs the case close reminder job on a Monday with the given cases and returns the sent cases."""
+    sent = []
+
+    def run(cases):
+        FakeDate._today = real_date(2025, 8, 18)  # a Monday
+        monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: cases)
+        monkeypatch.setattr(
+            scheduled,
+            "send_case_close_reminder",
+            lambda case, db_session: sent.append(case),
+        )
+        _unwrapped_case_close_reminder()(db_session=None, project=SimpleNamespace(id=1))
+        return sent
+
+    return run
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(close_reminder_run):
+
+    # triage_at was never recorded, so the case is counted from when it was created
+    case = SimpleNamespace(
+        triage_at=None, created_at=datetime.utcnow() - timedelta(days=8), name="no-triage-at"
+    )
+
+    assert close_reminder_run([case]) == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(close_reminder_run):
+
+    case = SimpleNamespace(
+        triage_at=None, created_at=datetime.utcnow() - timedelta(days=2), name="recent"
+    )
+
+    assert close_reminder_run([case]) == []
+
+
+def test_case_close_reminder_prefers_triage_at(close_reminder_run):
+
+    # created long ago, but triaging only recently, so no reminder yet
+    case = SimpleNamespace(
+        triage_at=datetime.utcnow() - timedelta(days=2),
+        created_at=datetime.utcnow() - timedelta(days=30),
+        name="recently-triaged",
+    )
+
+    assert close_reminder_run([case]) == []
