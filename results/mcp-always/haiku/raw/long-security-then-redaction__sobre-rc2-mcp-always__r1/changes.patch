diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..24c2e072
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,34 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_creates_entity_from_masked_value(session, signal_instance, project):
+    signal_instance.raw = {
+        "session_token": "ghp_realsecretvalue",
+        "details": {"authorization": "Bearer abc", "user": "alice"},
+    }
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="Auth Header", jpath="details.authorization", regular_expression=None, project=project),
+        EntityType(name="User", jpath="details.user", regular_expression=None, project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert "ghp_realsecretvalue" not in values
+    assert "Bearer abc" not in values
+    assert values == {"alice"}
+
+
+def test_find_entities_does_not_mutate_raw(session, signal_instance, project):
+    signal_instance.raw = {"session_token": "ghp_realsecretvalue"}
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+    ]
+
+    find_entities(session, signal_instance, entity_types)
+
+    assert signal_instance.raw == {"session_token": "ghp_realsecretvalue"}
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..13a7aa7f
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,20 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission."""
+    routes = [
+        route
+        for route in router.routes
+        if route.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_classes = [
+        permission_class
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in permission_classes
