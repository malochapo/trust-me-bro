+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+    from dispatch.signal.redaction import MASK, redact_raw
+
+    # The session token is masked before entity extraction, as in signal_instance_create_flow
+    signal_instance.raw = redact_raw(
+        {"session_token": "real-session-token", "asset": [{"id": "arn:aws:iam::1:role/Test"}]}
+    )
+    assert signal_instance.raw["session_token"] == MASK
+
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", regular_expression=None, project=project),
+        EntityType(name="AWS IAM Role ARN", jpath="asset[0].id", regular_expression=None, project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {e.value for e in entities}
+    assert MASK not in values
+    assert values == {"arn:aws:iam::1:role/Test"}
diff --git a/tests/incident/test_incident_views.py b/tests/incident/test_incident_views.py
new file mode 100644
index 00000000..d8bc896b
--- /dev/null
+++ b/tests/incident/test_incident_views.py
@@ -0,0 +1,26 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_dependencies(path: str, method: str) -> list:
+    """Returns the dependency callables declared on the matching route."""
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            return [dependency.dependency for dependency in route.dependencies]
+    raise AssertionError(f"No {method} route registered for {path}")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting a custom event must stay guarded by IncidentEventPermission.
+
+    Regression guard: the permission was dropped in 28c21e1e and went unnoticed.
+    """
+    dependencies = _route_dependencies("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permission_dependencies = [
+        dependency for dependency in dependencies if isinstance(dependency, PermissionsDependency)
+    ]
+    assert any(
+        IncidentEventPermission in dependency.permissions_classes
+        for dependency in permission_dependencies
+    ), "delete_custom_event is missing its IncidentEventPermission check"
