diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..036ead4d
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,30 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_masked_values_never_become_entities(session, signal_instance, project):
+    """A JSONPath on a sensitive key must not yield the mask, nor the raw secret, as an entity."""
+    signal_instance.raw = {"session_token": "live-secret-value", "user": "alice"}
+
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", project=project),
+        EntityType(name="User", jpath="user", project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert "live-secret-value" not in values
+    # non-sensitive fields are still extracted
+    assert values == {"alice"}
+
+
+def test_masked_value_in_payload_does_not_become_entity(session, signal_instance, project):
+    """Values already masked upstream are skipped as well."""
+    signal_instance.raw = {"session_token": MASK, "user": "alice"}
+
+    entity_types = [EntityType(name="Session Token", jpath="session_token", project=project)]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..48e0a640
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check being removed from the delete custom event route."""
+    routes = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_classes = [
+        permission_class
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in permission_classes
