+def test_find_entities_never_creates_entity_from_masked_value(session, project):
+    from dispatch.entity.service import find_entities
+
+    # session_token is one of the default masked keys, so its value must never become an entity
+    signal_instance = SignalInstanceFactory(
+        raw={"user": "alice", "session_token": "ghp_secret_one"},
+    )
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+    assert len(entities) == 0
+
+    # Unmasked values are still extracted from the same payload
+    entity_types = [
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert [e.value for e in entities] == ["alice"]
diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..3c7e6e95
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,29 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_dependencies(path: str, method: str) -> list:
+    """Returns the dependencies declared on the incident router route matching path and method."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route.dependencies
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+def test_delete_custom_event_route_requires_event_permission():
+    """Deleting a timeline event must be guarded by IncidentEventPermission.
+
+    Calling the view function directly bypasses route dependencies, so this inspects the
+    route definition instead.
+    """
+    dependencies = _route_dependencies("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    guarded_by = [
+        permission_class
+        for dependency in dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in guarded_by
