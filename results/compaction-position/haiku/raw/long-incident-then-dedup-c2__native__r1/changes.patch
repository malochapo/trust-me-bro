@@ -0,0 +1,104 @@
+import inspect
+
+from datetime import date, datetime, timedelta
+from unittest.mock import patch
+
+import pytest
+
+from dispatch.case.enums import CaseStatus
+from dispatch.case.scheduled import _is_reminder_day
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    """Stands in for datetime.date so date.today() returns a fixed day."""
+
+    fixed_today = None
+
+    @classmethod
+    def today(cls):
+        return cls.fixed_today
+
+
+def _stable_reminder_job():
+    # the scheduler registers the job wrapped in the timer and project-context decorators
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-stable-reminder")
+    return inspect.unwrap(task["func"])
+
+
+def _on(day: date):
+    _FakeDate.fixed_today = day
+    return patch("dispatch.case.scheduled.date", _FakeDate)
+
+
+# 2025-08-18 is a Monday
+MONDAY = date(2025, 8, 18)
+
+
+@pytest.mark.parametrize("offset", range(7))
+def test_is_reminder_day_only_on_monday(offset):
+    day = MONDAY + timedelta(days=offset)
+    with _on(day):
+        assert _is_reminder_day() is (offset == 0)
+
+
+def test_case_stable_reminder_sends_on_monday(session, case):
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    job = _stable_reminder_job()
+
+    with _on(MONDAY), patch("dispatch.case.scheduled.send_case_close_reminder") as send:
+        job(db_session=session, project=case.project)
+
+    send.assert_called_once_with(case, session)
+
+
+def test_case_stable_reminder_skips_other_days(session, case):
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    job = _stable_reminder_job()
+
+    with (
+        _on(MONDAY + timedelta(days=1)),
+        patch("dispatch.case.scheduled.send_case_close_reminder") as send,
+    ):
+        job(db_session=session, project=case.project)
+
+    send.assert_not_called()
+
+
+def _close_reminder_job():
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    return inspect.unwrap(task["func"])
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(session, case):
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.commit()
+
+    job = _close_reminder_job()
+
+    with _on(MONDAY), patch("dispatch.case.scheduled.send_case_close_reminder") as send:
+        job(db_session=session, project=case.project)
+
+    send.assert_called_once_with(case, session)
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(session, case):
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.commit()
+
+    job = _close_reminder_job()
+
+    with _on(MONDAY), patch("dispatch.case.scheduled.send_case_close_reminder") as send:
+        job(db_session=session, project=case.project)
+
+    send.assert_not_called()
