@@ -0,0 +1,77 @@
+import inspect
+from datetime import date, datetime, timedelta
+from types import SimpleNamespace
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.scheduler import scheduler
+
+
+class FakeDate(date):
+    """Stands in for datetime.date so that date.today() returns a fixed day."""
+
+    fixed_today: date
+
+    @classmethod
+    def today(cls):
+        return cls.fixed_today
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),  # Wednesday
+        (date(2025, 8, 14), False),  # Thursday
+        (date(2025, 8, 15), False),  # Friday
+        (date(2025, 8, 16), False),  # Saturday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    fake = type("FakeDate", (FakeDate,), {"fixed_today": day})
+    monkeypatch.setattr(scheduled, "date", fake)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _run_case_close_reminder(monkeypatch, cases):
+    """Runs the close reminder job body for the given cases and returns the reminded ones."""
+    reminded = []
+
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(scheduled, "get_all_by_status", lambda **kwargs: cases)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: reminded.append(case)
+    )
+
+    # the scheduler decorator doesn't return the function, so look the job up by name and
+    # unwrap the timer and project-context decorators to call the job body directly
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    inspect.unwrap(task["func"])(db_session=None, project=SimpleNamespace(id=1))
+    return reminded
+
+
+def test_case_close_reminder_counts_from_triage_at(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(
+        name="triaged", triage_at=now - timedelta(days=8), created_at=now - timedelta(days=30)
+    )
+
+    assert _run_case_close_reminder(monkeypatch, [case]) == [case]
+
+
+def test_case_close_reminder_falls_back_to_created_at_without_triage_at(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(name="never-triaged", triage_at=None, created_at=now - timedelta(days=8))
+
+    assert _run_case_close_reminder(monkeypatch, [case]) == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(monkeypatch):
+    now = datetime.utcnow()
+    case = SimpleNamespace(name="recent", triage_at=None, created_at=now - timedelta(days=2))
+
+    assert _run_case_close_reminder(monkeypatch, [case]) == []
