+@pytest.mark.parametrize("window, expected", [(30, True), (5, False)])
+def test_filter_deduplicate_window_is_in_minutes(session, signal, project, window, expected):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    now = datetime.now(timezone.utc)
+    # the first instance arrived ten minutes before the second one
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=now,
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    # windows are set in minutes in the UI, so a 30 minute window covers both instances
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    session.commit()
+    assert bool(filter_signal(db_session=session, signal_instance=signal_instance_2)) is expected
+    if expected:
+        assert signal_instance_2.filter_action == SignalFilterAction.deduplicate
+    else:
+        assert signal_instance_2.filter_action == SignalFilterAction.none
+
