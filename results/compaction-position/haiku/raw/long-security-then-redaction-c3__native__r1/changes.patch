diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..16af9e51
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,47 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_masked_value_is_never_an_entity(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {"session": {"session_token": "super-secret"}, "user": "alice"}
+
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session.session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    assert entities == []
+
+
+def test_unmasked_value_still_becomes_entity_next_to_masked_one(session, signal_instance, project):
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {
+        "tokens": [{"password": "hunter2"}, {"password": "hunter3"}],
+        "owner": "alice@example.com",
+    }
+
+    entity_types = [
+        EntityType(
+            name="Owner",
+            jpath="owner",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Password",
+            jpath="tokens[*].password",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+    values = {e.value for e in entities}
+    assert values == {"alice@example.com"}
+    assert MASK not in values
diff --git a/tests/incident/test_incident_views_permissions.py b/tests/incident/test_incident_views_permissions.py
new file mode 100644
index 00000000..16cf3d96
--- /dev/null
+++ b/tests/incident/test_incident_views_permissions.py
@@ -0,0 +1,25 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _route_dependencies(path: str, method: str) -> list:
+    """Returns the dependency callables declared on the matching route."""
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return [d.dependency for d in route.dependencies]
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+def test_delete_custom_event_requires_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission."""
+    dependencies = _route_dependencies("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permission_dependencies = [
+        d for d in dependencies if isinstance(d, PermissionsDependency)
+    ]
+    assert permission_dependencies, "delete_custom_event has no PermissionsDependency"
+    assert any(
+        IncidentEventPermission in p.permissions_classes for p in permission_dependencies
+    )
