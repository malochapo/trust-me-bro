@@ -0,0 +1,142 @@
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+
+
+class _FakeDate(date):
+    """A date whose today() is pinned to a given day."""
+
+    _today = date(2025, 8, 18)
+
+    @classmethod
+    def today(cls):
+        return cls._today
+
+
+def _freeze_today(monkeypatch, day: date):
+    _FakeDate._today = day
+    monkeypatch.setattr(scheduled, "date", _FakeDate)
+
+
+def _run_task(name, session, project):
+    # the scheduler decorators open their own engine and loop over every organization,
+    # so we call the undecorated function with the session and project directly
+    task = next(t["func"] for t in scheduler.registered_tasks if t["name"] == name)
+    task.__wrapped__.__wrapped__(db_session=session, project=project)
+
+
+@pytest.mark.parametrize(
+    "day,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    _freeze_today(monkeypatch, day)
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_close_reminder_sends_on_monday(monkeypatch, session, project, case):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    _freeze_today(monkeypatch, date(2025, 8, 18))
+
+    case.project = project
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    _run_task("case-close-reminder", session, project)
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_skips_non_monday(monkeypatch, session, project, case):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    _freeze_today(monkeypatch, date(2025, 8, 19))
+
+    case.project = project
+    case.status = CaseStatus.triage
+    case.triage_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    _run_task("case-close-reminder", session, project)
+
+    assert sent == []
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(
+    monkeypatch, session, project, case
+):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    _freeze_today(monkeypatch, date(2025, 8, 18))
+
+    case.project = project
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    _run_task("case-close-reminder", session, project)
+
+    assert sent == [case]
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(
+    monkeypatch, session, project, case
+):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    _freeze_today(monkeypatch, date(2025, 8, 18))
+
+    case.project = project
+    case.status = CaseStatus.triage
+    case.triage_at = None
+    case.created_at = datetime.utcnow() - timedelta(days=2)
+    session.add(case)
+    session.commit()
+
+    _run_task("case-close-reminder", session, project)
+
+    assert sent == []
+
+
+def test_case_stable_reminder_sends_on_monday(monkeypatch, session, project, case):
+    sent = []
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case)
+    )
+    _freeze_today(monkeypatch, date(2025, 8, 18))
+
+    case.project = project
+    case.status = CaseStatus.stable
+    case.stable_at = datetime.utcnow() - timedelta(days=8)
+    session.add(case)
+    session.commit()
+
+    _run_task("case-stable-reminder", session, project)
+
+    assert sent == [case]
