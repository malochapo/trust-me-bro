+@pytest.mark.parametrize(
+    "minutes_apart,expected_action",
+    [
+        (10, SignalFilterAction.deduplicate),  # inside a 30 minute window
+        (40, SignalFilterAction.none),  # outside a 30 minute window
+    ],
+)
+def test_filter_actions_deduplicate_window_is_minutes(
+    session, signal, project, minutes_apart, expected_action
+):
+    # SignalFilter.window is entered in minutes in the UI, so a window of 30 must look back 30 minutes
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        CaseFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+    from datetime import datetime, timedelta
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    case = CaseFactory(project=project)
+    session.add(case)
+    session.commit()
+
+    earlier = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        case=case,
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.now() - timedelta(minutes=minutes_apart),
+    )
+    session.add(earlier)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="test",
+        description="dedupe window in minutes",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=30,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    later = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(later)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=later)
+    assert later.filter_action == expected_action
+
+
+def test_filter_actions_snooze_skips_expired_filter(session, signal, project):
+    # an expired snooze filter must not stop the check for a later, still active snooze filter
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+    from datetime import datetime, timedelta
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+    session.commit()
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # the expired filter is added first so it is the one checked first
+    expired_filter = SignalFilterFactory(
+        name="expired",
+        description="expired snooze",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now() - timedelta(days=7),
+        project=project,
+    )
+    signal.filters.append(expired_filter)
+
+    active_filter = SignalFilterFactory(
+        name="active",
+        description="active snooze",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now() + timedelta(days=30),
+        project=project,
+    )
+    signal.filters.append(active_filter)
+    session.commit()
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
+
+
