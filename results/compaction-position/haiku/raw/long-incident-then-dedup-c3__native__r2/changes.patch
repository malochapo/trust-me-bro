@@ -0,0 +1,63 @@
+import inspect
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case import scheduled
+from dispatch.case.enums import CaseStatus
+from dispatch.scheduler import scheduler
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 18), True),  # Monday
+        (date(2025, 8, 19), False),  # Tuesday
+        (date(2025, 8, 20), False),  # Wednesday
+        (date(2025, 8, 21), False),  # Thursday
+        (date(2025, 8, 22), False),  # Friday
+        (date(2025, 8, 23), False),  # Saturday
+        (date(2025, 8, 24), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert scheduled._is_reminder_day() is expected
+
+
+@pytest.mark.parametrize(
+    "triage_at_age_days,created_at_age_days,expected_sent",
+    [
+        (None, 8, True),  # no triage_at, counts from created_at and is overdue
+        (None, 1, False),  # no triage_at, counts from created_at and is not overdue
+        (8, 30, True),  # triage_at is used when set, even if created_at is older
+        (1, 30, False),  # triage_at is used when set, even if created_at is older
+    ],
+)
+def test_case_close_reminder_counts_from_triage_at_or_created_at(
+    session, project, triage_at_age_days, created_at_age_days, expected_sent
+):
+    now = datetime.utcnow()
+    case = CaseFactory(project=project)
+    # set after creation, the factory's status parameter does not apply to the passed kwarg
+    case.status = CaseStatus.triage
+    case.triage_at = now - timedelta(days=triage_at_age_days) if triage_at_age_days else None
+    case.created_at = now - timedelta(days=created_at_age_days)
+    session.commit()
+
+    # scheduler.add does not return the job, look it up by name and unwrap the timer and project wrappers
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    job = inspect.unwrap(task["func"])
+    with (
+        mock.patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as mock_send,
+    ):
+        job(db_session=session, project=project)
+
+    if expected_sent:
+        mock_send.assert_called_once_with(case, session)
+    else:
+        mock_send.assert_not_called()
