diff --git a/tests/entity/test_entity_masked_values.py b/tests/entity/test_entity_masked_values.py
new file mode 100644
index 00000000..fc328a6b
--- /dev/null
+++ b/tests/entity/test_entity_masked_values.py
@@ -0,0 +1,36 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_turns_masked_values_into_entities(session, project):
+    """A masked value must not become an entity, even when the JSONPath points at it.
+
+    Otherwise every instance whose token was masked shares the same "[REDACTED]" entity
+    and gets grouped together by deduplication.
+    """
+    signal_instance = SignalInstanceFactory(
+        raw={"session_token": "super-secret-token", "user": "analyst@example.com"}
+    )
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert "super-secret-token" not in values
+    assert values == {"analyst@example.com"}
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..6ed0eaaf
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,31 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(path: str, method: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"Route {method} {path} not found")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting a custom event must be guarded by IncidentEventPermission.
+
+    Regression guard: this check was dropped in 28c21e1e ("refactor(incident): tidy
+    custom event routes") and must not go missing again.
+    """
+    route = _get_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    permission_dependencies = [
+        dep.dependency
+        for dep in route.dependencies
+        if isinstance(dep.dependency, PermissionsDependency)
+    ]
+
+    assert permission_dependencies, "delete_custom_event has no PermissionsDependency"
+    assert any(
+        IncidentEventPermission in dep.permissions_classes for dep in permission_dependencies
+    ), "delete_custom_event is not guarded by IncidentEventPermission"
