diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..1d56a6b6
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,45 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def _token_entity_type(project):
+    return EntityType(
+        name="Session Token",
+        jpath="session_token",
+        regular_expression=None,
+        project=project,
+    )
+
+
+def test_find_entities_never_yields_a_redacted_value(session, signal_instance, project):
+    """A masked field must not become an entity, even when the raw payload is not yet masked."""
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {"session_token": "ghp_secret123", "user": "alice"}
+    entities = find_entities(session, signal_instance, [_token_entity_type(project)])
+
+    assert entities == []
+
+
+def test_find_entities_ignores_an_already_masked_field(session, signal_instance, project):
+    """A payload that was already masked must not produce an entity with the mask as its value."""
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {"session_token": MASK, "user": "alice"}
+    entities = find_entities(session, signal_instance, [_token_entity_type(project)])
+
+    assert entities == []
+
+
+def test_find_entities_still_extracts_unmasked_fields(session, signal_instance, project):
+    """Masking must not stop ordinary values from being extracted."""
+    from dispatch.entity.service import find_entities
+
+    signal_instance.raw = {"session_token": "ghp_secret123", "user": "alice"}
+    entity_types = [
+        EntityType(name="User", jpath="user", regular_expression=None, project=project),
+        _token_entity_type(project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert [str(entity.value) for entity in entities] == ["alice"]
diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..8ac5f49c
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,24 @@
+from fastapi.params import Depends as DependsParam
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check on the custom event delete route being dropped."""
+    routes = [
+        route
+        for route in router.routes
+        if getattr(route, "path", None) == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in getattr(route, "methods", set())
+    ]
+    assert len(routes) == 1
+
+    permission_dependencies = [
+        dependency.dependency
+        for dependency in routes[0].dependencies
+        if isinstance(dependency, DependsParam)
+        and isinstance(dependency.dependency, PermissionsDependency)
+    ]
+    assert len(permission_dependencies) == 1
+    assert permission_dependencies[0].permissions_classes == [IncidentEventPermission]
