diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..0df16a2a
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,25 @@
+from dispatch.entity.models import Entity
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+from tests.factories import SignalInstanceFactory
+
+
+def test_find_entities_never_extracts_masked_values(session, project):
+    """A masked value must not become an entity, or unrelated instances get grouped together."""
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        raw={"session_token": "ghp_secret_one", "externalId": "instance-1"},
+    )
+    entity_types = [
+        EntityType(name="Session token", jpath="session_token", project=project),
+        EntityType(name="External id", jpath="externalId", project=project),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert "ghp_secret_one" not in values
+    assert values == {"instance-1"}
+    assert session.query(Entity).filter(Entity.value == MASK).count() == 0
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..782aa5c4
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,26 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the permission check being dropped from the delete custom event route."""
+    routes = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_dependencies = [
+        dependency.dependency
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+    ]
+    assert any(
+        IncidentEventPermission in dependency.permissions_classes
+        for dependency in permission_dependencies
+    )
