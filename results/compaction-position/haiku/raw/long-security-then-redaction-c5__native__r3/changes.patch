diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..79cc2375
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,37 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+
+
+def _entity_values(entities):
+    return {entity.value for entity in entities}
+
+
+def test_masked_value_never_becomes_entity(session, signal_instance, project):
+    """Masked values must not be extracted, so unrelated instances are not grouped together."""
+    signal_instance.raw = {"session_token": "ghp_first_secret", "user": "alice"}
+    session.add(signal_instance)
+
+    entity_types = [
+        EntityType(name="Session Token", jpath="session_token", project=project),
+        EntityType(name="Any Field", jpath="$.*", project=project),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = _entity_values(entities)
+    assert "[REDACTED]" not in values
+    assert "ghp_first_secret" not in values
+    assert values == {"alice"}
+
+
+def test_unrelated_instances_do_not_share_entities(session, signal_instance, project):
+    """Two instances with different tokens must not produce a shared entity."""
+    entity_types = [EntityType(name="Session Token", jpath="session_token", project=project)]
+
+    signal_instance.raw = {"session_token": "ghp_first_secret"}
+    first = _entity_values(find_entities(session, signal_instance, entity_types))
+
+    signal_instance.raw = {"session_token": "ghp_second_secret"}
+    second = _entity_values(find_entities(session, signal_instance, entity_types))
+
+    assert first == set()
+    assert second == set()
diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..5ab8c289
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,20 @@
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the delete route silently losing its permission check."""
+    routes = [
+        route
+        for route in router.routes
+        if route.path == "/{incident_id}/event/{event_uuid}" and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_classes = [
+        permission_class
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in permission_classes
