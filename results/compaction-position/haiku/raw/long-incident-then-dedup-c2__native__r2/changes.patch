@@ -0,0 +1,76 @@
+from datetime import date, datetime, timedelta
+from unittest import mock
+
+import pytest
+
+from dispatch.case.scheduled import _is_reminder_day
+
+
+@pytest.mark.parametrize(
+    "today,expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),  # Tuesday
+        (date(2025, 8, 13), False),  # Wednesday
+        (date(2025, 8, 14), False),  # Thursday
+        (date(2025, 8, 15), False),  # Friday
+        (date(2025, 8, 16), False),  # Saturday
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(today, expected):
+    with mock.patch("dispatch.case.scheduled.date") as mock_date:
+        mock_date.today.return_value = today
+        assert _is_reminder_day() is expected
+
+
+def _run_case_close_reminder(session, project, cases):
+    """Runs the case close reminder job for the given cases, skipping the project loop."""
+    from dispatch.scheduler import scheduler
+
+    task = next(t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+
+    def run_in_project_context(func, *args, **kwargs):
+        return func(*args, db_session=session, project=project, **kwargs)
+
+    with (
+        mock.patch(
+            "dispatch.decorators._execute_task_in_project_context",
+            side_effect=run_in_project_context,
+        ),
+        mock.patch("dispatch.case.scheduled.get_all_by_status", return_value=cases),
+        mock.patch("dispatch.case.scheduled._is_reminder_day", return_value=True),
+        mock.patch("dispatch.case.scheduled.send_case_close_reminder") as mock_send,
+    ):
+        task["func"]()
+    return mock_send
+
+
+def test_case_close_reminder_counts_from_created_at_when_triage_at_missing(session, case, project):
+    now = datetime.utcnow()
+    case.triage_at = None
+    case.created_at = now - timedelta(days=8)
+
+    mock_send = _run_case_close_reminder(session, project, [case])
+
+    mock_send.assert_called_once_with(case, session)
+
+
+def test_case_close_reminder_does_not_send_when_created_at_is_recent(session, case, project):
+    now = datetime.utcnow()
+    case.triage_at = None
+    case.created_at = now - timedelta(days=3)
+
+    mock_send = _run_case_close_reminder(session, project, [case])
+
+    mock_send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at_when_set(session, case, project):
+    now = datetime.utcnow()
+    case.created_at = now - timedelta(days=30)
+    case.triage_at = now - timedelta(days=3)
+
+    mock_send = _run_case_close_reminder(session, project, [case])
+
+    mock_send.assert_not_called()
