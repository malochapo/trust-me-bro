+def _dedupe_filter_window_case(session, signal, project, minutes_ago, window):
+    from datetime import datetime, timedelta
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    earlier = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(earlier)
+    session.commit()
+    earlier.created_at = datetime.utcnow() - timedelta(minutes=minutes_ago)
+    session.commit()
+
+    later = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(later)
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe-window",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+    session.commit()
+
+    filter_signal(db_session=session, signal_instance=later)
+    return later, SignalFilterAction
+
+
+def test_filter_actions_deduplicate_window_is_minutes(session, signal, project):
+    # 30 is the window chosen in the UI, so an instance 10 minutes earlier is a duplicate
+    later, SignalFilterAction = _dedupe_filter_window_case(
+        session, signal, project, minutes_ago=10, window=30
+    )
+    assert later.filter_action == SignalFilterAction.deduplicate
+
+
+def test_filter_actions_deduplicate_window_expired(session, signal, project):
+    # an instance 40 minutes earlier falls outside a 30 minute window
+    later, SignalFilterAction = _dedupe_filter_window_case(
+        session, signal, project, minutes_ago=40, window=30
+    )
+    assert later.filter_action != SignalFilterAction.deduplicate
+
+
+def test_filter_actions_snooze_expired_then_valid(session, entity, signal, project):
+    from datetime import datetime, timedelta, timezone
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import EntityTypeFactory, SignalInstanceFactory, SignalFilterFactory
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    session.add(entity)
+
+    signal_instance = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance)
+
+    expression = [{"or": [{"model": "Entity", "field": "id", "op": "==", "value": entity.id}]}]
+
+    # an expired snooze listed before a valid one must not stop the valid one from applying
+    expired_filter = SignalFilterFactory(
+        name="snooze-expired",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) - timedelta(days=7),
+        project=project,
+    )
+    valid_filter = SignalFilterFactory(
+        name="snooze-valid",
+        description="test",
+        expression=expression,
+        action="snooze",
+        expiration=datetime.now(timezone.utc) + timedelta(days=30),
+        project=project,
+    )
+
+    signal.filters = [expired_filter, valid_filter]
+    session.commit()
+
+    assert filter_signal(db_session=session, signal_instance=signal_instance)
+    assert signal_instance.filter_action == SignalFilterAction.snooze
