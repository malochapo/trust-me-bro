diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..f3d6fe10
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,51 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_turns_a_masked_value_into_an_entity(session, signal_instance, project):
+    """Masked placeholders must not become entities, or unrelated instances get grouped together."""
+    signal_instance.raw = {
+        "session_token": "ghp_real_token_for_one_instance",
+        "user": {"name": "alice"},
+    }
+    entity_types = [
+        EntityType(
+            name="Session Token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User Name",
+            jpath="user.name",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {entity.value for entity in entities}
+    assert MASK not in values
+    assert "ghp_real_token_for_one_instance" not in values
+    assert values == {"alice"}
+
+
+def test_find_entities_skips_masked_values_in_legacy_unmasked_payload(
+    session, signal_instance, project
+):
+    """A payload stored before masking existed is masked during extraction too."""
+    signal_instance.raw = {"password": "hunter2", "other": {"password": "hunter3"}}
+    entity_types = [
+        EntityType(
+            name="Password",
+            jpath="$..password",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..bef582b3
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,28 @@
+from fastapi.params import Depends as DependsParam
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _find_route(path: str, method: str):
+    for route in router.routes:
+        if route.path == path and method in route.methods:
+            return route
+    raise AssertionError(f"No {method} route defined for {path}")
+
+
+def _permission_classes(route) -> list:
+    classes = []
+    for dependency in route.dependencies:
+        if isinstance(dependency, DependsParam) and isinstance(
+            dependency.dependency, PermissionsDependency
+        ):
+            classes.extend(dependency.dependency.permissions_classes)
+    return classes
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Guards against the IncidentEventPermission check being dropped from the delete route."""
+    route = _find_route("/{incident_id}/event/{event_uuid}", "DELETE")
+
+    assert IncidentEventPermission in _permission_classes(route)
