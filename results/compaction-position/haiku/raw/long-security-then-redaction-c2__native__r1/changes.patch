diff --git a/tests/entity/test_entity_redaction.py b/tests/entity/test_entity_redaction.py
new file mode 100644
index 00000000..f8678dca
--- /dev/null
+++ b/tests/entity/test_entity_redaction.py
@@ -0,0 +1,60 @@
+from dispatch.entity.service import find_entities
+from dispatch.entity_type.models import EntityType
+from dispatch.signal.redaction import MASK
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    # the session token is masked by redact_raw, so its entity type must find nothing
+    signal_instance.raw = {"session_token": "ghp_real_secret", "login": "octocat"}
+
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert entities == []
+
+
+def test_find_entities_masked_value_is_not_shared_between_instances(
+    session, signal_instance, project
+):
+    # two unrelated instances carrying different tokens must not share an entity
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    signal_instance.raw = {"session_token": "ghp_first"}
+    first = find_entities(session, signal_instance, entity_types)
+    signal_instance.raw = {"session_token": "ghp_second"}
+    second = find_entities(session, signal_instance, entity_types)
+
+    assert first == [] and second == []
+    assert all(entity.value != MASK for entity in first + second)
+
+
+def test_find_entities_still_extracts_unmasked_fields(session, signal_instance, project):
+    # control: redaction only affects the configured sensitive keys
+    signal_instance.raw = {"session_token": "ghp_real_secret", "login": "octocat"}
+
+    entity_types = [
+        EntityType(
+            name="Login",
+            jpath="login",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+    entities = find_entities(session, signal_instance, entity_types)
+
+    assert len(entities) == 1
+    assert entities[0].value == "octocat"
diff --git a/tests/incident/test_incident_event_views.py b/tests/incident/test_incident_event_views.py
new file mode 100644
index 00000000..03549594
--- /dev/null
+++ b/tests/incident/test_incident_event_views.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def _get_route(method: str, path: str) -> APIRoute:
+    for route in router.routes:
+        if isinstance(route, APIRoute) and method in route.methods and route.path == path:
+            return route
+    raise AssertionError(f"No {method} route found for {path}")
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    route = _get_route("DELETE", "/{incident_id}/event/{event_uuid}")
+
+    permission_classes = [
+        permission_class
+        for dependency in route.dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+
+    assert IncidentEventPermission in permission_classes
