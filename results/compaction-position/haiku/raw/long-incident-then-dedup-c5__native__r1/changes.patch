+@pytest.mark.parametrize(
+    "window, expected_deduplicated",
+    [
+        (30, True),  # instances are 10 minutes apart, inside a 30 minute window
+        (5, False),  # ...and outside a 5 minute window
+    ],
+)
+def test_filter_actions_deduplicate_window_is_in_minutes(
+    session, signal, project, window, expected_deduplicated
+):
+    from datetime import datetime, timedelta
+
+    from dispatch.signal.models import SignalFilterAction
+    from dispatch.signal.service import filter_signal
+    from tests.factories import (
+        EntityTypeFactory,
+        EntityFactory,
+        SignalInstanceFactory,
+        SignalFilterFactory,
+    )
+
+    entity_type = EntityTypeFactory(project=project)
+    session.add(entity_type)
+    signal.entity_types.append(entity_type)
+
+    entity = EntityFactory(entity_type=entity_type, project=project)
+    session.add(entity)
+
+    # the same user, ten minutes apart
+    signal_instance_1 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+        created_at=datetime.utcnow() - timedelta(minutes=10),
+    )
+    session.add(signal_instance_1)
+
+    signal_instance_2 = SignalInstanceFactory(
+        project=project,
+        signal=signal,
+        entities=[entity],
+        raw=json.dumps({"id": "foo"}),
+    )
+    session.add(signal_instance_2)
+    session.commit()
+
+    signal_filter = SignalFilterFactory(
+        name="dedupe1",
+        description="test",
+        expression=[
+            {"or": [{"model": "EntityType", "field": "id", "op": "==", "value": entity_type.id}]}
+        ],
+        action="deduplicate",
+        window=window,
+        project=project,
+    )
+    signal.filters.append(signal_filter)
+
+    session.commit()
+    filtered = filter_signal(db_session=session, signal_instance=signal_instance_2)
+    assert filtered is expected_deduplicated
+    if expected_deduplicated:
+        assert signal_instance_2.filter_action == SignalFilterAction.deduplicate
+        assert signal_instance_2.case_id == signal_instance_1.case_id
+    else:
+        assert signal_instance_2.filter_action == SignalFilterAction.none
+
+
