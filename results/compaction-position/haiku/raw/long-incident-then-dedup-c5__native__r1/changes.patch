+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,105 @@
+import inspect
+from datetime import date, datetime, timedelta
+
+import pytest
+
+from dispatch.case.enums import CaseStatus
+from tests.factories import CaseFactory
+
+
+def _freeze_today(monkeypatch, today):
+    from dispatch.case import scheduled
+
+    class FakeDate(date):
+        @classmethod
+        def today(cls):
+            return today
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+
+@pytest.mark.parametrize(
+    "today, expected",
+    [
+        (date(2025, 8, 11), True),  # Monday
+        (date(2025, 8, 12), False),
+        (date(2025, 8, 13), False),
+        (date(2025, 8, 14), False),
+        (date(2025, 8, 15), False),
+        (date(2025, 8, 16), False),
+        (date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, today, expected):
+    from dispatch.case import scheduled
+
+    _freeze_today(monkeypatch, today)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def _triage_case(session, project, created_at, triage_at=None):
+    # CaseFactory's Params pin status to "New", so we set the status after creating the case
+    case = CaseFactory(project=project, triage_at=triage_at, created_at=created_at)
+    case.status = CaseStatus.triage
+    session.add(case)
+    return case
+
+
+def _run_case_close_reminder(session, project, monkeypatch, mocker):
+    from dispatch.scheduler import scheduler
+
+    _freeze_today(monkeypatch, date(2025, 8, 11))  # Monday
+    send = mocker.patch("dispatch.case.scheduled.send_case_close_reminder")
+
+    # the scheduler decorator doesn't return the function, so we look it up by name, and
+    # the task decorators open per-organization sessions, so we call the task body directly
+    (task,) = [t for t in scheduler.registered_tasks if t["name"] == "case-close-reminder"]
+    inspect.unwrap(task["func"])(db_session=session, project=project)
+    return send
+
+
+def test_case_close_reminder_counts_from_created_at_without_triage_at(
+    session, project, monkeypatch, mocker
+):
+    case = _triage_case(
+        session,
+        project,
+        created_at=datetime.utcnow() - timedelta(days=8),
+        triage_at=None,
+    )
+
+    send = _run_case_close_reminder(session, project, monkeypatch, mocker)
+
+    send.assert_called_once()
+    assert send.call_args.args[0].id == case.id
+
+
+def test_case_close_reminder_skips_recent_case_without_triage_at(
+    session, project, monkeypatch, mocker
+):
+    _triage_case(
+        session,
+        project,
+        created_at=datetime.utcnow() - timedelta(days=3),
+        triage_at=None,
+    )
+
+    send = _run_case_close_reminder(session, project, monkeypatch, mocker)
+
+    send.assert_not_called()
+
+
+def test_case_close_reminder_prefers_triage_at_over_created_at(
+    session, project, monkeypatch, mocker
+):
+    _triage_case(
+        session,
+        project,
+        created_at=datetime.utcnow() - timedelta(days=30),
+        triage_at=datetime.utcnow() - timedelta(days=2),
+    )
+
+    send = _run_case_close_reminder(session, project, monkeypatch, mocker)
+
+    send.assert_not_called()
