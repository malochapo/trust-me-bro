--- /dev/null
+++ b/tests/case/test_case_scheduled.py
@@ -0,0 +1,66 @@
+from datetime import date as real_date
+import inspect
+
+import pytest
+
+from tests.factories import CaseFactory
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (real_date(2025, 8, 11), True),  # Monday
+        (real_date(2025, 8, 12), False),
+        (real_date(2025, 8, 13), False),
+        (real_date(2025, 8, 14), False),
+        (real_date(2025, 8, 15), False),
+        (real_date(2025, 8, 16), False),
+        (real_date(2025, 8, 17), False),  # Sunday
+    ],
+)
+def test_is_reminder_day(monkeypatch, day, expected):
+    from dispatch.case import scheduled
+
+    class FakeDate(real_date):
+        @classmethod
+        def today(cls):
+            return day
+
+    monkeypatch.setattr(scheduled, "date", FakeDate)
+
+    assert scheduled._is_reminder_day() is expected
+
+
+def test_case_close_reminder_falls_back_to_created_at(session, case, monkeypatch):
+    from datetime import datetime, timedelta
+    from dispatch.case import scheduled
+    from dispatch.case.enums import CaseStatus
+    from dispatch.scheduler import scheduler
+
+    sent = []
+    monkeypatch.setattr(scheduled, "_is_reminder_day", lambda: True)
+    monkeypatch.setattr(
+        scheduled, "send_case_close_reminder", lambda case, db_session: sent.append(case.id)
+    )
+
+    now = datetime.utcnow()
+    # no triage_at, created two weeks ago: should be reminded
+    missing_triage_at = case
+    missing_triage_at.status = CaseStatus.triage
+    missing_triage_at.triage_at = None
+    missing_triage_at.created_at = now - timedelta(days=14)
+
+    # triage_at is recent, created long ago: triage_at wins, no reminder
+    recent_triage = CaseFactory(
+        project=case.project, status=CaseStatus.triage, triage_at=now - timedelta(days=1)
+    )
+    recent_triage.created_at = now - timedelta(days=14)
+
+    session.commit()
+
+    # the job is wrapped by the scheduler and task decorators; unwrap to the
+    # function that takes db_session and project so it uses the test session
+    job = next(t["func"] for t in scheduler.registered_tasks if t["name"] == "case-close-reminder")
+    inspect.unwrap(job)(db_session=session, project=case.project)
+
+    assert sent == [missing_triage_at.id]
