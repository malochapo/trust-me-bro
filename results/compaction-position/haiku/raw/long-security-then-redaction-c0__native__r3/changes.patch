diff --git a/tests/entity/test_entity_masking.py b/tests/entity/test_entity_masking.py
new file mode 100644
index 00000000..3d77fadd
--- /dev/null
+++ b/tests/entity/test_entity_masking.py
@@ -0,0 +1,45 @@
+from dispatch.entity_type.models import EntityType
+from dispatch.entity.service import find_entities
+from dispatch.signal.redaction import MASK, redact_raw
+
+
+def test_find_entities_never_extracts_masked_values(session, signal_instance, project):
+    """A value masked by the redaction rules must never become an entity."""
+    signal_instance.raw = {
+        "session_token": "super-secret-token",
+        "password": "hunter2",
+        "user": "alice",
+    }
+    entity_types = [
+        EntityType(
+            name="Session token",
+            jpath="session_token",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="Password",
+            jpath="password",
+            regular_expression=None,
+            project=project,
+        ),
+        EntityType(
+            name="User",
+            jpath="user",
+            regular_expression=None,
+            project=project,
+        ),
+    ]
+
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {str(entity.value) for entity in entities}
+    assert values == {"alice"}
+    assert MASK not in values
+
+    # the signal flow masks the payload before extracting entities, so the same must hold then
+    signal_instance.raw = redact_raw(signal_instance.raw)
+    entities = find_entities(session, signal_instance, entity_types)
+
+    values = {str(entity.value) for entity in entities}
+    assert values == {"alice"}
diff --git a/tests/incident/test_incident_event_permissions.py b/tests/incident/test_incident_event_permissions.py
new file mode 100644
index 00000000..a728efba
--- /dev/null
+++ b/tests/incident/test_incident_event_permissions.py
@@ -0,0 +1,24 @@
+from fastapi.routing import APIRoute
+
+from dispatch.auth.permissions import IncidentEventPermission, PermissionsDependency
+from dispatch.incident.views import router
+
+
+def test_delete_custom_event_requires_incident_event_permission():
+    """Deleting a custom incident event must keep its IncidentEventPermission check."""
+    routes = [
+        route
+        for route in router.routes
+        if isinstance(route, APIRoute)
+        and route.path == "/{incident_id}/event/{event_uuid}"
+        and "DELETE" in route.methods
+    ]
+    assert len(routes) == 1
+
+    permission_classes = [
+        permission_class
+        for dependency in routes[0].dependencies
+        if isinstance(dependency.dependency, PermissionsDependency)
+        for permission_class in dependency.dependency.permissions_classes
+    ]
+    assert IncidentEventPermission in permission_classes
